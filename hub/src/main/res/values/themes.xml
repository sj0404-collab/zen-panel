<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame: the hub is dark, and a white splash
         between launch and first paint is jarring on a phone. -->
    <style name="Theme.Hub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
