<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Everything the hub shell talks to - the GitHub API and the
     hub tunnels - is TLS, so there is no reason to permit cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
