+    /**
+     * Создаёт VirtualDisplay + ImageReader ОДИН раз на сессию MediaProjection.
+     * Повторный createVirtualDisplay() на том же MediaProjection с Android 14
+     * запрещён (SecurityException) — поэтому дальше только читаем кадры.
+     */
+    private fun bindProjection(mp: MediaProjection) {
+        releaseDisplay()
+        val s = screenSize()
+        val density = resources.displayMetrics.densityDpi
+        var r: ImageReader? = null
+        try {
+            r = ImageReader.newInstance(s.x, s.y, PixelFormat.RGBA_8888, 2)
+            val vd = mp.createVirtualDisplay(
+                "ocr-scan", s.x, s.y, density,
+                DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
+                r.surface, null, ui,
+            )
+            reader = r
+            vDisplay = vd
+            displaySize = Point(s.x, s.y)
+        } catch (e: Exception) {
+            try { r?.close() } catch (_: Exception) { }
+            android.util.Log.w("OcrCap", "bindProjection: ${e.message}")
+            ui.post {
+                preview = "⚠ Не удалось начать захват экрана — разрешите заново"
+                previewText?.text = preview
+                notifyStatus(preview)
+            }
+        }
+    }
+
+    private fun releaseDisplay() {
+        try { vDisplay?.release() } catch (e: Exception) { }
+        vDisplay = null
+        try { reader?.close() } catch (e: Exception) { }
+        reader = null
+        displaySize = Point(0, 0)
+    }
+
+    /**
+     * Если экран повернулся, к тому же VirtualDisplay подключаем новый ImageReader
+     * нужного размера (resize + setSurface). Новый VirtualDisplay создать нельзя,
+     * поэтому меняем только поверхность.
+     */
+    private fun rebindSurface(w: Int, h: Int): Boolean {
+        val vd = vDisplay ?: return false
+        var newReader: ImageReader? = null
+        return try {
+            newReader = ImageReader.newInstance(w, h, PixelFormat.RGBA_8888, 2)
+            vd.resize(w, h, resources.displayMetrics.densityDpi)
+            vd.setSurface(newReader.surface)
+            val old = reader
+            reader = newReader
+            try { old?.close() } catch (e: Exception) { }
+            displaySize = Point(w, h)
+            true
+        } catch (e: Exception) {
+            try { newReader?.close() } catch (_: Exception) { }
+            android.util.Log.w("OcrCap", "rebindSurface: ${e.message}")
+            false
+        }
+    }
+
+    /** Свежий полноэкранный кадр из уже открытого ImageReader (пиксель-в-пиксель). */
+    private fun grabFrame(): Bitmap? {
+        val s = screenSize()
+        if (reader == null || s.x != displaySize.x || s.y != displaySize.y) {
+            if (!rebindSurface(s.x, s.y)) return null
+        }
+        val rd = reader ?: return null
+        return try {
+            val img = rd.acquireLatestImage() ?: rd.acquireNextImage() ?: return null
+            try {
+                val plane = img.planes[0]
+                val buf = plane.buffer
+                val pixelStride = plane.pixelStride
+                val rowStride = plane.rowStride
+                // На части устройств rowStride < pixelStride*w (не должно, но бывает):
+                // страховка от createBitmap с отрицательной шириной.
+                val rowPadding = (rowStride - pixelStride * s.x).coerceAtLeast(0)
+                val rawWidth = (s.x + rowPadding / pixelStride).coerceAtLeast(s.x)
+                val raw = Bitmap.createBitmap(rawWidth, s.y, Bitmap.Config.ARGB_8888)
+                buf.rewind()
+                raw.copyPixelsFromBuffer(buf)
+                val exact = Bitmap.createBitmap(raw, 0, 0, s.x, s.y)
+                raw.recycle()
+                exact
+            } finally {
+                img.close()
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
