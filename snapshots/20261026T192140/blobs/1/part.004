\n+  header{display:flex;align-items:center;gap:8px;padding:calc(env(safe-area-inset-top) + 8px) 10px 8px;\n+    background:#101310;border-bottom:1px solid var(--line);z-index:30}\n+  header .title{flex:1;min-width:0}\n+  header .title b{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n+  header .title span{display:block;font-size:10.5px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n+  .icon{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;font-size:17px}\n+  .icon:active{background:var(--panel2)}\n+  .icon.hot{color:var(--orange)}\n+  .btn{display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border-radius:12px;\n+    background:var(--panel2);font-size:13px}\n+  .btn.primary{background:#6c5ce7}\n+  .btn.warn{background:#7a3030}\n+  .btn:disabled{opacity:.45}\n+  .scroll{flex:1;overflow:auto;-webkit-overflow-scrolling:touch}\n+  .pad{padding:14px}\n+  .row{display:flex;align-items:center;gap:10px}\n+  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:12px}\n+  .card{background:var(--panel);border-radius:12px;overflow:hidden;position:relative}\n+  .card img,.card .nofoto{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;background:#0c0f0c}\n+  .card .nofoto{display:grid;place-items:center;color:#4a5449;font-size:11px}\n+  .card .cap{padding:6px 8px;font-size:11.5px;line-height:1.25}\n+  .card .cap span{display:block;color:var(--dim);font-size:10px}\n+  .card .del{position:absolute;top:4px;right:4px;background:#000a;border-radius:50%;width:24px;height:24px;\n+    display:grid;place-items:center;font-size:13px}\n+  .sheet{position:fixed;left:0;right:0;bottom:0;max-height:88%;background:var(--panel);\n+    border-radius:20px 20px 0 0;transform:translateY(102%);transition:transform .22s;z-index:60;\n+    display:flex;flex-direction:column}\n+  .sheet.on{transform:translateY(0)}\n+  .sheet .head{padding:12px 18px 4px;font-size:19px;font-weight:700;\n+    display:flex;align-items:center;justify-content:space-between;gap:10px}\n+  .sheet .head .x{flex:0 0 auto;width:40px;height:40px;border-radius:20px;border:0;\n+    background:#33363f;color:#ddd;font-size:20px;line-height:1}\n+  .sheet .body{overflow:auto;-webkit-overflow-scrolling:touch;\n+    padding:0 18px calc(28px + env(safe-area-inset-bottom))}\n+  /* Кнопки должны легко нажиматься пальцем: не меньше 44 px и без «двойного»\n+     срабатывания по краям. */\n+  .btn{min-height:44px}\n+  .sheet .body .btn{width:100%;margin-top:8px;justify-content:center}\n+  .sheet .body .row .btn{width:auto;margin-top:0}\n+  .sheetBg{position:fixed;inset:0;background:#0008;z-index:55;display:none}\n+  .sheetBg.on{display:block}\n+  .lbl{font-size:10px;letter-spacing:1.2px;font-weight:700;color:var(--dim);margin:20px 0 8px}\n+  .hint{font-size:11px;color:var(--dim)}\n+  .kv{font-size:12.5px;margin:2px 0}\n+  textarea,input[type=text],input[type=number]{width:100%;background:#12160f;color:var(--text);\n+    border:1px solid var(--line);border-radius:12px;padding:10px;font:12.5px/1.5 ui-monospace,monospace}\n+  .chips{display:flex;gap:6px;flex-wrap:wrap}\n+  .chip{padding:7px 11px;border-radius:10px;background:var(--panel2);font-size:12px}\n+  .chip.on{background:#4b3f7a}\n+  .lineitem{padding:6px 0;border-bottom:1px solid #ffffff10;font-size:12px}\n+  .lineitem b{color:var(--orange);font-size:10px;margin-right:6px}\n+  .empty{padding:40px 20px;text-align:center;color:var(--dim);font-size:13px}\n+  .badge{font-size:9.5px;padding:2px 6px;border-radius:6px;background:#00000055;color:var(--dim)}\n+  /* читалка */\n+  #reader{background:#000}\n+  #strip{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;padding:0;scroll-behavior:auto}\n+  #strip .pagewrap{position:relative;margin:0 auto}\n+  #strip canvas,#strip img{display:block;width:100%;height:auto}\n+  #strip .frames{position:absolute;inset:0;pointer-events:none}\n+  #strip .frame{position:absolute;border:1.5px solid var(--orange);border-radius:8px;pointer-events:auto}\n+  #strip .frame.done{border-color:#ff8a4c33}\n+  #strip .frame.cur{background:#ff8a4c33;border-width:2.5px;border-color:var(--orange)}\n+  #strip .frame.spk::after{content:\"🔊\";position:absolute;right:-4px;top:-22px;font-size:15px}\n+  /* Крупный текст (титул, каллиграфия) — другим цветом, чтобы не путать с репликой */\n+  #strip .frame.large{border-color:#6fa8ff;border-style:dashed}\n+  #strip .frame.large.cur{background:#6fa8ff26;border-color:#6fa8ff}\n+  .lineitem.large{color:#9dc0ff}\n+  .lineitem.large b{color:#6fa8ff}\n+  /* постраничный режим */\n+  #paged{position:absolute;inset:0;display:none;overflow:hidden}\n+  #paged.on{display:block}\n+  #paged .pagebox{position:absolute;inset:0;overflow:auto;display:none}\n+  #paged .pagebox.on{display:block}\n+  #paged .pagebox .inner{position:relative;transform-origin:0 0}\n+  .bottombar{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:6px;\n+    padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:#232822ee;backdrop-filter:blur(6px);\n+    z-index:25;transition:transform .2s}\n+  .bottombar.hide{transform:translateY(110%)}\n+  .bottombar .grow{flex:1;min-width:0}\n+  .progressbar{height:5px;background:#3a4436;border-radius:3px;overflow:hidden;flex:1;margin:0 6px}\n+  .progressbar i{display:block;height:100%;background:var(--orange);width:0}\n+  .floatbar{position:absolute;left:50%;transform:translateX(-50%);bottom:70px;display:flex;gap:4px;\n+    background:#232822d9;border-radius:26px;padding:4px 6px;z-index:26;align-items:center;\n+    opacity:.92;box-shadow:0 6px 18px #0006}\n+  .floatbar .icon{padding:5px 8px;font-size:15px}\n+  .nextArrow{position:absolute;z-index:27;background:#232822e6;border-radius:28px;padding:8px 13px;\n+    display:flex;align-items:center;gap:6px;font-size:12px;box-shadow:0 6px 20px #0008}\n+  .nextArrow.down{left:50%;transform:translateX(-50%);bottom:150px}\n+  .nextArrow.left{left:10px;top:50%;transform:translateY(-50%)}\n+  .nextArrow.right{right:10px;top:50%;transform:translateY(-50%)}\n+  .toast{position:fixed;left:50%;bottom:120px;transform:translate(-50%,20px);background:#000d;color:#fff;\n+    padding:9px 14px;border-radius:12px;font-size:12.5px;z-index:99;opacity:0;transition:.25s;max-width:86%;\n+    text-align:center;pointer-events:none}\n+  .toast.on{opacity:1;transform:translate(-50%,0)}\n+  .scanbadge{position:absolute;top:calc(env(safe-area-inset-top) + 60px);left:50%;transform:translateX(-50%);\n+    background:#000c;padding:6px 12px;border-radius:20px;font-size:11.5px;z-index:28;display:none}\n+  .scanbadge.on{display:block}\n+</style>\n+</head>\n+<body>\n+\n+<!-- ═══ Библиотека ═══ -->\n+<section id=\"library\" class=\"screen on\">\n+  <header>\n+    <div class=\"title\"><b>Локальная библиотека</b><span id=\"libSub\">папки, CBZ и отдельные страницы</span></div>\n+    <button class=\"icon\" id=\"btnImport\" title=\"Добавить\">＋</button>\n+    <button class=\"icon\" id=\"btnModels\" title=\"Модели OCR\">⚙</button>\n+    <button class=\"icon\" id=\"btnRulesLib\" title=\"Правила\">☰</button>\n+  </header>\n+  <div class=\"scroll pad\">\n+    <div id=\"envBanner\" style=\"display:none;background:#7a3030;color:#fff;border-radius:12px;padding:10px 12px;font-size:12px;margin-bottom:12px\"></div>\n+    <div id=\"selfCheck\" class=\"hint\" style=\"margin-bottom:10px\">Скрипты страницы не выполнились — поэтому кнопки не реагируют. Откройте файл в Chrome (или разрешите inline-скрипты на этом сервере).</div>\n+    <div id=\"libEmpty\" class=\"empty\">\n+      Пока пусто.<br><br>\n+      Нажмите ＋ и выберите папку с главой (или CBZ).<br>\n+      Файлы остаются на устройстве — в браузере, без сервера.\n+    </div>\n+    <div id=\"libGrid\" class=\"grid\"></div>\n+  </div>\n+</section>\n+\n+<!-- ═══ Читалка ═══ -->\n+<section id=\"reader\" class=\"screen\">\n+  <header id=\"readerHeader\" style=\"position:absolute;left:0;right:0;top:0;background:#101310e8;backdrop-filter:blur(6px);transition:transform .2s\">\n+    <button class=\"icon\" id=\"btnBack\">←</button>\n+    <div class=\"title\"><b id=\"rTitle\">…</b><span id=\"rSub\">KOMA · лента</span></div>\n+    <button class=\"icon\" id=\"btnScan\" title=\"Распознать\">▣</button>\n+    <button class=\"icon\" id=\"btnSettings\" title=\"Голос и чтение\">🎙</button>\n+    <button class=\"icon\" id=\"btnMore\" title=\"Ещё\">⋮</button>\n+  </header>\n+\n+  <div id=\"strip\"></div>\n+  <div id=\"paged\"></div>\n+  <div class=\"scanbadge\" id=\"scanBadge\">Распознаём…</div>\n+\n+  <div class=\"floatbar\" id=\"playBar\" style=\"display:none\">\n+    <button class=\"icon\" id=\"btnPause\">⏸</button>\n+    <button class=\"icon\" id=\"btnSkip\">⏭</button>\n+    <button class=\"icon\" id=\"btnStop\" style=\"color:var(--red)\">⏹</button>\n+    <span id=\"playStatus\" style=\"font-size:11px;color:var(--dim);padding-right:6px\"></span>\n+  </div>\n+\n+  <div class=\"nextArrow down\" id=\"nextArrow\" style=\"display:none\">▼ Прокрутить</div>\n+\n+  <div class=\"bottombar\" id=\"readerBar\">\n+    <button class=\"btn\" id=\"btnOcr2\">✨ Текст страницы</button>\n+    <span class=\"grow\"></span>\n+    <button class=\"icon\" id=\"btnRead\" title=\"Читать\">▶</button>\n+    <button class=\"icon\" id=\"btnFrames\" title=\"Рамки\">⛶</button>\n+    <span style=\"font-size:11.5px;color:var(--dim);min-width:44px;text-align:right\" id=\"pageNum\">1</span>\n+    <span style=\"font-size:11px;color:var(--dim)\">/</span>\n+    <span style=\"font-size:11.5px;color:var(--dim);min-width:24px\" id=\"pageTotal\">1</span>\n+  </div>\n+</section>\n+\n+<!-- ═══ Шторка: добавить главу ═══ -->\n+<div class=\"sheetBg\" id=\"sheetBg\"></div>\n+<div class=\"sheet\" id=\"sheetImport\">\n+  <div class=\"head\">Добавить главу</div>\n+  <div class=\"body\">\n+    <div class=\"hint\" id=\"importHint\">Файлы остаются на устройстве: никуда не загружаются.</div>\n+    <button class=\"btn primary\" id=\"btnPickDir\" style=\"width:100%;margin-top:14px;justify-content:center\">Выбрать папку</button>\n+    <button class=\"btn\" id=\"btnPickFiles\" style=\"width:100%;margin-top:8px;justify-content:center\">Выбрать файлы или CBZ</button>\n+    <button class=\"btn\" id=\"btnPickFolderModern\" style=\"width:100%;margin-top:8px;justify-content:center;display:none\">Выбрать папку (File System)</button>\n+    <div class=\"hint\" id=\"importNote\" style=\"margin-top:12px\"></div>\n+    <div class=\"hint\" id=\"importTip\" style=\"margin-top:10px\"></div>\n+    <div class=\"lbl\" style=\"margin-top:14px\">КУДА ДОБАВИТЬ</div>\n+    <select id=\"importTarget\" style=\"width:100%;padding:10px;border-radius:10px;background:#22242b;color:#eee;border:1px solid #3a3d47\">\n+      <option value=\"\">Новая глава</option>\n+    </select>\n+    <div class=\"hint\" id=\"importCaps\" style=\"margin-top:10px\"></div>\n+    <button class=\"btn\" id=\"closeImport\" style=\"margin-top:18px;width:100%\">Отмена</button>\n+  </div>\n+</div>\n+\n+<!-- ═══ Шторка: модели ═══ -->\n+<div class=\"sheet\" id=\"sheetModels\">\n+  <div class=\"head\">Модели OCR</div>\n+  <div class=\"body\">\n+    <div class=\"hint\">Нужны три файла из папки <code>assets/koma/models</code> АПК:<br>\n+      <b>detection.onnx</b>, <b>cyrillic.onnx</b>, <b>cyrillic.txt</b>.</div>\n+    <div class=\"lbl\">СОСТОЯНИЕ</div>\n+    <div id=\"modelsState\" class=\"kv\"></div>\n+    <div class=\"hint\" style=\"margin-top:8px\">\n+      Можно выбрать <b>все три файла сразу</b>, можно по одному — шторка не закроется,\n+      и ниже будет видно, чего ещё не хватает.\n+    </div>\n+    <div class=\"row\" style=\"margin-top:12px;gap:8px;flex-wrap:wrap\">\n+      <button class=\"btn primary\" id=\"btnPickModels\">Выбрать файлы</button>\n+      <button class=\"btn\" id=\"btnPickModelDir\">Папка с моделями</button>\n+      <button class=\"btn\" id=\"btnTestEngine\">Проверить движок</button>\n+      <button class=\"btn\" id=\"btnTestVoice\">Проверить голос</button>\n+      <button class=\"btn\" id=\"btnPickDict\">Словарь ru_250k</button>\n+    </div>\n+    <div class=\"row\" style=\"margin-top:8px;gap:8px\">\n+      <button class=\"btn\" id=\"btnClearModels\">Убрать модели</button>\n+    </div>\n+    <div class=\"lbl\">ДВИЖОК</div>\n+    <div id=\"ortState\" class=\"kv hint\"></div>\n+    <div id=\"engineNote\" class=\"hint\" style=\"display:none;color:#ffd2d2;margin-top:6px\"></div>\n+    <div id=\"dictState\" class=\"hint\" style=\"margin-top:6px\"></div>\n+    <div class=\"hint\" style=\"margin-top:10px\">\n+      Распознавание целиком в браузере: ни один кадр никуда не отправляется.\n+      Модели хранятся в IndexedDB этого сайта.\n+    </div>\n+    <button class=\"btn\" id=\"closeSheets\" style=\"margin-top:18px;width:100%\">Закрыть</button>\n+  </div>\n+</div>\n+\n+<!-- ═══ Шторка: правила и буфер ═══ -->\n+<div class=\"sheet\" id=\"sheetRules\">\n+  <div class=\"head\">Правила и буфер строк</div>\n+  <div class=\"body\">\n+    <div class=\"lbl\">ДЕЙСТВУЮЩИЕ ПРАВИЛА</div>\n+    <div class=\"kv\" id=\"rulesVer\"></div>\n+    <div class=\"row\" style=\"margin-top:10px;gap:8px\">\n+      <button class=\"btn primary\" id=\"btnRulesImport\">Загрузить файл</button>\n+      <button class=\"btn\" id=\"btnRulesExport\">Скачать</button>\n+      <button class=\"btn\" id=\"btnRulesReset\">Сброс</button>\n+    </div>\n+    <div class=\"lbl\">БУФЕР СТРОК</div>\n+    <div class=\"kv\" id=\"bufferInfo\"></div>\n+    <div id=\"bufferList\" style=\"max-height:190px;overflow:auto;margin-top:8px\"></div>\n+    <div class=\"row\" style=\"gap:8px;margin-top:10px\">\n+      <button class=\"btn\" id=\"btnBufferExport\">Выгрузить</button>\n+      <button class=\"btn\" id=\"btnBufferClear\">Очистить</button>\n+    </div>\n+    <div class=\"lbl\">ПРАВКИ СЛОВ (wordFixes)</div>\n+    <div class=\"hint\">Ключ — что вернул OCR, значение — как надо. Сравнение без регистра.</div>\n+    <textarea id=\"wordFixesBox\" rows=\"4\" placeholder='{\"Пвтор\":\"Автор\",\"Форирование\":\"Формирование\"}'></textarea>\n+    <button class=\"btn\" id=\"btnWordFixesSave\" style=\"margin-top:8px\">Сохранить правки</button>\n+    <button class=\"btn\" id=\"closeSheets2\" style=\"margin-top:18px;width:100%\">Закрыть</button>\n+  </div>\n+</div>\n+\n+<!-- ═══ Шторка: настройки чтения ═══ -->\n+<div class=\"sheet\" id=\"sheetSettings\">\n+  <div class=\"head\">Как читать</div>\n+  <div class=\"body\">\n+    <div class=\"lbl\">ПОРЯДОК ЧТЕНИЯ</div>\n+    <div class=\"chips\" id=\"modeChips\">\n+      <button class=\"chip\" data-mode=\"vertical\">Вертикальная лента · манхва</button>\n+      <button class=\"chip\" data-mode=\"rtl\">Страницы справа налево · манга</button>\n+      <button class=\"chip\" data-mode=\"ltr\">Страницы слева направо</button>\n+    </div>\n+    <div class=\"lbl\" style=\"margin-top:14px\">НАПРАВЛЕНИЕ ЧТЕНИЯ</div>\n+    <div class=\"chips\" id=\"dirChips\">\n+      <button class=\"chip\" data-dir=\"rtl\">Справа налево (манга)</button>\n+      <button class=\"chip\" data-dir=\"ltr\">Слева направо</button>\n+    </div>\n+    <div class=\"lbl\">АВТОЧТЕНИЕ</div>\n+    <label class=\"row\" style=\"justify-content:space-between;padding:6px 0\">\n+      <span>Читать вслух</span>\n+      <input type=\"checkbox\" id=\"cbAuto\">\n+    </label>\n+    <label class=\"row\" style=\"justify-content:space-between;padding:6px 0\">\n+      <span>Полуручной режим <span class=\"hint\">— прочитает видимое и ждёт прокрутки</span></span>\n+      <input type=\"checkbox\" id=\"cbSemi\">\n+    </label>\n+    <label class=\"row\" style=\"justify-content:space-between;padding:6px 0\">\n+      <span>Ждать остановки, мс</span>\n+      <input type=\"number\" id=\"numSettle\" style=\"width:90px\" min=\"0\" max=\"5000\" step=\"100\">\n+    </label>\n+    <div class=\"lbl\">ГОЛОС</div>\n+    <div class=\"row\" style=\"justify-content:space-between;padding:6px 0\">\n+      <span>Голос</span>\n+      <select id=\"selVoice\" style=\"max-width:62%;background:#12160f;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:7px\"></select>\n+    </div>\n+    <div class=\"row\" style=\"justify-content:space-between;padding:6px 0\">\n+      <span>Скорость</span>\n+      <input type=\"range\" id=\"rngRate\" min=\"0.6\" max=\"1.6\" step=\"0.05\" style=\"max-width:60%\">\n+    </div>\n+    <div class=\"lbl\">РАМКИ</div>\n+    <label class=\"row\" style=\"justify-content:space-between;padding:6px 0\">\n+      <span>Показывать рамки реплик</span>\n+      <input type=\"checkbox\" id=\"cbFrames\">\n+    </label>\n+    <label class=\"row\" style=\"justify-content:space-between;padding:6px 0\">\n+      <span>Подсвечивать читаемую реплику</span>\n+      <input type=\"checkbox\" id=\"cbFollow\">\n+    </label>\n+    <button class=\"btn\" id=\"closeSheets3\" style=\"margin-top:18px;width:100%\">Закрыть</button>\n+  </div>\n+</div>\n+\n+<!-- ═══ Шторка: текст страницы ═══ -->\n+<div class=\"sheet\" id=\"sheetText\">\n+  <div class=\"head\" id=\"textTitle\">Текст страницы</div>\n+  <div class=\"body\">\n+    <div class=\"kv\" id=\"textStats\"></div>\n+    <div class=\"row\" id=\"textNav\" style=\"gap:8px;margin-top:8px;display:flex\"></div>\n+    <button class=\"btn\" id=\"btnFullPage\" style=\"margin-top:8px\">Распознать всю страницу целиком</button>\n+    <div class=\"lbl\">КАК ЧИТАЕТСЯ</div>\n+    <div id=\"textOrdered\"></div>\n+    <div class=\"lbl\">КАК РАСПОЗНАНО</div>\n+    <div id=\"textRaw\" class=\"hint\" style=\"max-height:150px;overflow:auto\"></div>\n+    <div class=\"row\" style=\"gap:8px;margin-top:12px\">\n+      <button class=\"btn primary\" id=\"btnRescan\">Распознать заново</button>\n+      <button class=\"btn\" id=\"btnSpeakPage\">Прочитать</button>\n+    </div>\n+    <button class=\"btn\" id=\"closeSheets4\" style=\"margin-top:18px;width:100%\">Закрыть</button>\n+  </div>\n+</div>\n+\n+<div class=\"toast\" id=\"toast\"></div>\n+<!-- Каждый выбор файлов — СВОЙ input. Раньше они переиспользовались, и выбор\n+     модели запускал импорт библиотеки (выбрасывало в читалку). -->\n+<input type=\"file\" id=\"imgPick\" multiple accept=\"image/*,.cbz,.zip\" style=\"display:none\">\n+<input type=\"file\" id=\"dirPick\" webkitdirectory directory multiple style=\"display:none\">\n+<input type=\"file\" id=\"modelPick\" multiple style=\"display:none\">\n+<input type=\"file\" id=\"modelDirPick\" webkitdirectory directory multiple style=\"display:none\">\n+<input type=\"file\" id=\"rulesPick\" accept=\".json,application/json\" style=\"display:none\">\n+\n+<script>\n+\n", "additions": 332, "deletions": 0, "status": "added"}, {"file": "part2.js", "patch": "Index: part2.js\n===================================================================\n--- part2.js\t\n+++ part2.js\t\n@@ -0,0 +1,264 @@\n+'use strict';\n+/* ───────────────────────── 0. Мелкие утилиты ───────────────────────── */\n+const $ = (s) => document.querySelector(s);\n+const $$ = (s) => Array.from(document.querySelectorAll(s));\n+const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\n+function toast(msg, ms = 2200) {\n+  const el = $('#toast');\n+  el.textContent = msg; el.classList.add('on');\n+  clearTimeout(toast._t);\n+  toast._t = setTimeout(() => el.classList.remove('on'), ms);\n+}\n+const sleep = (ms) => new Promise(r => setTimeout(r, ms));\n+\n+const VERSION = 'v1.9.11';\n+\n+/* ───────────────────────── 1. Хранилище (IndexedDB) ─────────────────────────\n+   Всё локально: книги — блобы страниц, модели — ArrayBuffer, правила — JSON.\n+   Ничего не уходит в сеть: сервера у этой страницы нет.                        */\n+const DB = (() => {\n+  let dbp = null;\n+  // Если IndexedDB недоступен (предпросмотр в песочнице без same-origin),\n+  // работаем в памяти: библиотека и чтение живут до перезагрузки страницы,\n+  // но кнопки не «молчат».\n+  const memory = { books: new Map(), pages: new Map(), kv: new Map() };\n+  let useMemory = false;\n+  const memApi = {\n+    put: async (store, val) => {\n+      const key = store === 'books' ? val.id : store === 'pages' ? val.key : val.k;\n+      memory[store].set(key, val);\n+    },\n+    get: async (store, key) => memory[store].get(key),\n+    del: async (store, key) => { memory[store].delete(key); },\n+    all: async (store) => Array.from(memory[store].values()),\n+    clear: async (store) => { memory[store].clear(); },\n+  };\n+  function open() {\n+    if (dbp) return dbp;\n+    const raw = new Promise((res, rej) => {\n+      const r = indexedDB.open('koma-web', 1);\n+      r.onupgradeneeded = () => {\n+        const db = r.result;\n+        if (!db.objectStoreNames.contains('books')) db.createObjectStore('books', { keyPath: 'id' });\n+        if (!db.objectStoreNames.contains('pages')) db.createObjectStore('pages', { keyPath: 'key' });\n+        if (!db.objectStoreNames.contains('kv')) db.createObjectStore('kv', { keyPath: 'k' });\n+      };\n+      r.onsuccess = () => res(r.result);\n+      r.onerror = () => rej(r.error || new Error('indexedDB открыть не удалось'));\n+      r.onblocked = () => rej(new Error('indexedDB заблокирован другой вкладкой'));\n+    });\n+    // Страховка: если браузер не ответил за 3 секунды (песочница, приватный\n+    // режим, «зависшая» вкладка), не висим навсегда — уходим в память.\n+    // Иначе любая запись (буфер, модели, книги) молча не завершалась.\n+    const timeout = new Promise((_, rej) => setTimeout(() => rej(new Error('indexedDB не ответил за 3 с')), 3000));\n+    dbp = Promise.race([raw, timeout]);\n+    return dbp;\n+  }\n+  async function tx(store, mode, fn) {\n+    const db = await open();\n+    return new Promise((res, rej) => {\n+      const t = db.transaction(store, mode);\n+      const s = t.objectStore(store);\n+      let out;\n+      const p = fn(s);\n+      if (p && p.onsuccess !== undefined) p.onsuccess = () => { out = p.result; };\n+      t.oncomplete = () => res(out);\n+      t.onerror = () => rej(t.error);\n+    });\n+  }\n+  const realApi = {\n+    put: (store, val) => tx(store, 'readwrite', s => s.put(val)),\n+    get: (store, key) => tx(store, 'readonly', s => s.get(key)),\n+    del: (store, key) => tx(store, 'readwrite', s => s.delete(key)),\n+    all: (store) => tx(store, 'readonly', s => s.getAll()),\n+    clear: (store) => tx(store, 'readwrite', s => s.clear()),\n+  };\n+  const wrap = (fn) => async (...args) => {\n+    if (useMemory) return memApi[fn.name](...args);\n+    try { return await realApi[fn.name](...args); }\n+    catch (e) {\n+      if (useMemory) return memApi[fn.name](...args);\n+      // Первый же отказ — переходим в память и говорим об этом один раз.\n+      console.warn('IndexedDB недоступен, работаю в памяти:', e);\n+      useMemory = true;\n+      DB.inMemory = true;\n+      return memApi[fn.name](...args);\n+    }\n+  };\n+  return {\n+    inMemory: false,\n+    put: wrap({ name: 'put' }), get: wrap({ name: 'get' }), del: wrap({ name: 'del' }),\n+    all: wrap({ name: 'all' }), clear: wrap({ name: 'clear' }),\n+  };\n+})();\n+\n+/* ───────────────────────── 2. ZIP/CBZ без библиотек ─────────────────────────\n+   Используем DecompressionStream('deflate-raw') — есть в Chrome 80+/Safari 16+. */\n+async function unzip(buf) {\n+  const dv = new DataView(buf);\n+  const u8 = new Uint8Array(buf);\n+  // ищем End of Central Directory\n+  let eocd = -1;\n+  for (let i = u8.length - 22; i >= Math.max(0, u8.length - 66000); i--) {\n+    if (dv.getUint32(i, true) === 0x06054b50) { eocd = i; break; }\n+  }\n+  if (eocd < 0) throw new Error('не ZIP');\n+  const count = dv.getUint16(eocd + 10, true);\n+  let off = dv.getUint32(eocd + 16, true);\n+  const files = [];\n+  for (let i = 0; i < count; i++) {\n+    if (dv.getUint32(off, true) !== 0x02014b50) break;\n+    const method = dv.getUint16(off + 10, true);\n+    const csize = dv.getUint32(off + 20, true);\n+    const nameLen = dv.getUint16(off + 28, true);\n+    const extraLen = dv.getUint16(off + 30, true);\n+    const cmtLen = dv.getUint16(off + 32, true);\n+    const localOff = dv.getUint32(off + 42, true);\n+    const name = new TextDecoder().decode(u8.subarray(off + 46, off + 46 + nameLen));\n+    off += 46 + nameLen + extraLen + cmtLen;\n+    if (name.endsWith('/')) continue;\n+    if (!/\\.(jpe?g|png|webp|avif|bmp|gif)$/i.test(name)) continue;\n+    // локальный заголовок\n+    const lnLen = dv.getUint16(localOff + 26, true);\n+    const leLen = dv.getUint16(localOff + 28, true);\n+    const dataStart = localOff + 30 + lnLen + leLen;\n+    const raw = u8.subarray(dataStart, dataStart + csize);\n+    let data;\n+    if (method === 0) data = raw.slice();\n+    else if (method === 8) {\n+      const ds = new DecompressionStream('deflate-raw');\n+      const blob = new Blob([raw.slice()]);\n+      data = new Uint8Array(await new Response(blob.stream().pipeThrough(ds)).arrayBuffer());\n+    } else throw new Error('метод сжатия ' + method);\n+    files.push({ name, data });\n+  }\n+  files.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));\n+  return files;\n+}\n+\n+/* ───────────────────────── 3. Библиотека ───────────────────────── */\n+const Library = {\n+  books: [],\n+  async load() {\n+    this.books = (await DB.all('books') || []).sort((a, b) => (b.at || 0) - (a.at || 0));\n+    renderLibrary();\n+  },\n+  /**\n+   * Добавить страницы в СУЩЕСТВУЮЩУЮ главу.\n+   *\n+   * Зачем: в браузере на Android нельзя выбрать папку (SAF вебу недоступен), а\n+   * файловый выбор за один раз редко даёт все 20 страниц. Так можно добавлять\n+   * по частям — в ту же книгу, с продолжением нумерации.\n+   */\n+  async appendTo(bookId, files) {\n+    const book = await DB.get('books', bookId);\n+    if (!book) throw new Error('глава не найдена');\n+    const start = book.count || 0;\n+    for (let k = 0; k < files.length; k++) {\n+      const f = files[k];\n+      const name = String(f.name || ('page-' + (start + k))).split('/').pop();\n+      await DB.put('pages', { key: bookId + '/' + (start + k), id: bookId, index: start + k, name, blob: f.blob || f });\n+    }\n+    book.count = start + files.length;\n+    book.at = Date.now();\n+    await DB.put('books', book);\n+    return book;\n+  },\n+  async addBook(title, files, kind) {\n+    const id = 'b' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n+    const pages = [];\n+    for (let i = 0; i < files.length; i++) {\n+      const f = files[i];\n+      const name = f.name.split('/').pop();\n+      const blob = f.blob || new Blob([f.data], { type: mimeOf(name) });\n+      const key = id + '/' + i;\n+      await DB.put('pages', { key, id, index: i, name, blob });\n+      pages.push({ key, name });\n+    }\n+    const cover = pages.length ? (await DB.get('pages', pages[0].key))?.blob : null;\n+    const book = { id, title, kind, count: pages.length, at: Date.now(), progress: 0, mode: 'vertical', cover };\n+    await DB.put('books', book);\n+    return book;\n+  },\n+  async pages(bookId) {\n+    const rows = (await DB.all('pages') || []).filter(p => p.id === bookId);\n+    rows.sort((a, b) => a.index - b.index);\n+    return rows;\n+  },\n+  async remove(bookId) {\n+    const rows = (await DB.all('pages') || []).filter(p => p.id === bookId);\n+    for (const p of rows) await DB.del('pages', p.key);\n+    await DB.del('books', bookId);\n+  },\n+};\n+function mimeOf(name) {\n+  const e = name.split('.').pop().toLowerCase();\n+  return e === 'png' ? 'image/png' : e === 'webp' ? 'image/webp' : e === 'gif' ? 'image/gif' : 'image/jpeg';\n+}\n+\n+function renderLibrary() {\n+  const grid = $('#libGrid');\n+  $('#libEmpty').style.display = Library.books.length ? 'none' : 'block';\n+  grid.innerHTML = '';\n+  for (const b of Library.books) {\n+    const el = document.createElement('div');\n+    el.className = 'card';\n+    el.dataset.armed = '0';\n+    const url = b.cover ? URL.createObjectURL(b.cover) : '';\n+    el.innerHTML = `${url ? `<img src=\"${url}\" alt=\"\">` : '<div class=\"nofoto\">нет обложки</div>'}\n+      <button class=\"del\">✕</button>\n+      <div class=\"cap\">${escapeHtml(b.title)}<span>${b.count} стр. · ${b.mode === 'vertical' ? 'лента' : b.mode === 'rtl' ? 'справа налево' : 'слева направо'}</span></div>`;\n+    // confirm() в предпросмотре и части мобильных браузеров глушится, поэтому\n+    // спрашиваем вторым нажатием, а не модалкой.\n+    el.querySelector('.del').onclick = async (e) => {\n+      e.stopPropagation();\n+      if (el.dataset.armed !== '1') {\n+        el.dataset.armed = '1';\n+        el.querySelector('.del').textContent = '?';\n+        toast('Нажмите ✕ ещё раз, чтобы удалить «' + b.title + '»');\n+        setTimeout(() => {\n+          if (el.dataset.armed === '1') { el.dataset.armed = '0'; el.querySelector('.del').textContent = '✕'; }\n+        }, 3000);\n+        return;\n+      }\n+      await Library.remove(b.id); await Library.load();\n+      toast('Удалено');\n+    };\n+    el.onclick = () => openBook(b);\n+    grid.appendChild(el);\n+  }\n+}\n+/**\n+ * Открыть книгу. Раньше карточка звала openBook(), а такой функции не было\n+ * вовсе: тап по книге молча ничего не делал. Ошибки теперь видно, а не в консоли.\n+ */\n+async function openBook(book) {\n+  try {\n+    await Reader.open(book);\n+  } catch (e) {\n+    console.error('openBook', e);\n+    toast('Не удалось открыть «' + book.title + '»: ' + (e && e.message ? e.message : e), 5000);\n+  }\n+}\n+const escapeHtml = (s) => String(s).replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n+\n+/* Импорт: папка / CBZ / отдельные картинки */\n+async function importDir(fileList) {\n+  const imgs = Array.from(fileList).filter(f => /\\.(jpe?g|png|webp|avif|bmp|gif)$/i.test(f.name));\n+  if (!imgs.length) return toast('В выбранной папке нет картинок');\n+  imgs.sort((a, b) => a.webkitRelativePath.localeCompare(b.webkitRelativePath, undefined, { numeric: true }));\n+  const title = (imgs[0].webkitRelativePath || imgs[0].name).split('/')[0] || 'Глава';\n+  toast('Сохраняю ' + imgs.length + ' страниц…', 5000);\n+  await Library.addBook(title, imgs.map(f => ({ name: f.name, blob: f })), 'dir');\n+  await Library.load();\n+  toast('Добавлено: ' + title + ' (' + imgs.length + ' стр.)');\n+}\n+async function importZip(file) {\n+  toast('Разбираю архив…', 5000);\n+  const files = await unzip(await file.arrayBuffer());\n+  if (!files.length) return toast('В архиве нет картинок');\n+  const title = file.name.replace(/\\.(cbz|zip)$/i, '');\n+  await Library.addBook(title, files, 'zip');\n+  await Library.load();\n+  toast('Добавлено: ' + title + ' (' + files.length + ' стр.)');\n+}\n", "additions": 264, "deletions": 0, "status": "added"}, {"file": "part3.js", "patch": "Index: part3.js\n===================================================================\n--- part3.js\t\n+++ part3.js\t\n@@ -0,0 +1,1728 @@\n+\n+/* ───────────────────────── 4. Правила (тот же файл, что у АПК) ───────────────────────── */\n+const DEFAULT_RULES = {\n+  version: 'web-1',\n+  inkLowPercentile: 0.02, inkHighPercentile: 0.98, inkFlatSpread: 10,\n+  inkCoefficient: 0.45, inkMin: 40, inkMax: 235, binarizeFallback: 110,\n+  inkTileRows: 4, inkLevels: 1,\n+  contrastGain: 2.2, contrastOffset: -140,\n+  rescueMinRegions: 600, pageSide: 1600, rescueSide: 960, minConfidence: 0.25,\n+  cutMargin: 0.06, bandOverlap: 0.15, bandsMax: 8, wholeThreshold: 0.72,\n+  bubbleGap: 0.45, mergeHeightRatio: 1.8,\n+  speechRate: 0, autoScrollStep: 0.25, semiManual: false, semiManualSettleMs: 700,\n+  detRetry: true,          // повтор детектора с ImageNet-нормой, только если боксов 0\n+  largeText: true,         // второй проход по трудному тексту (каллиграфия, крупный шрифт)\n+  decodeVariants: true,    // перебор всех подготовок кропа ради верных слов\n+  uncoveredPass: true,     // искать строки, которые детектор не закрыл боксом\n+  largeMinWidth: 0.22,     // уже — это не текстовый блок (звуковые эффекты узкие)\n+  decodeRetryBelow: 1,     // повторное распознавание бинаризациями: только если букв < 1\n+  junkRatio: 0.6,          // доля слов не из словаря, при которой строка — мусор\n+  wordFixes: {},\n+};\n+let RULES = { ...DEFAULT_RULES };\n+function sanitizeRules(r) {\n+  const R = { ...DEFAULT_RULES, ...(r || {}) };\n+  const num = (k, a, b) => { R[k] = clamp(Number(R[k]) || 0, a, b); };\n+  num('inkLowPercentile', 0, .5); num('inkHighPercentile', .5, 1); num('inkFlatSpread', 0, 128);\n+  num('inkCoefficient', 0, .95); num('inkMin', 0, 254); num('inkMax', 1, 255);\n+  num('binarizeFallback', 0, 255); num('inkTileRows', 1, 16); num('inkLevels', 1, 2);\n+  num('contrastGain', 1, 8); num('contrastOffset', -255, 100);\n+  num('rescueMinRegions', 0, 100000); num('pageSide', 320, 4000); num('rescueSide', 320, 4000);\n+  num('minConfidence', 0, 1); num('cutMargin', 0, .4); num('bandOverlap', 0, .5);\n+  num('bandsMax', 1, 32); num('wholeThreshold', .3, 1); num('bubbleGap', .05, 3);\n+  num('mergeHeightRatio', 1.05, 6); num('speechRate', 0, 3); num('autoScrollStep', .05, .9);\n+  num('semiManualSettleMs', 0, 5000);\n+  R.detRetry = R.detRetry !== false;                       // повтор детектора при 0 боксов\n+  R.largeText = R.largeText !== false;\n+  R.decodeVariants = R.decodeVariants !== false;\n+  R.uncoveredPass = R.uncoveredPass !== false;\n+  num('largeMinWidth', 0.05, 0.6);\n+  num('decodeRetryBelow', 0, 6);                           // <N букв → пробуем бинаризации\n+  num('junkRatio', 0, 1);                                  // 0 — фильтр выключен\n+  if (R.inkMax <= R.inkMin) R.inkMax = Math.min(255, R.inkMin + 1);\n+  R.inkTileRows = Math.round(R.inkTileRows); R.bandsMax = Math.round(R.bandsMax);\n+  R.inkLevels = Math.round(R.inkLevels); R.semiManualSettleMs = Math.round(R.semiManualSettleMs);\n+  R.semiManual = !!R.semiManual;\n+  if (typeof R.wordFixes !== 'object' || !R.wordFixes) R.wordFixes = {};\n+  return R;\n+}\n+\n+/* ───────────────────────── 4b. Починка текста (порт KomaText.kt) ─────────────────────────\n+   Модель регулярно пишет русские буквы латиницей, греческими заглавными и\n+   цифрами: «HETΛOXO», «3ВУ4ИТ», «MHE TAK». Без этой починки строка не проходила\n+   фильтр языка и пропадала из реплики целиком. */\n+const LOOKALIKES = {\n+  a: 'а', e: 'е', o: 'о', c: 'с', p: 'р', x: 'х', y: 'у', k: 'к', m: 'м', t: 'т',\n+  b: 'в', h: 'н', u: 'и', n: 'п',\n+  A: 'А', E: 'Е', O: 'О', C: 'С', P: 'Р', X: 'Х', Y: 'У', K: 'К', M: 'М', T: 'Т',\n+  B: 'В', H: 'Н', U: 'И',\n+  'Λ': 'Л', 'Δ': 'Д', 'Α': 'А', 'Β': 'В', 'Ε': 'Е', 'Ζ': 'З', 'Η': 'Н', 'Ι': 'И',\n+  'Κ': 'К', 'Μ': 'М', 'Ν': 'Н', 'Ο': 'О', 'Ρ': 'Р', 'Τ': 'Т', 'Υ': 'У', 'Χ': 'Х',\n+  '3': 'з', '4': 'ч', '0': 'о', '6': 'б', '8': 'в',\n+  'α': 'а', 'β': 'в', 'γ': 'г', 'δ': 'д', 'ε': 'е', 'ζ': 'з', 'η': 'н', 'ι': 'и',\n+  'κ': 'к', 'μ': 'м', 'ν': 'п', 'ο': 'о', 'π': 'п', 'ρ': 'р', 'σ': 'с', 'τ': 'т',\n+  'υ': 'у', 'χ': 'х',\n+  l: 'л', d: 'д', g: 'г', f: 'ф', r: 'г', s: 'с', v: 'в', w: 'ш', z: 'з', j: 'й', i: 'и',\n+  q: 'я',\n+};\n+const GREEK = new Set(['Λ', 'Δ', 'Α', 'Β', 'Ε', 'Ζ', 'Η', 'Ι', 'Κ', 'Μ', 'Ν', 'Ο', 'Ρ', 'Τ', 'Υ', 'Χ']);\n+const isRusLetter = (ch) => /^[а-яё]$/i.test(ch);\n+\n+function fixLookalikes(raw) {\n+  const lineIsRussian = Array.from(raw).some(ch => isRusLetter(ch) || GREEK.has(ch));\n+  if (!lineIsRussian) return raw;\n+  return raw.split(' ').map(word => {\n+    const letters = Array.from(word).filter(ch => /[\\p{L}\\p{N}]/u.test(ch));\n+    const convertible = letters.length && letters.every(ch => ch in LOOKALIKES);\n+    const wordHasRussian = Array.from(word).some(isRusLetter);\n+    if (!(wordHasRussian || convertible)) return word;\n+    // Если в слове нет строчных букв, то и подстановка должна быть заглавной:\n+    // «3ВУ4ИТ» → «ЗВУЧИТ», а не «зВУчИТ».\n+    const hasLower = Array.from(word).some(ch => /[a-zа-я]/.test(ch));\n+    return Array.from(word).map(ch => {\n+      const m = LOOKALIKES[ch];\n+      if (m === undefined) return ch;\n+      return hasLower ? m : m.toUpperCase();\n+    }).join('');\n+  }).join(' ');\n+}\n+\n+/** Строка состоит ТОЛЬКО из символов-двойников: «OHO», «4YBC», «MHE TAK». */\n+function isLookalikeOnly(text) {\n+  const letters = Array.from(text).filter(ch => /[\\p{L}\\p{N}]/u.test(ch));\n+  return letters.length > 0 && letters.every(ch => ch in LOOKALIKES);\n+}\n+/** Принудительный перевод всей строки, даже если русских букв в ней нет. */\n+function fixLookalikesForced(raw) {\n+  const chars = Array.from(raw);\n+  const upper = chars.filter(ch => /[A-ZА-Я]/.test(ch)).length > chars.filter(ch => /[a-zа-я]/.test(ch)).length;\n+  return chars.map(ch => {\n+    const m = LOOKALIKES[ch];\n+    if (m === undefined) return ch;\n+    return upper ? m.toUpperCase() : m;\n+  }).join('');\n+}\n+\n+/** Текст для синтезатора: убрать переносы, двойников, склеить «в д а ль». */\n+function cleanSpeech(raw) {\n+  let text = String(raw || '')\n+    .replace(/(?<=\\p{L})\\s*-\\s*(?=\\p{L})/gu, '')\n+    .replace(/\\s+/g, ' ')\n+    .trim();\n+  text = isLookalikeOnly(text) ? fixLookalikesForced(text) : fixLookalikes(text);\n+  for (let k = 0; k < 3; k++) {\n+    text = text.replace(/(?<!\\p{L})\\p{L}(\\s+\\p{L}){1,4}(?!\\p{L})/gu, m => m.replace(/\\s+/g, ''));\n+  }\n+  return text.trim();\n+}\n+\n+/* ───────────────────────── 4c. Язык: словарь и фильтр мусора ─────────────────────────\n+   Порт идеи KomaWords.kt. Модель путает похожие буквы и «видит» слова в\n+   каллиграфии и звуковых эффектах: «ол кослл алмчлс», «сттангасоат». Без словаря\n+   такие строки попадают в озвучку как реплики. Словарь — `ru_250k.txt` из\n+   assets/koma/dict того же APK, 250 000 слов по убыванию частоты.\n+   Он НЕ вшит в файл: его выбирают в ⚙ Модели, как и модели.\n+*/\n+const Words = {\n+  ready: false,\n+  rank: null,          // слово → номер строки (ранг частоты)\n+  size: 0,\n+  KNOWN_RANK: 50000,\n+  COMMON_RANK: 100000,\n+  ALPHABET: 'абвгдежзийклмнопрстуфхцчшщъыьэюяё'.split(''),\n+  source: '',\n+  async load() {\n+    // 1) Свой файл, если пользователь загрузил его кнопкой «Словарь ru_250k»\n+    //    (нужен, если вшитый не подошёл). 2) Иначе — вшитый в файл словарь.\n+    let text = '';\n+    const row = await DB.get('kv', 'dict:ru250k');\n+    if (row && row.v) { text = String(row.v); this.source = 'свой файл'; }\n+    else if (typeof DICT_GZ_B64 === 'string' && DICT_GZ_B64.length > 1000) {\n+      try {\n+        text = await embeddedDictText();\n+        this.source = 'вшит в файл';\n+      } catch (e) {\n+        console.warn('вшитый словарь не разжался:', e);\n+      }\n+    }\n+    if (!text) { this.ready = false; return false; }\n+    const lines = text.split('\\n');\n+    const rank = new Map();\n+    let n = 0;\n+    for (const line of lines) {\n+      const w = line.split(/\\s+/)[0];\n+      if (!w) continue;\n+      const low = w.toLowerCase();\n+      if (!rank.has(low)) rank.set(low, n);\n+      n++;\n+    }\n+    this.rank = rank; this.size = n; this.ready = n > 1000;\n+    return this.ready;\n+  },\n+  /** Слово верное, если оно из частых. */\n+  isKnown(w) {\n+    if (!this.ready) return true;\n+    const r = this.rank.get(w.toLowerCase());\n+    return r !== undefined && r <= this.KNOWN_RANK;\n+  },\n+  /** Одно редактирование: удаление, перестановка, замена, вставка. */\n+  edits1(word) {\n+    const out = new Set();\n+    const chars = Array.from(word);\n+    for (let i = 0; i < chars.length; i++) {\n+      out.add(chars.slice(0, i).concat(chars.slice(i + 1)).join(''));\n+      if (i + 1 < chars.length) {\n+        const sw = chars.slice();\n+        [sw[i], sw[i + 1]] = [sw[i + 1], sw[i]];\n+        out.add(sw.join(''));\n+      }\n+      for (const c of this.ALPHABET) {\n+        out.add(chars.slice(0, i).concat([c], chars.slice(i + 1)).join(''));\n+        out.add(chars.slice(0, i).concat([c], chars.slice(i)).join(''));\n+      }\n+    }\n+    return out;\n+  },\n+  candidate(word) {\n+    let best = null, bestRank = Infinity;\n+    for (const cand of this.edits1(word)) {\n+      const r = this.rank.get(cand);\n+      if (r !== undefined && r <= this.COMMON_RANK && r < bestRank) { bestRank = r; best = cand; }\n+    }\n+    return best;\n+  },\n+  /** Сохранить регистр исходного слова. */\n+  sameCase(src, word) {\n+    const letters = Array.from(src);\n+    const upper = letters.filter(ch => /[A-ZА-ЯЁ]/.test(ch)).length > letters.filter(ch => /[a-zа-яё]/.test(ch)).length;\n+    return upper ? word.toUpperCase() : (letters[0] && /[A-ZА-ЯЁ]/.test(letters[0]) ? word[0].toUpperCase() + word.slice(1) : word);\n+  },\n+  ENDINGS: ['ами', 'ями', 'ого', 'его', 'ому', 'ему', 'ыми', 'ими', 'ах', 'ях', 'ов', 'ев',\n+    'ой', 'ей', 'ий', 'ый', 'ая', 'ое', 'ые', 'ие', 'ом', 'ем', 'ам', 'ям', 'мь', 'ью',\n+    'ы', 'и', 'а', 'е', 'о', 'у', 'ю', 'ь', 'я', 'й', 'м'],\n+  /**\n+   * Слово выглядит настоящим: есть в словаре ИЛИ это его словоформа\n+   * (ВЫСОЧЕСТВОМ → ВЫСОЧЕСТВ + ОМ). Без этой проверки «правка» превращала\n+   * нормальное «ВЫСОЧЕСТВОМ» в «ВЫСОЧЕСТВО».\n+   */\n+  isPlausible(word) {\n+    if (!this.ready) return true;\n+    const low = String(word).toLowerCase();\n+    if (this.isKnown(low)) return true;\n+    if (low.length < 5) return false;\n+    for (const end of this.ENDINGS) {\n+      if (!low.endsWith(end)) continue;\n+      const stem = low.slice(0, low.length - end.length);\n+      if (stem.length < 4) continue;\n+      if (this.rank.has(stem) && this.rank.get(stem) <= this.COMMON_RANK) return true;\n+    }\n+    return false;\n+  },\n+  correctWord(word) {\n+    if (!this.ready) return word;\n+    const low = word.toLowerCase();\n+    if (low.length < 4) return word;\n+    if (this.isKnown(low) || this.isPlausible(low)) return word;\n+    const cand = this.candidate(low);\n+    if (cand) return this.sameCase(word, cand);\n+    // Два редактирования — но только к ОЧЕНЬ частым словам и не для КАПСА:\n+    // «оддучив» → «будучи» (OCR на рукописном шрифте), при этом имена вроде\n+    // «ДРЕГЕР» остаются как есть.\n+    if (this.FIX_DISTANCE >= 2 && low.length >= 5 && !/^[А-ЯЁ]+$/.test(word)) {\n+      const deep = this.candidate2(low);\n+      if (deep) return this.sameCase(word, deep);\n+    }\n+    return word;\n+  },\n+  // 2 включать нельзя: расстояние 2 превращает «Сесмой» в «Самой» — это хуже,\n+  // чем оставить слово как есть. Оставляем честное одно редактирование.\n+  FIX_DISTANCE: 1,\n+  /**\n+   * Кандидат на расстоянии 2 среди очень частых слов.\n+   *\n+   * Перебор «удалений от удалений» не годится: он не умеет менять буквы, а\n+   * именно это нужно для «оддучив» → «будучи». Поэтому сверяемся с индексом\n+   * 20 000 самых частых слов, сгруппированных по длине.\n+   */\n+  candidate2(word) {\n+    if (!this.rank) return null;\n+    const MAXR = 20000, MAXD = 2;\n+    const idx = this.topIndex(MAXR);\n+    const n = Array.from(word).length;\n+    let best = null, bestRank = Infinity;\n+    for (let len = n - MAXD; len <= n + MAXD; len++) {\n+      const bucket = idx.get(len);\n+      if (!bucket) continue;\n+      for (const [cand, r] of bucket) {\n+        if (r >= bestRank) continue;\n+        if (levenshtein(word, cand) <= MAXD) { bestRank = r; best = cand; }\n+      }\n+    }\n+    return best;\n+  },\n+  /** Индекс частых слов по длине — строится один раз. */\n+  topIndex(maxRank) {\n+    if (this._topIndex && this._topRank === maxRank) return this._topIndex;\n+    const idx = new Map();\n+    for (const [w, r] of this.rank) {\n+      if (r > maxRank || w.length < 4) continue;\n+      if (!idx.has(w.length)) idx.set(w.length, []);\n+      idx.get(w.length).push([w, r]);\n+    }\n+    this._topIndex = idx; this._topRank = maxRank;\n+    return idx;\n+  },\n+  /**\n+   * Длинное слово, которого нет в словаре и которое не правится одним\n+   * изменением, — это почти всегда звуковой эффект или каллиграфия внутри\n+   * реплики («сттангасоат», «риооооро»). Такие слова убираем из текста, но\n+   * только если в реплике есть другие настоящие слова: иначе останется пустота.\n+   * Порог 8 букв выбран, чтобы не тронуть имена («БЕРСЕРК», «ДРЕГЕР»).\n+   */\n+  stripJunkWords(text) {\n+    if (!this.ready) return text;\n+    const words = String(text).split(' ');\n+    const known = words.filter(w => /[А-Яа-яЁё]{2,}/.test(w) && this.isKnown(w));\n+    if (known.length < 1) return text;\n+    const kept = words.filter(w => {\n+      const low = w.toLowerCase().replace(/[^а-яё]/g, '');\n+      if (this.isKnown(low) || this.isPlausible(low)) return true;\n+      // «сттангасоат» (11 букв), «риооооро» (три «о» подряд) — звуки, а не слова.\n+      // Порог подобран так, чтобы имена («БЕРСЕРК», «ДРЕГЕР») остались.\n+      if (low.length >= 10) return false;\n+      if (/(.)\\1\\1/.test(low)) return false;\n+      if (low.length <= 2) return false;     // «оо», «чв» — не слова\n+      return true;\n+    });\n+    return kept.join(' ').replace(/\\s{2,}/g, ' ').trim();\n+  },\n+  /** Починка реплики: слова по словарю + висячий дефис в конце. */\n+  finish(text) {\n+    let t = String(text || '');\n+    if (this.ready) {\n+      t = t.replace(/[А-Яа-яЁё]+/g, w => this.correctWord(w));\n+      t = this.stripJunkWords(t);\n+    }\n+    return t.replace(/(?<=\\p{L})-\\s*$/u, '').trim();\n+  },\n+  /**\n+   * Доля «несуществующих» слов. По ней строка из каллиграфии и звуковых\n+   * эффектов отбрасывается: в настоящей реплике почти все слова есть в словаре.\n+   */\n+  junkRatio(text) {\n+    if (!this.ready) return 0;\n+    const words = (String(text).match(/[А-Яа-яЁё]{3,}/g) || []).map(w => w.toLowerCase());\n+    if (!words.length) return 1;\n+    let junk = 0;\n+    for (const w of words) {\n+      const r = this.rank.get(w);\n+      if (r === undefined || r > this.COMMON_RANK) junk++;\n+    }\n+    return junk / words.length;\n+  },\n+  /**\n+   * Починить и отбросить мусор.\n+   *\n+   * Считать «долю мусора» после правки нельзя: правка умеет превратить\n+   * «кослл» в редкое, но существующее «колл», и строка «ол кослл алмчлс»\n+   * проходила фильтр (доля 0.5 при пороге 0.6). Поэтому сначала смотрим на\n+   * ИСХОДНЫЙ текст:\n+   *   • есть настоящие слова   → чиним словарь и оставляем;\n+   *   • нет ни одного, слов 2+  → это каллиграфия/звук, отбрасываем;\n+   *   • нет ни одного, слово 1  → возможно, опечатка: оставляем, только если\n+   *     после правки получается слово из словаря.\n+   */\n+  polish(text, junkRatio, conf) {\n+    const raw = String(text || '');\n+    if (!this.ready) return this.finish(raw);\n+    const thr = junkRatio ?? 0.6;\n+    // {2,} а не {3,}: «Тг. чв» — тоже не реплика, а короткие настоящие слова\n+    // («не», «да», «ты», «он») в словаре есть и проверку проходят.\n+    // Латинская мелочь — это не реплика, а номер страницы или логотип:\n+    // «Tr. 48», «HD», «Tl.48». В репликах кириллица.\n+    const cyrCount = (raw.match(/[А-Яа-яЁё]/g) || []).length;\n+    const latCount = (raw.match(/[A-Za-z]/g) || []).length;\n+    if (cyrCount === 0 && latCount > 0 && latCount <= 5) return '';\n+\n+    const words = (raw.match(/[А-Яа-яЁё]{2,}/g) || []).map(w => w.toLowerCase());\n+    if (!words.length) return this.finish(raw);\n+    const known = words.filter(w => this.isKnown(w));\n+    const knownLong = known.filter(w => w.length >= 3);\n+    const fixed = this.finish(raw);\n+    if (!fixed) return '';\n+    if (knownLong.length >= 1) return fixed;                     // есть настоящие слова\n+\n+    // Одна-две буквы — это реплика только если это настоящее короткое слово:\n+    // «НЕ», «ДА», «ТЫ», «Я». «АН», «АО», «ОИ» — шум от декора, а не реплика.\n+    const letters = cyrCount + latCount;\n+    if (letters <= 2) {\n+      const only = (raw.match(/[А-Яа-яЁёA-Za-z]+/g) || []).join('').toLowerCase();\n+      const shortOk = ['я', 'не', 'да', 'ты', 'он', 'мы', 'вы', 'но', 'ну', 'же',\n+        'ли', 'ах', 'ох', 'эх', 'эй', 'уй', 'ой', 'ай', 'ей', 'их', 'им', 'её', 'его'];\n+      if (!shortOk.includes(only)) return '';\n+    }\n+    // Строка из имён: 1-3 слова, все с заглавной — оставляем (БЕРСЕРК, ГРАФЬ).\n+    const wordsRaw = raw.match(/[А-ЯЁ][а-яё]{2,}/g) || [];\n+    const wordsLong = raw.match(/[А-Яа-яЁё]{3,}/g) || [];\n+    if (wordsRaw.length >= 1 && wordsRaw.length === wordsLong.length && wordsRaw.length <= 3) return fixed;\n+    // Имя или крик капсом, которого нет в словаре: «БЕРСЕРК», «НЕ СМЕЙ».\n+    // Но не «АААААА» и не «СОООООИТ»: тройной повтор буквы — это звук, а не имя.\n+    const caps = (raw.match(/[А-ЯЁ]{3,}/g) || []).filter(w => !/(.)\\1\\1/.test(w.toLowerCase()));\n+    const capsAll = raw.match(/[А-ЯЁ]{3,}/g) || [];\n+    if (caps.length >= 1 && caps.length === capsAll.length\n+        && caps.length === wordsLong.length && caps.length <= 4) return fixed;\n+\n+    // Длинная строка, где настоящих слов меньшинство, — это не реплика:\n+    // «то н оо о оно», «ол кослл алмчлс».\n+    if (words.length >= 3) {\n+      const knownRatio = known.length / words.length;\n+      if (knownRatio < 0.5) return '';\n+    }\n+    if (known.length >= 1 && words.length <= 2) return fixed;    // «да, это», «не сейчас»\n+    return '';\n+  },\n+};\n+\n+/* ───────────────────────── 5. OCR: модели в браузере ───────────────────────── */\n+const OCR = {\n+  det: null, rec: null, dict: null, ready: false,\n+  // Честное состояние движка. Раньше интерфейс писал «движок загружен,\n+  // моделей нет» даже когда все три модели лежали на месте, — потому что\n+  // флага было всего два. Теперь видно, на каком шаге и почему всё встало.\n+  engine: 'idle',        // idle | loading | ready | blocked | failed\n+  reason: '',\n+  hasFiles() { return !!(this.pendingDet && this.pendingRec && this.pendingDict); },\n+  async loadModels() {\n+    const det = await DB.get('kv', 'model:det');\n+    const rec = await DB.get('kv', 'model:rec');\n+    const dict = await DB.get('kv', 'model:dict');\n+    this.pendingDet = !!det; this.pendingRec = !!rec; this.pendingDict = !!dict;\n+    if (!det || !rec || !dict) {\n+      this.ready = false; this.engine = 'idle';\n+      this.reason = 'моделей нет';\n+      return false;\n+    }\n+    if (typeof ort === 'undefined') {\n+      this.ready = false; this.engine = 'failed';\n+      this.reason = 'onnxruntime-web не загрузился: нужна сеть при первом открытии';\n+      return false;\n+    }\n+    this.engine = 'loading'; this.reason = '';\n+    ort.env.wasm.numThreads = 1;                 // без COOP/COEP потоки не нужны\n+    ort.env.wasm.simd = true;\n+    ort.env.logLevel = 'error';\n+    try {\n+      // Движок работает на вшитых в файл бинарях: сеть не нужна вообще.\n+      await installOrtWasm();\n+      this.det = await ort.InferenceSession.create(det.v, { executionProviders: ['wasm'] });\n+      this.rec = await ort.InferenceSession.create(rec.v, { executionProviders: ['wasm'] });\n+    } catch (e) {\n+      this.ready = false;\n+      const msg = String((e && e.message) || e);\n+      // Песочница/строгий CSP запрещают WebAssembly.instantiate — это среда,\n+      // а не файл: на устройстве в Chrome тот же файл работает.\n+      const csp = /unsafe-eval|WebAssembly|CompileError|no available backend/i.test(msg);\n+      this.engine = csp ? 'blocked' : 'failed';\n+      this.reason = csp\n+        ? 'WebAssembly запрещён политикой безопасности этой страницы (предпросмотр). '\n+          + 'Скачайте файл и откройте в Chrome — там WASM разрешён.'\n+        : msg.slice(0, 300);\n+      return false;\n+    }\n+    const lines = String(dict.v).split('\\n');\n+    while (lines.length && lines[lines.length - 1] === '') lines.pop();\n+    // Ровно как в KomaOcrEngine: blank(0) + символы словаря + пробел.\n+    this.dict = [''].concat(lines).concat([' ']);\n+    this.ready = true; this.engine = 'ready'; this.reason = '';\n+    return true;\n+  },\n+  /** Короткая строка для интерфейса. */\n+  statusText() {\n+    if (this.engine === 'ready') return 'движок готов';\n+    if (this.engine === 'loading') return 'движок загружается…';\n+    if (this.engine === 'blocked') return 'модели есть, но WASM заблокирован этой страницей';\n+    if (this.engine === 'failed') return 'модели есть, движок не поднялся';\n+    return this.hasFiles() ? 'модели есть, движок не запускался' : 'моделей нет';\n+  },\n+};\n+\n+/* ── порог «чернил»: перцентили 2%/98% и коэффициент (KomaOcrEngine.inkThreshold) ── */\n+function inkThreshold(luma, R) {\n+  if (!luma.length) return -1;\n+  const hist = new Uint32Array(256);\n+  for (let i = 0; i < luma.length; i++) hist[luma[i] | 0]++;\n+  const pct = (p) => {\n+    const target = Math.max(1, Math.floor(luma.length * p));\n+    let acc = 0;\n+    for (let i = 0; i < 256; i++) { acc += hist[i]; if (acc >= target) return i; }\n+    return 255;\n+  };\n+  const low = pct(R.inkLowPercentile), high = pct(R.inkHighPercentile);\n+  if (high - low < R.inkFlatSpread) return -1;\n+  return clamp(Math.round(low + (high - low) * R.inkCoefficient), R.inkMin, R.inkMax);\n+}\n+/* ── второй уровень «чернил»: серый горб между фоном и тёмным текстом ── */\n+function greyInkRange(luma, R) {\n+  if (luma.length < 64) return null;\n+  const hist = new Uint32Array(256);\n+  for (let i = 0; i < luma.length; i++) hist[luma[i] | 0]++;\n+  const pct = (p) => {\n+    const target = Math.max(1, Math.floor(luma.length * p));\n+    let acc = 0;\n+    for (let i = 0; i < 256; i++) { acc += hist[i]; if (acc >= target) return i; }\n+    return 255;\n+  };\n+  const low = pct(R.inkLowPercentile), high = pct(R.inkHighPercentile);\n+  const spread = high - low;\n+  if (spread < 24) return null;\n+  const from = clamp(Math.floor(low + spread * 0.25), 0, 255);\n+  const to = clamp(Math.floor(low + spread * 0.80), 0, 255);\n+  let bestBin = -1, bestMass = 0;\n+  for (let i = from; i <= to; i++) {\n+    const mass = hist[Math.max(0, i - 1)] + hist[i] + hist[Math.min(255, i + 1)];\n+    if (mass > bestMass) { bestMass = mass; bestBin = i; }\n+  }\n+  if (bestBin < 0 || bestMass < Math.max(3, Math.floor(luma.length / 500))) return null;\n+  const lo = Math.max(low + 1, Math.floor(bestBin - spread * 0.10));\n+  const hi = Math.min(high - 1, Math.floor(bestBin + spread * 0.18));\n+  if (hi <= lo) return null;\n+  return [lo, hi];\n+}\n+\n+/* ── холст ── */\n+function makeCanvas(w, h) {\n+  const c = document.createElement('canvas');\n+  c.width = Math.max(1, Math.round(w)); c.height = Math.max(1, Math.round(h));\n+  return c;\n+}\n+function canvasFromImage(img) {\n+  const c = makeCanvas(img.naturalWidth || img.width, img.naturalHeight || img.height);\n+  c.getContext('2d', { willReadFrequently: true }).drawImage(img, 0, 0);\n+  return c;\n+}\n+function lumaFrom(data, w, h) {\n+  const out = new Uint8Array(w * h);\n+  for (let i = 0, p = 0; i < out.length; i++, p += 4) {\n+    out[i] = (data[p] * 77 + data[p + 1] * 151 + data[p + 2] * 28) >> 8;\n+  }\n+  return out;\n+}\n+\n+/* ── достать тензор из результата run() (объект, Map, или по порядку) ──\n+   session.run() возвращает Promise, а внутри — либо простой объект, либо Map,\n+   в зависимости от версии. Раньше здесь читался out[name].data сразу, и на\n+   телефоне это давало «Cannot read properties of undefined (reading 'data')»:\n+   run() в браузере асинхронный, а мои Node-заглушки были синхронными. */\n+async function runModel(session, feeds, what) {\n+  const res = await session.run(feeds);\n+  const names = session.outputNames || [];\n+  if (res && typeof res.get === 'function') {\n+    if (names.length && res.get(names[0])) return res.get(names[0]);\n+    const first = res.values().next();\n+    return first.done ? null : first.value;\n+  }\n+  if (names.length && res[names[0]]) return res[names[0]];\n+  const vals = Object.keys(res || {}).map(k => res[k]);\n+  if (!vals.length) throw new Error((what || 'модель') + ' не вернула выходов');\n+  return vals[0];\n+}\n+\n+/* ── детектор: боксы текстовых блоков (KomaOcrEngine.detectTile) ── */\n+async function detectBoxes(imgCanvas, side, R) {\n+  const { width: w0, height: h0 } = imgCanvas;\n+  const ratio = Math.min(1, side / Math.max(w0, h0));\n+  const w = Math.max(32, Math.round((w0 * ratio) / 32) * 32);\n+  const h = Math.max(32, Math.round((h0 * ratio) / 32) * 32);\n+  const c = makeCanvas(w, h);\n+  const ctx = c.getContext('2d', { willReadFrequently: true });\n+  ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';\n+  ctx.drawImage(imgCanvas, 0, 0, w, h);\n+  const px = ctx.getImageData(0, 0, w, h).data;\n+  const run = async (normalize) => {\n+    const data = new Float32Array(3 * w * h);\n+    const mean = [0.485, 0.456, 0.406], std = [0.229, 0.224, 0.225];\n+    for (let ch = 0; ch < 3; ch++) {\n+      const off = ch * w * h;\n+      for (let i = 0; i < w * h; i++) {\n+        const v = px[i * 4 + ch] / 255;\n+        data[off + i] = normalize ? (v - mean[ch]) / std[ch] : v;\n+      }\n+    }\n+    const t = new ort.Tensor('float32', data, [1, 3, h, w]);\n+    const name = OCR.det.inputNames[0];\n+    const tensor = await runModel(OCR.det, { [name]: t }, 'детектор');\n+    return components(tensor.data, h, w);           // карта [1,1,h,w]\n+  };\n+  let boxes = await run(false);\n+  let pass = 'normal';\n+  if (!boxes.length && (!R || R.detRetry !== false)) { boxes = await run(true); pass = 'imagenet'; }\n+  const out = boxes.slice(0, 400).map(b => ({\n+    left: clamp(Math.round((b[0] / w) * w0), 0, w0 - 1),\n+    top: clamp(Math.round((b[1] / h) * h0), 0, h0 - 1),\n+    right: clamp(Math.round((b[2] / w) * w0), 1, w0),\n+    bottom: clamp(Math.round((b[3] / h) * h0), 1, h0),\n+  })).filter(b => b.right > b.left && b.bottom > b.top);\n+  // Какая подготовка кадра дала боксы — видно в отчёте шторки.\n+  out.pass = pass;\n+  return out;\n+}\n+/* ── компоненты карты вероятностей (тот же BFS, порог 0.3) ── */\n+function components(map, h, w) {\n+  const visited = new Uint8Array(w * h);\n+  const queue = new Int32Array(w * h);\n+  const boxes = [];\n+  for (let y = 0; y < h; y++) {\n+    for (let x = 0; x < w; x++) {\n+      const idx = y * w + x;\n+      if (visited[idx] || map[idx] < 0.3) continue;\n+      let start = 0, end = 1; queue[0] = idx; visited[idx] = 1;\n+      let minX = x, maxX = x, minY = y, maxY = y, score = 0;\n+      while (start < end) {\n+        const n = queue[start++]; const xx = n % w, yy = (n - xx) / w;\n+        score += map[n];\n+        if (xx < minX) minX = xx; if (xx > maxX) maxX = xx;\n+        if (yy < minY) minY = yy; if (yy > maxY) maxY = yy;\n+        const nb = [xx > 0 ? n - 1 : -1, xx < w - 1 ? n + 1 : -1, yy > 0 ? n - w : -1, yy < h - 1 ? n + w : -1];\n+        for (const ni of nb) {\n+          if (ni >= 0 && !visited[ni] && map[ni] > 0.3) { visited[ni] = 1; queue[end++] = ni; }\n+        }\n+      }\n+      if (end < 6 || score / end < 0.5 || maxX - minX < 2 || maxY - minY < 2) continue;\n+      const expand = Math.max(2, Math.round(((maxX - minX) * (maxY - minY) * 1.5) / (2 * (maxX - minX + maxY - minY + 1))));\n+      boxes.push([Math.max(0, minX - expand), Math.max(0, minY - expand),\n+        Math.min(w, maxX + expand + 1), Math.min(h, maxY + expand + 1)]);\n+    }\n+  }\n+  return boxes.sort((a, b) => a[1] - b[1]);\n+}\n+\n+/* ── нарезка бокса на строки по профилю «чернил» (KomaOcrEngine.textLines) ── */\n+function textLines(imgCanvas, box, R) {\n+  const pad = Math.max(2, Math.floor((box.bottom - box.top) * 0.12));\n+  const left = Math.max(0, box.left - pad), right = Math.min(imgCanvas.width, box.right + pad);\n+  const top = Math.max(0, box.top - pad), bottom = Math.min(imgCanvas.height, box.bottom + pad);\n+  if (right - left < 4 || bottom - top < 4) return [];\n+  const scale = Math.min(1, 400 / (right - left));\n+  const w = Math.max(4, Math.round((right - left) * scale));\n+  const h = Math.max(4, Math.round((bottom - top) * scale));\n+  const c = makeCanvas(w, h);\n+  const ctx = c.getContext('2d', { willReadFrequently: true });\n+  ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';\n+  ctx.drawImage(imgCanvas, left, top, right - left, bottom - top, 0, 0, w, h);\n+  const data = ctx.getImageData(0, 0, w, h).data;\n+  const luma = lumaFrom(data, w, h);\n+  if (inkThreshold(luma, R) < 0) return [];\n+\n+  // подблочные пороги: несколько шрифтов в одном боксе\n+  const rows = clamp(Math.round(R.inkTileRows), 1, 16);\n+  const tileH = Math.max(1, Math.ceil(h / rows));\n+  const thr = new Array(rows);\n+  for (let i = 0; i < rows; i++) {\n+    const y0 = i * tileH, y1 = Math.min(h, y0 + tileH);\n+    thr[i] = y1 <= y0 ? -1 : inkThreshold(luma.subarray(y0 * w, y1 * w), R);\n+  }\n+  const grey = R.inkLevels >= 2 ? greyInkRange(luma, R) : null;\n+  const thrAt = (y) => thr[clamp(Math.floor(y / tileH), 0, rows - 1)];\n+  const isInk = (y, x) => {\n+    const l = luma[y * w + x];\n+    if (l < thrAt(y)) return true;\n+    return !!grey && l >= grey[0] && l <= grey[1];\n+  };\n+  const need = Math.max(1, Math.floor(w / 60));\n+  const rowHasInk = (y) => {\n+    let cnt = 0;\n+    for (let x = 0; x < w; x++) if (isInk(y, x)) { if (++cnt >= need) return true; }\n+    return false;\n+  };\n+  const runs = [];\n+  let y = 0;\n+  while (y < h) {\n+    if (!rowHasInk(y)) { y++; continue; }\n+    let end = y;\n+    while (end < h && rowHasInk(end)) end++;\n+    if (end > y) runs.push([y, end]);\n+    y = Math.max(end, y + 1);\n+  }\n+  if (!runs.length) return [];\n+  const heights = runs.map(r => r[1] - r[0]).sort((a, b) => a - b);\n+  const median = Math.max(1, heights[heights.length >> 1]);\n+  const merged = [];\n+  for (const r of runs) {\n+    const last = merged[merged.length - 1];\n+    if (last && r[0] - last[1] <= Math.max(1, Math.floor(median * 0.35))) last[1] = r[1];\n+    else merged.push([r[0], r[1]]);\n+  }\n+  const lines = [];\n+  for (const r of merged) {\n+    if (r[1] - r[0] < Math.max(2, Math.floor(median * 0.4))) continue;\n+    let x0 = w, x1 = -1;\n+    for (let yy = r[0]; yy < r[1]; yy++) for (let xx = 0; xx < w; xx++) {\n+      if (isInk(yy, xx)) { if (xx < x0) x0 = xx; if (xx > x1) x1 = xx; }\n+    }\n+    if (x1 < 0) continue;\n+    lines.push({\n+      left: clamp(Math.round(left + x0 / scale), left, right - 1),\n+      top: clamp(Math.round(top + r[0] / scale), top, bottom - 1),\n+      right: clamp(Math.round(left + (x1 + 1) / scale), left + 1, right),\n+      bottom: clamp(Math.round(top + (r[1] + 1) / scale), top + 1, bottom),\n+    });\n+  }\n+  return lines;\n+}\n+\n+/* ── распознавание кропа (KomaOcrEngine.decode) ── */\n+async function decodeCrop(cropCanvas) {\n+  let w0 = cropCanvas.width, h0 = cropCanvas.height;\n+  if (w0 < 2 || h0 < 2) return ['', 0];\n+  let src = cropCanvas;\n+  if (h0 > w0 * 1.8) {                    // как в paddlePage: вертикальный кроп поворачиваем\n+    const rot = makeCanvas(h0, w0);\n+    const rc = rot.getContext('2d', { willReadFrequently: true });\n+    rc.translate(rot.width / 2, rot.height / 2); rc.rotate(Math.PI / 2);\n+    rc.drawImage(cropCanvas, -w0 / 2, -h0 / 2);\n+    src = rot; w0 = rot.width; h0 = rot.height;\n+  }\n+  const width = clamp(Math.round((48 * w0) / h0), 8, 960);\n+  const padded = Math.max(320, width);\n+  const c = makeCanvas(padded, 48);\n+  const ctx = c.getContext('2d', { willReadFrequently: true });\n+  ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';\n+  ctx.drawImage(src, 0, 0, width, 48);\n+  const px = ctx.getImageData(0, 0, width, 48).data;\n+  const norm = (ch) => px[0]; void norm;\n+  const data = new Float32Array(3 * 48 * padded);\n+  for (let ch = 0; ch < 3; ch++) {\n+    const off = ch * 48 * padded;\n+    for (let y = 0; y < 48; y++) for (let x = 0; x < width; x++) {\n+      data[off + y * padded + x] = ((px[(y * width + x) * 4 + ch] / 255) - 0.5) / 0.5;\n+    }\n+  }\n+  const t = new ort.Tensor('float32', data, [1, 3, 48, padded]);\n+  const logits = await runModel(OCR.rec, { [OCR.rec.inputNames[0]]: t }, 'распознавание');\n+  const T = logits.dims[1], C = logits.dims[2], values = logits.data;   // [1,T,519]\n+  let text = '', prev = 0, score = 0, count = 0;\n+  for (let ti = 0; ti < T; ti++) {\n+    const base = ti * C;\n+    let best = 0, bestV = values[base];\n+    for (let ci = 1; ci < C; ci++) { const v = values[base + ci]; if (v > bestV) { bestV = v; best = ci; } }\n+    if (best !== 0 && best !== prev) {\n+      text += OCR.dict[best] ?? '';\n+      score += bestV; count++;\n+    }\n+    prev = best;\n+  }\n+  return [text, count ? score / count : 0];\n+}\n+function binarizeCanvas(src, polarity, R) {\n+  const w = src.width, h = src.height;\n+  if (w < 2 || h < 2) return src;\n+  const ctx = src.getContext('2d', { willReadFrequently: true });\n+  const img = ctx.getImageData(0, 0, w, h);\n+  const luma = lumaFrom(img.data, w, h);\n+  let t = inkThreshold(luma, R);\n+  if (t < 0) t = R.binarizeFallback;\n+  for (let i = 0; i < luma.length; i++) {\n+    const dark = luma[i] < t;\n+    const v = polarity === 0 ? (dark ? 0 : 255) : (dark ? 255 : 0);\n+    const p = i * 4;\n+    img.data[p] = img.data[p + 1] = img.data[p + 2] = v; img.data[p + 3] = 255;\n+  }\n+  const out = makeCanvas(w, h);\n+  out.getContext('2d').putImageData(img, 0, 0);\n+  return out;\n+}\n+/** Счётчики проходов: видны в шторке текста, а не «где-то в консоли». */\n+const DECODE_STATS = { variantRuns: 0, variantsPicked: 0, uncoveredLines: 0, wordsTried: 0, wordsFixed: 0 };\n+\n+/** Увеличение кропа: мелкий и рукописный текст CTC читает лучше крупнее. */\n+function upscaleCanvas(src, k) {\n+  const w = Math.max(1, Math.round(src.width * k));\n+  const h = Math.max(1, Math.round(src.height * k));\n+  const out = makeCanvas(w, h);\n+  const ctx = out.getContext('2d', { willReadFrequently: true });\n+  ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';\n+  ctx.drawImage(src, 0, 0, w, h);\n+  return out;\n+}\n+\n+/** Все ли слова строки настоящие (по словарю и словоформам). */\n+function allWordsKnown(text) {\n+  if (!Words.ready) return false;\n+  const words = String(text).match(/[\\p{L}]{2,}/gu) || [];\n+  if (!words.length) return false;\n+  return words.every(w => {\n+    const low = w.toLowerCase();\n+    return Words.isKnown(low) || Words.isPlausible(low);\n+  });\n+}\n+\n+/** Оценка текста: сколько слов настоящее и сколько мусорных + уверенность. */\n+function textScore(text, conf) {\n+  const words = String(text).match(/[\\p{L}]{2,}/gu) || [];\n+  if (!words.length) return -50;\n+  let known = 0, junk = 0;\n+  for (const w of words) {\n+    const low = w.toLowerCase();\n+    if (!Words.ready || Words.isKnown(low) || Words.isPlausible(low)) known++;\n+    else junk++;\n+  }\n+  return known * 10 - junk * 12 + (conf || 0) * 3;\n+}\n+\n+/**\n+ * Дочинить ОТДЕЛЬНЫЕ слова, не трогая уже верные.\n+ *\n+ * Идея: если в строке одно слово прочитано неверно («БУДЕ.», «ПРИБЫЛА»), то\n+ * перебор вариантов по всей строке бесполезен — модель ошибается на всём\n+ * кропе сразу. Поэтому строку режем по столбцам на слова, гоним варианты\n+ * только по кропу битого слова, а верные слова и верные строки не трогаем.\n+ *\n+ * Защита от порчи: замена принимается, только если из кропа получилось\n+ * настоящее слово (по словарю или как словоформа) близкой длины. На\n+ * каллиграфии кропы дают «p», «тр» — такие кандидаты отбрасываются, и\n+ * строка остаётся как была.\n+ */\n+async function refineBrokenWords(crop, text, R) {\n+  const re = /[\\p{L}]{2,}/gu;\n+  const spans = [];\n+  let m;\n+  while ((m = re.exec(text))) spans.push({ word: m[0], start: m.index, end: re.lastIndex });\n+  if (spans.length < 2) return text;\n+  const bad = spans.filter(sp => {\n+    const low = sp.word.toLowerCase();\n+    return !(Words.isKnown(low) || Words.isPlausible(low));\n+  });\n+  if (!bad.length) return text;                       // всё верно — не трогаем\n+\n+  const boxes = wordColumns(crop, R);\n+  if (boxes.length !== spans.length) return text;     // разметка не совпала — не рискуем\n+\n+  let out = text;\n+  for (let i = spans.length - 1; i >= 0; i--) {       // справа налево, чтобы индексы не ехали\n+    const sp = spans[i];\n+    if (!bad.includes(sp)) continue;                  // верные слова пропускаем\n+    const box = boxes[i];\n+    const w = box[1] - box[0] + 1;\n+    if (w < 18 || w > crop.width * 0.6) continue;     // слишком узко/широко — не угадать\n+    const wordCrop = makeCanvas(w, crop.height);\n+    wordCrop.getContext('2d', { willReadFrequently: true })\n+      .drawImage(crop, box[0], 0, w, crop.height, 0, 0, w, crop.height);\n+    const cand = await bestWordVariant(wordCrop, sp.word, R);\n+    if (!cand) continue;\n+    DECODE_STATS.wordsFixed++;\n+    out = out.slice(0, sp.start) + cand + out.slice(sp.end);\n+  }\n+  return out;\n+}\n+\n+/** Варианты распознавания одного слова; возвращает первое настоящее слово. */\n+async function bestWordVariant(wordCrop, original, R) {\n+  const len = Array.from(original).length;\n+  const padX = Math.max(2, Math.round(wordCrop.height * 0.25));\n+  const padY = Math.max(1, Math.round(wordCrop.height * 0.15));\n+  const padded = makeCanvas(wordCrop.width + padX * 2, wordCrop.height + padY * 2);\n+  const pctx = padded.getContext('2d', { willReadFrequently: true });\n+  pctx.fillStyle = '#fff'; pctx.fillRect(0, 0, padded.width, padded.height);\n+  pctx.drawImage(wordCrop, padX, padY);\n+  const tries = [\n+    ['orig', wordCrop],\n+    ['pad', padded],\n+    ['up2', upscaleCanvas(wordCrop, 2)],\n+    ['padUp2', upscaleCanvas(padded, 2)],\n+    ['contrast', contrastCanvas(wordCrop)],\n+  ];\n+  for (const [name, cv] of tries) {\n+    DECODE_STATS.wordsTried++;\n+    let cand = '';\n+    try { [cand] = await decodeCrop(cv); } catch (e) { continue; }\n+    const clean = String(cand).replace(/[^\\p{L}]/gu, '');\n+    if (!clean || Math.abs(Array.from(clean).length - len) > 1) continue;\n+    const low = clean.toLowerCase();\n+    if (!(Words.isKnown(low) || Words.isPlausible(low))) continue;\n+    if (low === original.toLowerCase()) return null;\n+    return clean;\n+  }\n+  return null;\n+}\n+\n+/** Границы слов в строке по столбцовой проекции «чернил». */\n+function wordColumns(crop, R) {\n+  const w = crop.width, h = crop.height;\n+  if (w < 4 || h < 4) return [];\n+  const data = crop.getContext('2d', { willReadFrequently: true }).getImageData(0, 0, w, h).data;\n+  const luma = lumaFrom(data, w, h);\n+  const thr = inkThreshold(luma, R);\n+  if (thr < 0) return [];\n+  const ink = new Uint8Array(w);\n+  for (let x = 0; x < w; x++) {\n+    for (let y = 0; y < h; y++) if (luma[y * w + x] < thr) { ink[x] = 1; break; }\n+  }\n+  const gapMax = Math.max(2, Math.round(h * 0.30));\n+  const boxes = [];\n+  let x0 = -1, gap = 0;\n+  for (let x = 0; x < w; x++) {\n+    if (ink[x]) { if (x0 < 0) x0 = x; gap = 0; }\n+    else if (x0 >= 0) {\n+      gap++;\n+      if (gap >= gapMax) { boxes.push([x0, x - gap]); x0 = -1; gap = 0; }\n+    }\n+  }\n+  if (x0 >= 0) boxes.push([x0, w - 1]);\n+  return boxes;\n+}\n+\n+/**\n+ * Перебор всех подготовок кропа: как есть, увеличенный, с растянутой\n+ * яркостью и две полярности бинаризации. Побеждает вариант, где больше\n+ * настоящих слов и меньше мусорных. Как только все слова верные — выходим,\n+ * чтобы не тратить время на телефоне.\n+ */\n+/** Кроп с белыми полями: модель видит целые буквы, а не обрезанные края. */\n+function padCanvas(src, frac) {\n+  const pad = Math.max(1, Math.round(src.height * frac));\n+  const out = makeCanvas(src.width + pad * 2, src.height + pad * 2);\n+  const ctx = out.getContext('2d', { willReadFrequently: true });\n+  ctx.fillStyle = '#fff';\n+  ctx.fillRect(0, 0, out.width, out.height);\n+  ctx.drawImage(src, pad, pad);\n+  return out;\n+}\n+\n+async function decodeAllVariants(crop, R, first) {\n+  // Порядок по замеренной пользе на реальной странице: увеличение и контраст\n+  // дают верные слова чаще, бинаризация — редко и дорого.\n+  // Поля важнее увеличения: на рукописном титуле «сестрой тирана.» читается\n+  // только с отступом 20 %, а без него выходит «естра тирана». Поэтому поля\n+  // идут сразу после исходного кропа.\n+  const pointed = padCanvas(crop, 0.2);\n+  const tries = [['orig', crop], ['pad20', pointed]];\n+  if (crop.height >= 12) tries.push(['up2', upscaleCanvas(crop, 2)]);\n+  tries.push(['contrast', contrastCanvas(crop)]);\n+  tries.push(['pad20up2', upscaleCanvas(pointed, 2)]);\n+  tries.push(['bin0', binarizeCanvas(crop, 0, R)]);\n+  let best = null;\n+  for (const [name, cv] of tries) {\n+    let text = '', conf = 0;\n+    // Исходный кроп уже распознан в decodeBetter — не гоняем модель дважды.\n+    if (name === 'orig' && first) { text = first[0]; conf = first[1]; }\n+    else {\n+      try { [text, conf] = await decodeCrop(cv); } catch (e) { continue; }\n+    }\n+    DECODE_STATS.variantRuns++;\n+    const score = textScore(text, conf);\n+    if (!best || score > best.score) {\n+      if (best && best.variant !== 'orig') DECODE_STATS.variantsPicked++;\n+      best = { text, conf, score, variant: name };\n+    }\n+    if (allWordsKnown(best.text)) break;\n+  }\n+  return best || ['', 0, 'none'];\n+}\n+\n+async function decodeBetter(cropCanvas, R, opts = {}) {\n+  const first = await decodeCrop(cropCanvas);\n+  // Всё уже верно — не тратим батарею на перебор.\n+  if (allWordsKnown(first[0])) return first;\n+  const letters = (s) => (s.match(/\\p{L}/gu) || []).length;\n+  // Широкие строки — это реплики и подписи: ради верных слов перебираем все\n+  // подготовки кропа. Узкие (звуковые эффекты) не перебираем: там всё равно\n+  // не слова, и на телефоне это лишние секунды.\n+  if (R.decodeVariants !== false && (opts.wide || letters(first[0]) >= 3)) {\n+    const best = await decodeAllVariants(cropCanvas, R, first);\n+    return [best.text, best.conf];\n+  }\n+  const need = Math.max(0, Math.round(R.decodeRetryBelow ?? 1));\n+  if (need === 0 || letters(first[0]) >= need) return first;\n+  let best = first;\n+  for (const pol of [0, 1]) {\n+    const att = await decodeCrop(binarizeCanvas(cropCanvas, pol, R));\n+    if (letters(att[0]) > letters(best[0])) best = att;\n+  }\n+  return best;\n+}\n+\n+/* ── страница целиком: детектор → строки → распознавание ── */\n+/**\n+ * Видна ли строка на экране. band.vy0…vy1 — это ровно экран, без запаса,\n+ * который нужен был детектору. Строку, видимую хотя бы на 40 %, берём целиком\n+ * (не рвём реплику), а облачко ниже экрана не берём вовсе — иначе в шторке\n+ * появлялся «лишний» текст, которого на экране нет.\n+ */\n+/** Расстояние Левенштейна: нужно для честной правки в два редактирования. */\n+function levenshtein(a, b) {\n+  const s = Array.from(a), t = Array.from(b);\n+  if (!s.length) return t.length;\n+  if (!t.length) return s.length;\n+  let prev = new Array(t.length + 1);\n+  let cur = new Array(t.length + 1);\n+  for (let j = 0; j <= t.length; j++) prev[j] = j;\n+  for (let i = 1; i <= s.length; i++) {\n+    cur[0] = i;\n+    for (let j = 1; j <= t.length; j++) {\n+      const cost = s[i - 1] === t[j - 1] ? 0 : 1;\n+      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);\n+    }\n+    [prev, cur] = [cur, prev];\n+  }\n+  return prev[t.length];\n+}\n+\n+function lineInBand(ln, band, y0) {\n+  if (!band || band.vy0 == null || band.vy1 == null) return true;\n+  const top = y0 + ln.top, bottom = y0 + ln.bottom;\n+  const h = bottom - top;\n+  if (h <= 0) return false;\n+  const over = Math.min(bottom, band.vy1) - Math.max(top, band.vy0);\n+  return over >= h * 0.4;\n+}\n+\n+async function recognizePage(imgCanvas, R, onProgress, band) {\n+  const t0 = performance.now();\n+  DECODE_STATS.variantRuns = 0; DECODE_STATS.variantsPicked = 0; DECODE_STATS.uncoveredLines = 0; DECODE_STATS.wordsTried = 0; DECODE_STATS.wordsFixed = 0;\n+  // band = {y0, y1} в пикселях исходного кадра: распознаём ТОЛЬКО видимую\n+  // полосу. По правилу «длинную страницу читать в пределах видимой области»\n+  // иначе на вебтуне в 8000 px находились реплики на два экрана вперёд.\n+  let src = imgCanvas;\n+  const y0 = band ? Math.max(0, Math.round(band.y0)) : 0;\n+  const y1 = band ? Math.min(imgCanvas.height, Math.round(band.y1)) : imgCanvas.height;\n+  const bandH = Math.max(1, y1 - y0);\n+  if (band && (y0 > 0 || y1 < imgCanvas.height)) {\n+    const c = makeCanvas(imgCanvas.width, bandH);\n+    c.getContext('2d', { willReadFrequently: true })\n+      .drawImage(imgCanvas, 0, y0, imgCanvas.width, bandH, 0, 0, imgCanvas.width, bandH);\n+    src = c;\n+  }\n+  const visible = (ln) => lineInBand(ln, band, y0);\n+\n+  // ── Проход 1: детектор. Если он не нашёл ничего, пробуем другие подготовки\n+  // кадра: бледная каллиграфия и светлый текст на белом фоне не ловятся на\n+  // исходном кадре, а на контрастном/бинаризованном находятся.\n+  const det = await detectWithRetry(src, R);\n+  const detMs = Math.round(performance.now() - t0);\n+  const t1 = performance.now();\n+  const W = src.width, H = src.height;\n+  let crops = 0;\n+  const regions = [];\n+  let largePasses = 0;\n+\n+  const decodeLine = async (canvas, ln, wide) => {\n+    const c = makeCanvas(Math.max(1, ln.right - ln.left), Math.max(1, ln.bottom - ln.top));\n+    c.getContext('2d', { willReadFrequently: true })\n+      .drawImage(canvas, ln.left, ln.top, ln.right - ln.left, ln.bottom - ln.top, 0, 0, c.width, c.height);\n+    crops++;\n+    const [text, conf] = await decodeBetter(c, R, { wide });\n+    return { text, conf };\n+  };\n+\n+  // ── Проход 1: строки внутри боксов. Сначала собираем всё, потом (зная\n+  // типичную высоту строки) решаем, какие боксы — крупный текст.\n+  const byBox = [];\n+  let done = 0;\n+  for (const box of det.boxes) {\n+    const lines = textLines(src, box, R).filter(visible);\n+    const items = [];\n+    for (const ln of lines) {\n+      const wide = (ln.right - ln.left) / W >= 0.25;   // реплика, а не звук\n+      let { text, conf } = await decodeLine(src, ln, wide);\n+      // Битые слова дочиниваем по одному, верные — не трогаем.\n+      if (wide && text && !allWordsKnown(text)) {\n+        const crop = makeCanvas(Math.max(1, ln.right - ln.left), Math.max(1, ln.bottom - ln.top));\n+        crop.getContext('2d', { willReadFrequently: true })\n+          .drawImage(src, ln.left, ln.top, ln.right - ln.left, ln.bottom - ln.top, 0, 0, crop.width, crop.height);\n+        const fixed = await refineBrokenWords(crop, text, R);\n+        if (fixed !== text && textScore(fixed, conf) > textScore(text, conf)) text = fixed;\n+      }\n+      if (text.trim() && conf > R.minConfidence) {\n+        items.push({\n+          text,\n+          left: ln.left / W, top: (y0 + ln.top) / imgCanvas.height,\n+          right: ln.right / W, bottom: (y0 + ln.bottom) / imgCanvas.height,\n+          confidence: conf,\n+        });\n+      }\n+    }\n+    byBox.push({ box, items });\n+    done++;\n+    if (onProgress) onProgress(done, det.boxes.length + 0);\n+    await sleep(0);      // не блокируем кадр\n+  }\n+\n+  // ── Проход 2: крупный текст (титул, каллиграфия, большие буквы). На обычном\n+  // масштабе такой блок слипается в одну «строку» и читается плохо. Кроп\n+  // увеличиваем и ищем заново — тогда блок делится на строки, и каждая\n+  // распознаётся отдельно. Берём результат, только если он лучше первого.\n+  const pageMedian = medianLineHeight(byBox);\n+  for (const entry of byBox) {\n+    if (R.largeText === false) break;\n+    const own = entry.items.map(i => i.bottom - i.top).sort((a, b) => a - b);\n+    const h = own.length ? own[own.length >> 1] * imgCanvas.height : 0;\n+    const boxW = (entry.box.right - entry.box.left) / W;\n+    const firstTexts = entry.items.map(i => i.text);\n+    const letters = lettersOf(firstTexts);\n+    const hard = letters >= 8 && knownShare(firstTexts) < 0.5;\n+    const big = pageMedian > 0 && h > pageMedian * 1.8;\n+    if (boxW < (R.largeMinWidth ?? 0.22) || !(hard || big)) continue;\n+    largePasses++;\n+    const alt = await recognizeLargeBox(src, entry.box, R, { visible, y0, pageH: imgCanvas.height, W });\n+    crops += alt.crops;\n+    // Текст не теряем: принимаем второй проход, только если он сохранил хотя\n+    // бы 80 % букв (иначе из титула пропадали строки).\n+    if (!alt.items.length || lettersOf(alt.items.map(i => i.text)) < letters * 0.8) continue;\n+    if (qualityOf(alt.items.map(i => i.text)) > qualityOf(firstTexts)) entry.items = alt.items;\n+  }\n+  for (const entry of byBox) for (const item of entry.items) regions.push(item);\n+\n+  // ── Проход 3: то, что детектор не закрыл боксами. Дешёвый поиск полос с\n+  // «чернилами» без боксов; если в такой полосе нашлись строки — распознаём.\n+  if (R.uncoveredPass !== false) {\n+    const extra = uncoveredBands(src, det.boxes, R);\n+    for (const band of extra) {\n+      for (const ln of textLines(src, band, R)) {\n+        if (!visible(ln)) continue;\n+        const wide = (ln.right - ln.left) / W >= 0.25;\n+        const { text, conf } = await decodeLine(src, ln, wide);\n+        if (!text.trim() || conf <= R.minConfidence) continue;\n+        DECODE_STATS.uncoveredLines++;\n+        const item = {\n+          text,\n+          left: ln.left / W, top: (y0 + ln.top) / imgCanvas.height,\n+          right: ln.right / W, bottom: (y0 + ln.bottom) / imgCanvas.height,\n+          confidence: conf,\n+        };\n+        // уже есть почти то же самое на этом месте — не дублируем\n+        const dup = regions.some(o =>\n+          Math.min(o.bottom, item.bottom) - Math.max(o.top, item.top) > (item.bottom - item.top) * 0.5\n+          && Math.abs(o.left - item.left) < 0.2);\n+        if (!dup) regions.push(item);\n+      }\n+    }\n+  }\n+\n+  return {\n+    regions, boxes: det.boxes.length,\n+    ms: Math.round(performance.now() - t0),\n+    detMs, recMs: Math.round(performance.now() - t1), crops,\n+    band: band ? { y0, y1 } : null,\n+    detPass: det.pass,\n+    largePasses,\n+    variantRuns: DECODE_STATS.variantRuns,\n+    variantsPicked: DECODE_STATS.variantsPicked,\n+    uncoveredLines: DECODE_STATS.uncoveredLines,\n+    wordsTried: DECODE_STATS.wordsTried,\n+    wordsFixed: DECODE_STATS.wordsFixed,\n+  };\n+}\n+\n+/**\n+ * Строки с текстом, которые детектор НЕ закрыл ни одним боксом.\n+ *\n+ * На скриншоте 12:54 средняя строка титула («жизнь, будучи») не попала ни в\n+ * один бокс и пропала из текста. Ищем по кадру полосы, где есть «чернила», но\n+ * нет боксов, и отдаём их на распознавание — чтобы не терять слова.\n+ */\n+function uncoveredBands(src, boxes, R) {\n+  const out = [];\n+  const SW = 200;                                   // рабочая ширина\n+  const k = SW / src.width;\n+  const w = SW, h = Math.max(8, Math.round(src.height * k));\n+  const small = makeCanvas(w, h);\n+  const ctx = small.getContext('2d', { willReadFrequently: true });\n+  ctx.drawImage(src, 0, 0, w, h);\n+  const luma = lumaFrom(ctx.getImageData(0, 0, w, h).data, w, h);\n+  const thr = inkThreshold(luma, R);\n+  if (thr < 0) return out;\n+  const covered = new Uint8Array(h);\n+  for (const b of boxes) {\n+    const y0 = Math.max(0, Math.floor(b.top * k) - 2);\n+    const y1 = Math.min(h - 1, Math.ceil(b.bottom * k) + 2);\n+    for (let y = y0; y <= y1; y++) covered[y] = 1;\n+  }\n+  const need = Math.max(2, Math.round(w * 0.02));   // сколько тёмного в строке\n+  const hasInk = (y) => {\n+    let cnt = 0;\n+    for (let x = 0; x < w; x++) if (luma[y * w + x] < thr) { if (++cnt >= need) return true; }\n+    return false;\n+  };\n+  const runs = [];\n+  let y = 0;\n+  while (y < h) {\n+    if (covered[y] || !hasInk(y)) { y++; continue; }\n+    let end = y;\n+    while (end < h && !covered[end] && hasInk(end)) end++;\n+    if (end - y >= 3) runs.push([y, end]);\n+    y = Math.max(end, y + 1);\n+  }\n+  for (const [a, b] of runs) {\n+    const top = clamp(Math.floor(a / k) - 3, 0, src.height - 1);\n+    const bottom = clamp(Math.ceil(b / k) + 3, top + 1, src.height);\n+    out.push({ left: 0, top, right: src.width, bottom });\n+  }\n+  return out.slice(0, 12);\n+}\n+\n+/** Медиана высоты реплик на странице — по ней отличаем крупный текст. */\n+/** Сколько букв в наборе строк. */\n+function lettersOf(texts) {\n+  let n = 0;\n+  for (const t of texts || []) n += (String(t).match(/\\p{L}/gu) || []).length;\n+  return n;\n+}\n+\n+/** Доля слов, известных словарю: по ней видно «трудный» текст. */\n+function knownShare(texts) {\n+  let all = 0, known = 0;\n+  for (const t of texts || []) {\n+    for (const w of String(t).match(/[\\p{L}\\p{N}]{2,}/gu) || []) {\n+      all++;\n+      if (!Words.ready || Words.isKnown(w.toLowerCase()) || Words.isPlausible(w.toLowerCase())) known++;\n+    }\n+  }\n+  return all ? known / all : 0;\n+}\n+\n+function medianLineHeight(byBox) {\n+  const hs = [];\n+  for (const e of byBox) for (const i of e.items) hs.push(i.bottom - i.top);\n+  hs.sort((a, b) => a - b);\n+  return hs.length ? hs[hs.length >> 1] : 0;\n+}\n+\n+/**\n+ * Насколько текст похож на настоящий: сколько слов знает словарь. По этой\n+ * оценке выбираем между первым и вторым проходом («будучи» лучше «будучиг»).\n+ */\n+function qualityOf(texts) {\n+  if (!texts || !texts.length) return 0;\n+  let known = 0, all = 0;\n+  for (const t of texts) {\n+    for (const w of String(t).match(/[\\p{L}\\p{N}]{2,}/gu) || []) {\n+      all++;\n+      if (!Words.ready || Words.isKnown(w.toLowerCase()) || Words.isPlausible(w.toLowerCase())) known++;\n+    }\n+  }\n+  if (!all) return 0;\n+  // Главное — доля знакомых слов. Число слов только чуть-чуть поощряется,\n+  // иначе вариант с лишними буквами («МОжиМЬ Как прожить») выигрывал у\n+  // чистого «Как прожить».\n+  return (known / all) * 100 + Math.min(all, 20) * 0.5;\n+}\n+\n+/**\n+ * Детектор с повторами: если на исходном кадре боксов 0, пробуем контраст и\n+ * две полярности бинаризации. Возвращает, какая подготовка сработала, чтобы\n+ * это было видно в отчёте шторки, а не оставалось тайной.\n+ */\n+async function detectWithRetry(src, R) {\n+  const boxes = await detectBoxes(src, R.pageSide, R);\n+  if (boxes.length) return { boxes, pass: boxes.pass || 'normal' };\n+  if (R.detRetry === false) return { boxes: [], pass: 'none' };\n+  const variants = [\n+    ['contrast', () => contrastCanvas(src)],\n+    ['binary', () => binarizeCanvas(src, 0, R)],\n+    ['binary-inv', () => binarizeCanvas(src, 1, R)],\n+  ];\n+  for (const variant of variants) {\n+    try {\n+      const found = await detectBoxes(variant[1](), R.pageSide, R);\n+      if (found.length) return { boxes: found, pass: variant[0] };\n+    } catch (e) { console.warn('повтор детектора (' + variant[0] + ') не удался', e); }\n+  }\n+  return { boxes: [], pass: 'none' };\n+}\n+\n+/** Растянуть диапазон яркости: бледный текст на белом иначе не виден детектору. */\n+function contrastCanvas(src) {\n+  const w = src.width, h = src.height;\n+  const ctx = src.getContext('2d', { willReadFrequently: true });\n+  const img = ctx.getImageData(0, 0, w, h);\n+  const luma = lumaFrom(img.data, w, h);\n+  let lo = 255, hi = 0;\n+  for (let i = 0; i < luma.length; i++) { const v = luma[i]; if (v < lo) lo = v; if (v > hi) hi = v; }\n+  const span = Math.max(1, hi - lo);\n+  for (let i = 0; i < luma.length; i++) {\n+    const v = clamp(Math.round(((luma[i] - lo) / span) * 255), 0, 255);\n+    const p = i * 4;\n+    img.data[p] = img.data[p + 1] = img.data[p + 2] = v; img.data[p + 3] = 255;\n+  }\n+  const out = makeCanvas(w, h);\n+  out.getContext('2d').putImageData(img, 0, 0);\n+  return out;\n+}\n+\n+/**\n+ * Второй проход по крупному блоку: увеличить кроп, найти боксы заново,\n+ * разбить на строки и распознать каждую. Координаты возвращаются в системе\n+ * всей страницы, чтобы рамки стояли на месте.\n+ */\n+async function recognizeLargeBox(src, box, R, ctxInfo) {\n+  const out = { items: [], crops: 0 };\n+  const pad = Math.round((box.bottom - box.top) * 0.10);\n+  const left = clamp(box.left - pad, 0, src.width - 1);\n+  const right = clamp(box.right + pad, 1, src.width);\n+  const top = clamp(box.top - pad, 0, src.height - 1);\n+  const bottom = clamp(box.bottom + pad, 1, src.height);\n+  const bw = right - left, bh = bottom - top;\n+  if (bw < 40 || bh < 20) return out;\n+  const k = clamp(Math.round(1200 / Math.max(bw, bh)), 1, 4);\n+  if (k < 2) return out;                       // мелкий блок увеличивать незачем\n+  const up = makeCanvas(Math.round(bw * k), Math.round(bh * k));\n+  const uctx = up.getContext('2d', { willReadFrequently: true });\n+  uctx.imageSmoothingEnabled = true; uctx.imageSmoothingQuality = 'high';\n+  uctx.drawImage(src, left, top, bw, bh, 0, 0, up.width, up.height);\n+  // Бледная каллиграфия на белом не даёт чернильных строк на исходном кропе.\n+  // Поэтому пробуем три подготовки кадра и берём ту, где текст получился\n+  // осмысленнее: увеличено / с растянутой яркостью / бинаризовано.\n+  const full = { left: 0, top: 0, right: up.width, bottom: up.height };\n+  const variants = [\n+    up,\n+    contrastCanvas(up),\n+    binarizeCanvas(up, 0, R),\n+  ];\n+  let best = null;\n+  for (const work of variants) {\n+    const boxes = await detectBoxes(work, R.pageSide, R);\n+    const lines = [];\n+    for (const b of boxes) for (const ln of textLines(work, b, R)) lines.push(ln);\n+    if (lines.length < 2) {\n+      for (const ln of textLines(work, full, R)) {\n+        if (!lines.some(o => Math.abs(o.top - ln.top) < 4)) lines.push(ln);\n+      }\n+    }\n+    if (!lines.length) continue;\n+    const got = await decodeLargeLines(work, lines, R, { k, left, top, src, ctxInfo });\n+    out.crops += got.crops;\n+    if (!got.items.length) continue;\n+    const score = qualityOf(got.items.map(i => i.text)) + Math.min(got.items.length, 6) * 3;\n+    if (!best || score > best.score) best = { score, items: got.items };\n+  }\n+  out.items = best ? best.items : [];\n+  return out;\n+}\n+\n+/** Распознать найденные строки увеличенного кропа и вернуть их на страницу. */\n+async function decodeLargeLines(work, lines, R, info) {\n+  const items = [];\n+  let crops = 0;\n+  for (const ln of lines) {\n+    const orig = {\n+      left: clamp(Math.round(info.left + ln.left / info.k), 0, info.src.width - 1),\n+      top: clamp(Math.round(info.top + ln.top / info.k), 0, info.src.height - 1),\n+      right: clamp(Math.round(info.left + ln.right / info.k), 1, info.src.width),\n+      bottom: clamp(Math.round(info.top + ln.bottom / info.k), 1, info.src.height),\n+    };\n+    if (!info.ctxInfo.visible(orig)) continue;\n+    const c = makeCanvas(Math.max(1, ln.right - ln.left), Math.max(1, ln.bottom - ln.top));\n+    c.getContext('2d', { willReadFrequently: true })\n+      .drawImage(work, ln.left, ln.top, ln.right - ln.left, ln.bottom - ln.top, 0, 0, c.width, c.height);\n+    crops++;\n+    const wide = (ln.right - ln.left) / work.width >= 0.25;\n+    const [text, conf] = await decodeBetter(c, R, { wide });\n+    if (text.trim() && conf > R.minConfidence) {\n+      items.push({\n+        text,\n+        left: orig.left / info.ctxInfo.W,\n+        top: (info.ctxInfo.y0 + orig.top) / info.ctxInfo.pageH,\n+        right: orig.right / info.ctxInfo.W,\n+        bottom: (info.ctxInfo.y0 + orig.bottom) / info.ctxInfo.pageH,\n+        confidence: conf, large: true,\n+      });\n+    }\n+  }\n+  return { items, crops };\n+}\n+\n+\n+/* ───────────────────────── 6. Порядок чтения ───────────────────────── */\n+const isCyr = (t) => {\n+  const all = (t.match(/\\p{L}/gu) || []).length;\n+  if (!all) return false;\n+  const ru = (t.match(/[а-яёА-ЯЁ]/gi) || []).length;\n+  return ru > 0 && ru * 2 >= all;\n+};\n+/* Правки слов из правил: до словаря, без учёта регистра, регистр сохраняем. */\n+function applyWordFixes(text, fixes) {\n+  const keys = Object.keys(fixes || {});\n+  if (!keys.length) return text;\n+  const low = {}; keys.forEach(k => low[k.toLowerCase()] = fixes[k]);\n+  return text.replace(/[\\p{L}\\p{N}]+/gu, (word) => {\n+    const rep = low[word.toLowerCase()];\n+    if (!rep) return word;\n+    if (word === word.toUpperCase()) return rep.toUpperCase();\n+    if (/^\\p{Lu}/u.test(word)) return rep.charAt(0).toUpperCase() + rep.slice(1);\n+    return rep;\n+  });\n+}\n+/* облачка: склейка строк одной высоты (bubbleGap + mergeHeightRatio) */\n+/**\n+ * Перенос слова с точкой вместо дефиса: OCR читает «БУДЕ-» как «БУДЕ.».\n+ * Склеиваем без пробела, только если вместе получается слово из словаря —\n+ * иначе «НО.» + «ОН» превратилось бы в «НООН».\n+ */\n+function joinBrokenWord(text, next) {\n+  const m = String(text).match(/([\\p{L}]{2,})[.\\-]$/u);\n+  if (!m) return false;\n+  const head = String(next).trim().split(/\\s+/)[0] || '';\n+  if (!/^[\\p{L}]/u.test(head)) return false;\n+  const cand = (m[1] + head).toLowerCase();\n+  if (!Words.ready) return false;\n+  return Words.isKnown(cand) || Words.isPlausible(cand);\n+}\n+\n+function bubblesOf(group, rtl, R) {\n+  const bubbleGap = R.bubbleGap;\n+  if (!group.length) return [];\n+  const sorted = group.slice().sort((a, b) => a.top - b.top || a.left - b.left);\n+  const blocks = [];\n+  for (const rg of sorted) {\n+    let target = null, bestGap = Infinity;\n+    for (const block of blocks) {\n+      const head = block[block.length - 1];\n+      const lineHeight = Math.max(head.bottom - head.top, 0.01);\n+      const overlap = Math.min(head.bottom, rg.bottom) - Math.max(head.top, rg.top);\n+      if (overlap <= lineHeight * 0.35) continue;\n+      const blockLeft = Math.min(...block.map(r => r.left));\n+      const blockRight = Math.max(...block.map(r => r.right));\n+      const gap = rg.left > blockRight ? rg.left - blockRight : (rg.right < blockLeft ? blockLeft - rg.right : 0);\n+      const rh = Math.max(rg.bottom - rg.top, 0.01);\n+      if (Math.max(lineHeight, rh) / Math.min(lineHeight, rh) > R.mergeHeightRatio) continue;\n+      const shortHead = (head.text.match(/[\\p{L}\\p{N}]/gu) || []).length <= 3;\n+      const shortRg = (rg.text.match(/[\\p{L}\\p{N}]/gu) || []).length <= 3;\n+      const limit = (shortHead && shortRg && overlap >= lineHeight * 0.7) ? lineHeight * 2.5 : lineHeight * R.bubbleGap;\n+      if (gap > limit) continue;\n+      if (gap < -lineHeight * 0.9) continue;\n+      if (gap < bestGap) { bestGap = gap; target = block; }\n+    }\n+    if (target) target.push(rg); else blocks.push([rg]);\n+  }\n+  const lines = blocks.map(block => {\n+    const ordered = block.slice().sort((a, b) => rtl ? b.left - a.left : a.left - b.left);\n+    // Склейка частей одной строки ровно как в KomaAutoRead:\n+    //   «ВЫСО-» + «ЧЕСТВО» → без пробела и без дефиса;\n+    //   обрывок в 1-2 буквы после буквы → тоже без пробела.\n+    let text = '';\n+    ordered.forEach((part, index) => {\n+      const t = String(part.text || '').trim();\n+      if (!t) return;\n+      if (index > 0 && text) {\n+        const prev = ordered[index - 1]?.text?.trim() || '';\n+        const last = text[text.length - 1];\n+        if (last === '-' || last === '\\u00AD') text = text.slice(0, -1);\n+        else if (joinBrokenWord(text, t)) text = text.replace(/[.\\-]$/, '');   // «БУДЕ.» + «ТЕ» → «БУДЕТЕ»\n+        else if (!(t.length <= 2 && /\\p{L}$/u.test(prev) && /^\\p{L}/u.test(t))) text += ' ';\n+      }\n+      text += t;\n+    });\n+    text = cleanSpeech(text);\n+    return {\n+      text,\n+      left: Math.min(...block.map(r => r.left)), top: Math.min(...block.map(r => r.top)),\n+      right: Math.max(...block.map(r => r.right)), bottom: Math.max(...block.map(r => r.bottom)),\n+    };\n+  });\n+  // Строки одного облачка — в ОДНУ реплику, обрывки — в соседнюю (как в АПК:\n+  // mergeBubbles + absorbOrphans).\n+  return orderBubbles(absorbOrphans(mergeBubbles(lines, bubbleGap, R.mergeHeightRatio)), rtl);\n+}\n+\n+/* Склейка переноса: дефис/тире — без пробела. */\n+function joinBubbleText(a, b) {\n+  const left = String(a || '').trim(), right = String(b || '').trim();\n+  if (!left) return right;\n+  if (!right) return left;\n+  const last = left[left.length - 1];\n+  if ('-\\u2010\\u2011\\u2013\\u2014\\u2015'.includes(last)) return left.slice(0, -1) + right;\n+  // «БУДЕ.» + «ТЕ ГОВОРИТЬ» → «БУДЕТЕ ГОВОРИТЬ»: перенос слова OCR читает\n+  // точкой вместо дефиса. Склеиваем, только если получается слово из словаря.\n+  if (joinBrokenWord(left, right)) return left.replace(/[.\\-]$/, '') + right;\n+  return left + ' ' + right;\n+}\n+/* Строки внутри одного облачка: перекрытие по ширине, центры рядом, зазор мал. */\n+function sameBubble(a, b, bubbleGap, mergeHeightRatio) {\n+  const aW = a.right - a.left, bW = b.right - b.left;\n+  const aH = a.bottom - a.top, bH = b.bottom - b.top;\n+  if (aW <= 0 || bW <= 0 || aH <= 0 || bH <= 0) return false;\n+  const overlap = Math.min(a.right, b.right) - Math.max(a.left, b.left);\n+  if (overlap <= 0) return false;\n+  if (overlap / Math.min(aW, bW) < 0.30) return false;\n+  const centerShift = Math.abs((a.left + a.right) / 2 - (b.left + b.right) / 2);\n+  if (centerShift > Math.max(aW, bW) * 0.8) return false;\n+  const gap = b.top - a.bottom;\n+  if (gap < -aH * 0.6 || gap > Math.max(aH, bH) * Math.max(1.2, bubbleGap)) return false;\n+  if (aH > aW * 3 || bH > bW * 3) return false;   // вертикальные колонки — не строки\n+  // Крупное название и мелкие титры — РАЗНЫЕ реплики: иначе рамка рисуется по\n+  // объединению двух шрифтов и не совпадает с тем, что читается.\n+  //\n+  // Сравниваем высоту СТРОКИ (lh), а не всего облачка: у склеенного из двух-трёх\n+  // строк облачка высота втрое больше одной строки, и проверка «по габаритам»\n+  // отказывалась приклеить третью строку — облачко рвалось на части\n+  // («УЖЕ ПОРА НАЧИНАТЬ ВСТРЕЧУ,» / «ТАК ЧТО ЕЁ ВЫСОЧЕСТВО, ДОЛЖНО» / «БЫТЬ, ПРИБЫЛА.»).\n+  const aLine = a.lh || aH, bLine = b.lh || bH;\n+  if (Math.max(aLine, bLine) / Math.min(aLine, bLine) > mergeHeightRatio) return false;\n+  return true;\n+}\n+function mergeBubbles(lines, bubbleGap, mergeHeightRatio) {\n+  if (lines.length <= 1) return lines;\n+  const sorted = lines.slice().sort((a, b) => a.top - b.top || a.left - b.left);\n+  const result = [];\n+  for (const line of sorted) {\n+    let bestIndex = -1, bestGap = Infinity;\n+    for (let i = 0; i < result.length; i++) {\n+      if (!sameBubble(result[i], line, bubbleGap, mergeHeightRatio)) continue;\n+      const gap = line.top - result[i].bottom;\n+      if (gap < bestGap) { bestGap = gap; bestIndex = i; }\n+    }\n+    if (bestIndex >= 0) {\n+      const b = result[bestIndex];\n+      const lineH = line.bottom - line.top;\n+      result[bestIndex] = {\n+        text: joinBubbleText(b.text, line.text),\n+        left: Math.min(b.left, line.left), top: Math.min(b.top, line.top),\n+        right: Math.max(b.right, line.right), bottom: Math.max(b.bottom, line.bottom),\n+        // Типичная высота строки внутри облачка — по ней и решается, можно ли\n+        // приклеить следующую строку.\n+        lh: Math.min(b.lh || (b.bottom - b.top), lineH),\n+      };\n+    } else result.push({ ...line, lh: line.bottom - line.top });\n+  }\n+  return result;\n+}\n+/* Обрывок в 1-3 буквы внутри чужой рамки — часть её слова. */\n+function absorbOrphans(bubbles) {\n+  if (bubbles.length <= 1) return bubbles;\n+  const alive = bubbles.slice();\n+  for (let pass = 0; pass < 4; pass++) {\n+    let merged = false;\n+    for (const orphan of alive.slice()) {\n+      if ((orphan.text.match(/[\\p{L}\\p{N}]/gu) || []).length > 3) continue;\n+      const cx = (orphan.left + orphan.right) / 2, cy = (orphan.top + orphan.bottom) / 2;\n+      let targetIndex = -1, bestDistance = Infinity;\n+      for (let i = 0; i < alive.length; i++) {\n+        const b = alive[i];\n+        if (b === orphan) continue;\n+        const padX = (b.right - b.left) * 0.12, padY = (b.bottom - b.top) * 0.35;\n+        if (cx < b.left - padX || cx > b.right + padX) continue;\n+        if (cy < b.top - padY || cy > b.bottom + padY) continue;\n+        const d = Math.abs(cy - (b.top + b.bottom) / 2);\n+        if (d < bestDistance) { bestDistance = d; targetIndex = i; }\n+      }\n+      if (targetIndex < 0) continue;\n+      const b = alive[targetIndex];\n+      {   // разная высота — разные реплики, обрывок не втягиваем\n+        const oh = orphan.bottom - orphan.top, bh = b.bottom - b.top;\n+        if (oh > 0 && bh > 0 && Math.max(oh, bh) / Math.min(oh, bh) > 2.5) continue;\n+      }\n+      const above = cy < (b.top + b.bottom) / 2;\n+      alive[targetIndex] = {\n+        text: above ? joinBubbleText(orphan.text, b.text) : joinBubbleText(b.text, orphan.text),\n+        left: Math.min(b.left, orphan.left), top: Math.min(b.top, orphan.top),\n+        right: Math.max(b.right, orphan.right), bottom: Math.max(b.bottom, orphan.bottom),\n+      };\n+      const idx = alive.indexOf(orphan);\n+      if (idx >= 0) alive.splice(idx, 1);\n+      merged = true;\n+      break;\n+    }\n+    if (!merged) break;\n+  }\n+  return alive;\n+}\n+/* Полосы сверху вниз, внутри полосы — по направлению чтения. */\n+function orderBubbles(bubbles, rtl) {\n+  if (bubbles.length <= 1) return bubbles;\n+  const heights = bubbles.map(b => b.bottom - b.top).sort((a, b) => a - b);\n+  const median = heights[heights.length >> 1];\n+  const tolerance = Math.max(0.02, median * 0.8);\n+  const bands = [];\n+  let bandTop = 0;\n+  for (const b of bubbles.slice().sort((x, y) => x.top - y.top)) {\n+    if (bands.length && b.top - bandTop <= tolerance) bands[bands.length - 1].push(b);\n+    else { bands.push([b]); bandTop = b.top; }\n+  }\n+  // rtl: правые реплики первыми (по убыванию left), ltr: по возрастанию.\n+  return bands.flatMap(band => band.sort((x, y) => rtl ? y.left - x.left : x.left - y.left));\n+}\n+/* панели: горизонтальные «желоба» между кадрами (упрощённый KomaPanels) */\n+/**\n+ * XY-cut как в KomaAutoRead.splitPanels: горизонтальная пустая полоса делит\n+ * страницу на верх/низ, вертикальная — на панели, стоящие рядом. Внутри панели\n+ * разрез повторяется.\n+ *\n+ * Раньше здесь была упрощённая версия («зазор больше 1.2 высоты строки»), и она\n+ * резала ОБЛАЧКО по строкам: «УЖЕ ПОРА НАЧИНАТЬ ВСТРЕЧУ,» / «ТАК ЧТО ЕЁ\n+ * ВЫСОЧЕСТВО, ДОЛЖНО» / «БЫТЬ, ПРИБЫЛА.» становились тремя репликами.\n+ */\n+const Y_CUT = 0.022, X_CUT = 0.035;\n+\n+function mergeByAxis(group, byY, cut) {\n+  const sorted = group.slice().sort((a, b) => (byY ? a.top - b.top : a.left - b.left));\n+  const bands = [];\n+  for (const rg of sorted) {\n+    const start = byY ? rg.top : rg.left;\n+    const end = byY ? rg.bottom : rg.right;\n+    const last = bands[bands.length - 1];\n+    if (last && start - last.end <= cut) {\n+      last.end = Math.max(last.end, end);\n+      last.items.push(rg);\n+    } else {\n+      bands.push({ start, end, items: [rg] });\n+    }\n+  }\n+  return bands.length <= 1 ? [group] : bands.map(b => b.items);\n+}\n+\n+function splitPanels(group, rtl = true, depth = 0) {\n+  if (group.length <= 1 || depth > 12) return [group];\n+  const heights = group.map(r => r.bottom - r.top).sort((a, b) => a - b);\n+  const lineHeight = Math.max(0.008, heights[heights.length >> 1]);\n+  // Порог — от реальной высоты строки на ЭТОЙ странице, а не от накопленной.\n+  const yCut = Math.max(Y_CUT, lineHeight * 0.9);\n+  const xCut = Math.max(X_CUT, lineHeight * 0.9);\n+  const rows = mergeByAxis(group, true, yCut);\n+  if (rows.length > 1) return rows.flatMap(r => splitPanels(r, rtl, depth + 1));\n+  const columns = mergeByAxis(group, false, xCut);\n+  if (columns.length > 1) {\n+    const ordered = rtl ? columns.slice().reverse() : columns;\n+    return ordered.flatMap(c => splitPanels(c, rtl, depth + 1));\n+  }\n+  return [group];\n+}\n+function readingOrder(regions, rtl, onlyCyr, R) {\n+  // Порядок как в KomaAutoRead: сначала нормализация и починка двойников,\n+  // ПОТОМ фильтр языка. Иначе фрагмент с латинскими буквами («He6лuцa»)\n+  // отбрасывался целиком, и слово пропадало из озвучки.\n+  let source = regions\n+    .map(r => {\n+      let text = String(r.text || '').replace(/\\u00AD/g, '-').replace(/\\s+/g, ' ').trim();\n+      text = applyWordFixes(text, R.wordFixes);\n+      const fixed = fixLookalikes(text);\n+      if (onlyCyr && !isCyr(fixed) && isLookalikeOnly(fixed)) text = fixLookalikesForced(fixed);\n+      else text = fixed;\n+      return { ...r, text };\n+    })\n+    .filter(r => /[\\p{L}\\p{N}]/u.test(r.text))\n+    .filter(r => !onlyCyr || isCyr(r.text));\n+  if (!source.length) return [];\n+  const lines = splitPanels(source, rtl, 0).flatMap(p => bubblesOf(p, rtl, R));\n+  // Языковая починка — на СОБРАННОЙ реплике (как KomaWords.finish): словарь\n+  // исправляет «ПОШЕВЕАИТЬСЯ» → «ПОШЕВЕЛИТЬСЯ» и выбрасывает строки, которых\n+  // в русском нет вовсе.\n+  const result = lines\n+    .map(l => ({ ...l, text: Words.polish(l.text, R.junkRatio, l.confidence) }))\n+    .filter(l => l.text && (l.text.match(/\\p{L}/gu) || []).length >= 2);\n+  rescueLostLines(result, source, R);\n+  markLargeText(result, source);\n+  return result;\n+}\n+\n+/**\n+ * Бо́льшая часть слов фрагмента уже есть в собранных репликах? Тогда это не\n+ * потеря, а вариант той же строки, и приклеивать его нельзя.\n+ */\n+function mostlyCovered(key, covered) {\n+  // Перенос слова («РАВНО-» + «ДУШНЫМ»): фрагмент целиком входит в слово\n+  // реплики — приклеивать нельзя, иначе получается «РАВНОДУШНЫМ. ДУШНЫМ.»\n+  const flat = key.replace(/ /g, '');\n+  if (flat.length >= 3 && covered.some(c => c.replace(/ /g, '').includes(flat))) return true;\n+  const words = key.split(' ').filter(w => w.length >= 3);\n+  if (!words.length) return covered.some(c => c.includes(key));\n+  const pool = new Set(covered.join(' ').split(' '));\n+  const hit = words.filter(w => pool.has(w)).length;\n+  return hit / words.length >= 0.5;\n+}\n+\n+/** Нормализация для сравнения: регистр и пунктуация не важны. */\n+function normText(s) {\n+  return String(s || '').toLowerCase().replace(/[^\\p{L}\\p{N}]+/gu, ' ').trim();\n+}\n+\n+/**\n+ * Страховка от потери строк при склейке: на скриншоте 23:20 из реплики\n+ * «Как прожить жизнь, будучи старшей сестрой тирана.» пропал конец — строка\n+ * распозналась («Сесмой тирана»), прошла чистку, но не попала ни в одну\n+ * реплику. Правило «реплику не резать» важнее аккуратности склейки: любой\n+ * осмысленный регион, которого нет в готовых репликах, приклеиваем к\n+ * ближайшей по вертикали (и только если он рядом, не дальше 18 % страницы).\n+ */\n+function rescueLostLines(result, source, R) {\n+  if (!result.length) return;\n+  const covered = result.map(l => normText(l.text));\n+  for (const r of source) {\n+    const t = String(Words.polish(r.text, R.junkRatio, r.confidence) || '').trim();\n+    if (!t) continue;\n+    const key = normText(t);\n+    if (key.length < 3) continue;\n+    // Уже внутри реплики? Сравниваем ПО СЛОВАМ, а не по префиксу: OCR на\n+    // одной и той же строке даёт варианты («ТАК ЧТО ЕЁ ВАСО ЧИТАТЬ ВСТРЕЧУ»),\n+    // и по префиксу страховка приклеивала уже собранное — получались дубли\n+    // («УЖЕ ПОРА НАЧИНАТЬ ВСТРЕЧУ…» дважды).\n+    if (mostlyCovered(key, covered)) continue;\n+    const rc = (r.top + r.bottom) / 2;\n+    let best = -1, bestD = Infinity;\n+    result.forEach((l, idx) => {\n+      const d = rc < l.top ? l.top - rc : (rc > l.bottom ? rc - l.bottom : 0);\n+      if (d < bestD) { bestD = d; best = idx; }\n+    });\n+    if (best < 0 || bestD > 0.18) continue;\n+    const l = result[best];\n+    const above = rc < (l.top + l.bottom) / 2;\n+    result[best] = {\n+      ...l,\n+      text: above ? (t + ' ' + l.text) : (l.text + ' ' + t),\n+      left: Math.min(l.left, r.left), top: Math.min(l.top, r.top),\n+      right: Math.max(l.right, r.right), bottom: Math.max(l.bottom, r.bottom),\n+      rescued: true,\n+    };\n+    covered.push(normText(result[best].text));\n+  }\n+}\n+\n+/**\n+ * Крупный текст (титул, каллиграфия) помечаем: он показывается другим цветом,\n+ * чтобы не путать его с репликами. Отличие по кеглю: высота строки заметно\n+ * больше типичной для страницы.\n+ */\n+function markLargeText(result, source) {\n+  if (source.length < 3 || !result.length) return;\n+  const heights = source.map(r => r.bottom - r.top).sort((a, b) => a - b);\n+  const medH = heights[heights.length >> 1];\n+  if (!medH) return;\n+  for (const l of result) {\n+    const inside = source.filter(r => {\n+      const cy = (r.top + r.bottom) / 2;\n+      return cy >= l.top && cy <= l.bottom;\n+    });\n+    if (!inside.length) continue;\n+    const hs = inside.map(r => r.bottom - r.top).sort((a, b) => a - b);\n+    const h = hs[hs.length >> 1];\n+    if (h > medH * 1.5) l.large = true;\n+  }\n+}\n+\n+/* ───────────────────────── 7. Полосы экрана (KomaBands) ───────────────────────── */\n+function bandsOf(viewportFraction, R) {\n+  const whole = R.wholeThreshold, overlap = R.bandOverlap, max = Math.round(R.bandsMax);\n+  if (!viewportFraction || viewportFraction <= 0 || viewportFraction >= whole) {\n+    return [{ index: 0, top: 0, bottom: 1, whole: true }];\n+  }\n+  const visible = clamp(viewportFraction, 0.12, whole);\n+  const bands = [];\n+  let top = 0, idx = 0;\n+  while (idx < max) {\n+    const bottom = Math.min(1, top + visible);\n+    bands.push({ index: idx, top, bottom, whole: false });\n+    if (bottom >= 0.999) break;\n+    top = Math.max(0.0001, bottom - visible * overlap);\n+    idx++;\n+  }\n+  const last = bands[bands.length - 1];\n+  if (last && last.bottom < 0.999) last.bottom = 1;\n+  return bands;\n+}\n+function cutAtBandBottom(line, band, cutMargin) {\n+  if (band.whole) return false;\n+  if (band.bottom <= line.bottom - 0.001) return false;\n+  if (line.bottom < band.bottom - cutMargin) return false;\n+  const t = line.text.trimEnd();\n+  if (!t) return false;\n+  return !/[.!?…\"»)]$/.test(t);\n+}\n", "additions": 1728, "deletions": 0, "status": "added"}, {"file": "part4.js", "patch": "Index: part4.js\n===================================================================\n--- part4.js\t\n+++ part4.js\t\n@@ -0,0 +1,1029 @@\n+\n+/* ───────────────────────── 8. Читалка ───────────────────────── */\n+const Reader = {\n+  book: null, pages: [], urls: [], canvases: [], imgEls: [],\n+  mode: 'vertical', dir: 'rtl', page: 0, frames: false, follow: true,\n+  regions: new Map(),          // page → {regions, boxes, ms}\n+  bandCache: new Map(),        // page → Map(ключ полосы → распознанное)\n+                               // (поле bands занято массивом полос из bandsOf)\n+  spoken: new Set(),\n+  current: null,\n+  scrollBusy: false,\n+\n+  async open(book) {\n+    this.book = book;\n+    this.pages = await Library.pages(book.id);\n+    if (!this.pages.length) return toast('В книге нет страниц');\n+    this.mode = book.mode || 'vertical';\n+    this.dir = book.dir || 'rtl';\n+    this.page = clamp(book.progress || 0, 0, this.pages.length - 1);\n+    this.regions.clear(); this.spoken.clear();\n+    // Уже распознанные страницы берём из буфера: повторное открытие книги и\n+    // повторное чтение не должны снова стоить 10 секунд на страницу.\n+    let cleaned = 0;\n+    try {\n+      const buf = await Buffer.all();\n+      for (const row of buf) {\n+        if (row && Array.isArray(row.lines) && row.lines.length) {\n+          // Текст в буфере распознан прежней версией — прогоняем его через\n+          // нынешние правила чистки, иначе старый мусор («Тг. чв») живёт вечно.\n+          const lines = await cleanLines(row.lines);\n+          this.regions.set(row.page, { lines, regions: null, cached: true, ms: 0, detMs: 0, recMs: 0, crops: lines.length, boxes: 0 });\n+          if (lines.length !== row.lines.length) {\n+            await Buffer.put(row.page, lines);\n+            cleaned++;\n+          }\n+        }\n+      }\n+      if (buf.length) toast('Из буфера: ' + buf.length + ' стр. уже распознаны', 3000);\n+    } catch (e) { console.warn('буфер не прочитался', e); }\n+    $('#rTitle').textContent = book.title;\n+    $('#pageTotal').textContent = String(this.pages.length);\n+    show('reader');\n+    this.syncSub();\n+    await this.buildStrip();\n+    this.scrollToPage(this.page, false);\n+  },\n+\n+  syncSub() {\n+    const modeText = (this.mode === 'vertical' ? 'Вертикально' : this.mode === 'rtl' ? 'Страницы' : 'Страницы')\n+      + ' · ' + (this.dir === 'rtl' ? '← справа налево' : 'слева направо →');\n+    $('#rSub').textContent = `KOMA · веб · ${this.page + 1} из ${this.pages.length} · ${modeText}`;\n+    $('#pageNum').textContent = String(this.page + 1);\n+  },\n+\n+  async buildStrip() {\n+    const strip = $('#strip');\n+    if (this.ratios && Object.keys(this.ratios).length) {\n+      const vals = Object.values(this.ratios);\n+      this.bookRatio = vals.reduce((a, b) => a + b, 0) / vals.length;\n+    }\n+    strip.innerHTML = '';\n+    this.urls.forEach(u => URL.revokeObjectURL(u));\n+    this.urls = []; this.imgEls = []; this.canvases = [];\n+    strip.style.display = this.mode === 'vertical' ? 'block' : 'none';\n+    $('#paged').classList.toggle('on', this.mode !== 'vertical');\n+    if (this.mode === 'vertical') {\n+      for (let i = 0; i < this.pages.length; i++) {\n+        const wrap = document.createElement('div');\n+        wrap.className = 'pagewrap'; wrap.dataset.page = i;\n+        // Место под страницу резервируется сразу: пропорция известна из буфера\n+        // (если страницу уже открывали) или берётся средняя по книге.\n+        wrap.style.aspectRatio = String((this.ratios && this.ratios[i]) || this.bookRatio || 0.7);\n+        const img = document.createElement('img');\n+        img.alt = 'Страница ' + (i + 1);\n+        img.decoding = 'async';\n+        img.onload = () => { this.onPageSized(i); };\n+        wrap.appendChild(img);\n+        const frames = document.createElement('div');\n+        frames.className = 'frames'; frames.dataset.frames = i;\n+        wrap.appendChild(frames);\n+        strip.appendChild(wrap);\n+        this.imgEls[i] = img;\n+        this.paintPage(i);\n+      }\n+    } else {\n+      const paged = $('#paged');\n+      paged.innerHTML = '';\n+      for (let i = 0; i < this.pages.length; i++) {\n+        const box = document.createElement('div');\n+        box.className = 'pagebox'; box.dataset.page = i;\n+        box.innerHTML = '<div class=\"inner\"><img alt=\"Страница ' + (i + 1) + '\"></div>';\n+        paged.appendChild(box);\n+        this.imgEls[i] = box.querySelector('img');\n+        this.imgEls[i].onload = () => this.onPageSized(i);\n+      }\n+    }\n+    // грузим страницы лениво: сначала текущую и соседние\n+    for (const i of this.loadOrder()) this.ensureLoaded(i);\n+  },\n+\n+  loadOrder() {\n+    const out = [];\n+    for (let d = 0; d <= this.pages.length; d++) {\n+      for (const i of [this.page - d, this.page + d]) {\n+        if (i >= 0 && i < this.pages.length && !out.includes(i)) out.push(i);\n+      }\n+      if (out.length > 6) break;\n+    }\n+    return out;\n+  },\n+\n+  async ensureLoaded(i) {\n+    const img = this.imgEls[i];\n+    if (!img || img.dataset.src) return;\n+    img.dataset.src = '1';\n+    const row = this.pages[i];\n+    const blob = (await DB.get('pages', row.key))?.blob;\n+    if (!blob) return;\n+    const url = URL.createObjectURL(blob);\n+    this.urls[i] = url;\n+    img.src = url;\n+  },\n+\n+  async onPageSized(i) {\n+    const img = this.imgEls[i];\n+    if (!img || !img.naturalWidth) return;\n+    // Запоминаем пропорции: без этого незагруженные страницы схлопывались в 0\n+    // по высоте, лента прыгала, и «текущая страница» определялась неверно.\n+    const ratio = img.naturalWidth / img.naturalHeight;\n+    this.ratios = this.ratios || {};\n+    if (!this.ratios[i]) {\n+      this.ratios[i] = ratio;\n+      const wrap = document.querySelector(`.pagewrap[data-page=\"${i}\"]`);\n+      if (wrap) wrap.style.aspectRatio = String(ratio);\n+    }\n+    if (!this.canvases[i]) {\n+      // рабочий холст для OCR — один раз на страницу\n+      this.canvases[i] = canvasFromImage(img);\n+    }\n+    this.paintPage(i);\n+    if (i === this.page) this.afterPageReady();\n+  },\n+\n+  paintPage(i) {\n+    const framesEl = this.mode === 'vertical'\n+      ? document.querySelector(`[data-frames=\"${i}\"]`)\n+      : null;\n+    if (!framesEl) return;\n+    framesEl.innerHTML = '';\n+    if (!this.frames) return;\n+    const data = this.regions.get(i);\n+    if (!data) return;\n+    for (const line of data.lines) {\n+      const d = document.createElement('div');\n+      d.className = 'frame';\n+      d.style.left = (line.left * 100) + '%';\n+      d.style.top = (line.top * 100) + '%';\n+      d.style.width = ((line.right - line.left) * 100) + '%';\n+      d.style.height = ((line.bottom - line.top) * 100) + '%';\n+      const isCur = this.current && this.current.text === line.text;\n+      const isDone = this.spoken.has(line.text);\n+      if (line.large) d.classList.add('large');     // титул/каллиграфия — другой цвет\n+      if (isCur) d.classList.add('cur');\n+      else if (isDone) d.classList.add('done');\n+      d.onclick = () => TTS.speakLine(line);\n+      framesEl.appendChild(d);\n+    }\n+  },\n+\n+  paintAllFrames() {\n+    for (let i = 0; i < this.pages.length; i++) this.paintPage(i);\n+  },\n+\n+  afterPageReady() {\n+    const i = this.page;\n+    const c = this.canvases[i];\n+    if (!c) return;\n+    // Видимая доля страницы: полосы (как KomaBands в АПК)\n+    const rect = this.pageRect(i);\n+    const vp = window.innerHeight - 0;\n+    const frac = rect && rect.height > 0 ? clamp(vp / rect.height, 0.12, 1) : 1;\n+    this.bands = bandsOf(frac, RULES);\n+    this.band = this.bands[clamp(this.bandIndex || 0, 0, this.bands.length - 1)];\n+    this.syncSub();\n+    if (RULES.semiManual && State.semi) return;         // ждём остановки и прокрутки\n+    // Буфер прошлой версии хранит страницу, распознанную ЦЕЛИКОМ. Для длинной\n+    // страницы это лишние реплики за пределами экрана — такую пересчитываем\n+    // видимой полосой один раз (полоса запомнится в bandCache).\n+    const data = this.regions.get(i);\n+    const staleFull = data && data.cached && this.visibleBandPx(i);\n+    if (!this.scrollBusy && (!data || staleFull)) this.scanCurrent(false);\n+  },\n+\n+  /**\n+   * Какая страница РЕАЛЬНО на экране — по геометрии, а не по сохранённому\n+   * индексу. Раньше считалось только внутри обработчика scroll и только когда\n+   * у страницы уже был загружен образ; при ленивой загрузке (высота 0 до\n+   * загрузки) и после автолистания индекс «застревал»: на экране первая\n+   * страница, а шапка и распознавание — четвёртая.\n+   */\n+  /**\n+   * Видимая сейчас полоса страницы — в пикселях её кадра.\n+   *\n+   * Возвращает null, если страница целиком помещается на экран (обычная\n+   * страница манги) — тогда распознаём всю. Для длинного вебтуна полоса\n+   * ограничена экраном плюс небольшим запасом, иначе в реплики попадает текст\n+   * на два экрана вперёд («нашёл 5 реплик, хотя видно одну»).\n+   */\n+  visibleBandPx(i) {\n+    try { return this.visibleBandPxInner(i); } catch (e) { return null; }\n+  },\n+  visibleBandPxInner(i) {\n+    const c = this.canvases[i];\n+    const wrap = document.querySelector(`.pagewrap[data-page=\"${i}\"]`);\n+    const scroller = $('#strip');\n+    if (!c || !wrap || !scroller || this.mode !== 'vertical') return null;\n+    const r = wrap.getBoundingClientRect();\n+    const sr = scroller.getBoundingClientRect();\n+    if (!r.height || !c.height) return null;\n+    const scale = c.height / r.height;                 // пиксели кадра на экранный px\n+    const viewH = scroller.clientHeight || window.innerHeight;\n+    const overlap = clamp(Number(RULES.bandOverlap) || 0.15, 0, 0.6);\n+    // Запас считаем от экрана, а не от страницы: у вебтуна в 20 000 px\n+    // «15 % страницы» — это три лишних экрана. И запас этот нужен ТОЛЬКО\n+    // детектору (чтобы облачко на границе попало целиком) — в реплики идут\n+    // строки, реально видимые на экране (vy0…vy1, без запаса).\n+    const pad = Math.min(r.height * overlap, viewH * 0.25);\n+    // Экран в координатах страницы\n+    const topPx = (Math.max(sr.top, r.top) - r.top) + 0;      // видимое начало\n+    const botPx = (Math.min(sr.top + viewH, r.bottom) - r.top);\n+    const y0 = clamp((topPx - pad) * scale, 0, c.height);\n+    const y1 = clamp((botPx + pad) * scale, 0, c.height);\n+    if (y1 - y0 < 32) return null;\n+    // Если видно (почти) всю страницу — полоса не нужна\n+    if (y1 - y0 >= c.height * 0.92) return null;\n+    // Короткая страница (до 2,2 экрана) читается ЦЕЛИКОМ — как оригинальный\n+    // KOMA: на скриншоте 11:24 оригинал нашёл 18 областей и 5 реплик на всю\n+    // страницу, включая «В БУДУЩЕМ, КОГДА ВЫ БУДЕТЕ…» за нижним краем экрана.\n+    // Полоса нужна только вебтуну в десятки тысяч пикселей.\n+    if (c.height <= viewH * 2.2) return null;\n+    const vy0 = clamp(topPx * scale, 0, c.height);\n+    const vy1 = clamp(botPx * scale, 0, c.height);\n+    return {\n+      y0, y1, vy0, vy1,\n+      key: Math.round(vy0 / 96) + ':' + Math.round(vy1 / 96),\n+    };\n+  },\n+\n+  pageAtViewport() {\n+    const scroller = $('#strip');\n+    if (!scroller || this.mode !== 'vertical') return this.page;\n+    const vh = scroller.clientHeight || window.innerHeight;\n+    const mid = vh * 0.45;                     // чуть выше центра — реплики сверху\n+    let best = -1, bestArea = -1, bestDist = Infinity, bestNear = -1;\n+    for (let i = 0; i < this.pages.length; i++) {\n+      const wrap = document.querySelector(`.pagewrap[data-page=\"${i}\"]`);\n+      if (!wrap) continue;\n+      const r = wrap.getBoundingClientRect();\n+      const sr = scroller.getBoundingClientRect();\n+      const top = r.top - sr.top, bottom = r.bottom - sr.top;\n+      const visible = Math.min(bottom, vh) - Math.max(top, 0);\n+      if (visible > bestArea) { bestArea = visible; best = i; }\n+      const d = Math.abs(top - mid);\n+      if (d < bestDist) { bestDist = d; bestNear = i; }\n+    }\n+    // Если середина экрана попала в пустоту (страница не загружена и места нет),\n+    // берём ту, что занимает больше всего экрана.\n+    return best >= 0 ? best : Math.max(0, bestNear);\n+  },\n+\n+  /** Сверить сохранённый индекс с экраном и обновить шапку/подгрузку. */\n+  syncPage() {\n+    if (!this.pages || !this.pages.length) return this.page;\n+    const actual = this.pageAtViewport();\n+    if (actual !== this.page) {\n+      this.page = actual;\n+      this.ensureLoaded(actual);\n+      this.ensureLoaded(actual + 1);\n+      this.saveProgress();\n+      this.syncSub();\n+      return actual;\n+    }\n+    this.syncSub();\n+    return this.page;\n+  },\n+\n+  pageRect(i) {\n+    const img = this.imgEls[i];\n+    if (!img) return null;\n+    return img.getBoundingClientRect();\n+  },\n+\n+  scrollToPage(i, animate = true) {\n+    const wrap = document.querySelector(`.pagewrap[data-page=\"${i}\"]`) || document.querySelector(`.pagebox[data-page=\"${i}\"]`);\n+    if (!wrap) return;\n+    wrap.scrollIntoView({ block: 'start', behavior: animate ? 'smooth' : 'auto' });\n+    this.page = i;\n+    this.syncSub();\n+    this.ensureLoaded(i);\n+    this.ensureLoaded(i + 1);\n+    this.saveProgress();\n+  },\n+\n+  saveProgress() {\n+    if (!this.book) return;\n+    this.book.progress = this.page;\n+    this.book.mode = this.mode;\n+    DB.put('books', this.book);\n+  },\n+\n+  /** Сохранить в буфер все реплики страницы (собранные из полос). */\n+  async savePageBuffer(i) {\n+    const data = this.regions.get(i);\n+    if (data && data.lines) await Buffer.put(i, data.lines);\n+  },\n+  /** Смена направления чтения: пересортировать уже распознанное, без OCR. */\n+  rescanInDir() {\n+    const rtl = (this.dir || 'rtl') === 'rtl';\n+    let n = 0;\n+    for (const [i, data] of this.regions) {\n+      if (!data || !data.regions) continue;       // из буфера — регионов нет\n+      data.lines = readingOrder(data.regions, rtl, true, RULES);\n+      Buffer.put(i, data.lines);\n+      n++;\n+    }\n+    this.paintAllFrames();\n+    toast(n ? 'Порядок пересчитан: ' + (rtl ? 'справа налево' : 'слева направо') : 'Откройте страницу заново, чтобы применить направление', 4000);\n+  },\n+\n+  /**\n+   * Распознать КОНКРЕТНУЮ страницу.\n+   *\n+   * Раньше единственная точка входа (`scanCurrent`) брала «текущую» страницу в\n+   * момент вызова. Из-за этого «Распознать заново» из шторки «Текст страницы N»\n+   * сканировало ту страницу, на которой лента оказалась к тому моменту, а не ту,\n+   * чей текст открыт: реплики не перезаписывались вообще.\n+   */\n+  async scanPage(i, opts = {}) {\n+    const force = !!opts.force;\n+    const keepSheet = !!opts.keepSheet;\n+    if (i == null || i < 0 || i >= this.pages.length) return null;\n+\n+    // Полоса, которую сейчас видно: ключ нужен, чтобы при прокрутке\n+    // распознавать новые куски, а уже распознанные не гонять заново.\n+    const band = opts.full ? null : this.visibleBandPx(i);\n+    const bandKey = band ? band.key : 'page';\n+    if (!(this.bandCache instanceof Map)) this.bandCache = new Map();\n+    const bandMap = this.bandCache.get(i) || new Map();\n+\n+    // Кэш годится, если: (а) полоса уже распознана; (б) страницу распознали\n+    // целиком; (в) данные пришли из буфера прошлой сессии — тогда считаем их\n+    // полной страницей, иначе старые книги распознавались бы заново.\n+    const cached = this.regions.get(i);\n+    const hasBands = this.bandCache.has(i);\n+    const fresh = cached && (band ? (hasBands && bandMap.has(bandKey)) : !hasBands);\n+    if (cached && fresh && !force) { this.paintPage(i); return cached; }\n+\n+    if (State.scanning) {\n+      // Молча выходить нельзя: нажатие «Распознать заново» выглядело как\n+      // «кнопка не работает». Ставим в очередь и говорим об этом.\n+      State.pendingScan = { i, force, keepSheet, full: !!opts.full };\n+      const msg = 'Идёт распознавание — страница ' + (i + 1) + ' встала в очередь';\n+      toast(msg, 4000);\n+      if (keepSheet) $('#textStats').textContent = msg + '…';\n+      return null;\n+    }\n+\n+    const c = this.canvases[i];\n+    if (!c) { toast('Страница ' + (i + 1) + ' ещё не загрузилась'); return null; }\n+    if (!OCR.ready) { openSheet('sheetModels'); toast('Сначала добавьте модели OCR (⚙)'); return null; }\n+\n+    State.scanning = true;\n+    $('#scanBadge').classList.add('on');\n+    $('#scanBadge').textContent = `Распознаём… стр. ${i + 1}`;\n+    if (keepSheet) $('#textStats').textContent = `Распознаю страницу ${i + 1} заново…`;\n+    try {\n+      const label = band ? `полосу ${i + 1}` : `страницу ${i + 1}`;\n+      const res = await recognizePage(c, RULES, (done, total) => {\n+        const t = `Распознаём… ${done}/${total}`;\n+        $('#scanBadge').textContent = t;\n+        if (keepSheet) $('#textStats').textContent = `Распознаю ${label} заново… ${done}/${total}`;\n+      }, band);\n+      // Направление чтения — отдельная настройка (dir), а не раскладка.\n+      const rtl = (this.dir || 'rtl') === 'rtl';\n+      const fresh = readingOrder(res.regions, rtl, true, RULES);\n+      const at = new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', second: '2-digit' });\n+\n+      // Собираем полосы страницы: новая заменяет старую с тем же ключом,\n+      // остальные остаются. Их реплики идут сверху вниз.\n+      bandMap.set(bandKey, { lines: fresh, res, at });\n+      const detPass = res.detPass || 'normal';\n+      const largePasses = res.largePasses || 0;\n+      this.bandCache.set(i, bandMap);\n+      const parts = Array.from(bandMap.entries())\n+        .sort((a, b) => (a[1].res.band?.y0 ?? 0) - (b[1].res.band?.y0 ?? 0));\n+      const lines = mergeBandLines(parts.map(([, part]) => part), c);\n+      const total = parts.reduce((acc, [, p]) => acc + (p.res.ms || 0), 0);\n+      this.regions.set(i, {\n+        ...res, lines, at, bands: parts.length,\n+        detPass, largePasses,\n+        ms: total, detMs: res.detMs, recMs: res.recMs, crops: res.crops,\n+        boxes: res.boxes, regions: res.regions,\n+        bandKeys: parts.length,\n+      });\n+      await this.savePageBuffer(i);\n+      this.paintPage(i);\n+      toast(`${band ? 'Полоса' : 'Страница'} ${i + 1} ${force ? 'обновлена' : 'распознана'}: ${fresh.length} реплик на полосе`\n+        + (parts.length > 1 ? `, всего ${lines.length} на странице` : '')\n+        + ` · ${(res.ms / 1000).toFixed(1)} с (детектор ${(res.detMs / 1000).toFixed(1)} с, `\n+        + `распознавание ${(res.recMs / 1000).toFixed(1)} с, ${res.crops} строк)`, 6000);\n+      // Шторка остаётся открытой — и обязательно перерисовывается.\n+      if ($('#sheetText').classList.contains('on')) renderTextSheet(i);\n+      return this.regions.get(i);\n+    } catch (e) {\n+      console.error(e);\n+      const ln = String((e && e.stack) || '').split('\\n')[1] || '';\n+      const where = ln.trim().replace(/\\s*\\(?.*\\//, '(').replace(/^at /, '');\n+      const msg = 'Ошибка распознавания: ' + (e.message || e) + (where ? ' · ' + where : '');\n+      toast(msg, 8000);\n+      if (keepSheet) $('#textStats').textContent = msg;\n+      return null;\n+    } finally {\n+      State.scanning = false;\n+      $('#scanBadge').classList.remove('on');\n+      const p = State.pendingScan;\n+      State.pendingScan = null;\n+      if (p) setTimeout(() => this.scanPage(p.i, { force: p.force, keepSheet: p.keepSheet }), 50);\n+    }\n+  },\n+\n+  /** Совместимость: распознать текущую страницу. */\n+  async scanCurrent(force = false) {\n+    return this.scanPage(this.page, { force });\n+  },\n+\n+  /* Реплики текущей полосы — то, что читается */\n+  visibleLines() {\n+    const data = this.regions.get(this.page);\n+    if (!data) return [];\n+    if (!this.band || this.band.whole) return data.lines;\n+    const b = this.band;\n+    return data.lines.filter(l => l.bottom > b.top && l.top < b.bottom);\n+  },\n+};\n+\n+/* ───────────────────────── 9. Буфер строк ───────────────────────── */\n+const Buffer = {\n+  async put(page, lines) {\n+    const key = 'buf:' + Reader.book.id + ':' + page;\n+    await DB.put('kv', { k: key, v: { page, at: Date.now(), rules: RULES.version, lines } });\n+  },\n+  async get(page) {\n+    return (await DB.get('kv', 'buf:' + Reader.book.id + ':' + page))?.v || null;\n+  },\n+  async all() {\n+    const rows = (await DB.all('kv') || []).filter(r => r.k.startsWith('buf:' + (Reader.book?.id || '')));\n+    return rows.map(r => r.v).sort((a, b) => a.page - b.page);\n+  },\n+  async clear() {\n+    const rows = (await DB.all('kv') || []).filter(r => r.k.startsWith('buf:' + (Reader.book?.id || '')));\n+    for (const r of rows) await DB.del('kv', r.k);\n+  },\n+};\n+\n+/* ───────────────────────── 10. Озвучка ───────────────────────── */\n+const TTS = {\n+  voices: [], voice: null, rate: 1, speaking: false, stopped: true, queue: [], idx: 0, primed: false,\n+  init() {\n+    const fill = () => {\n+      this.voices = speechSynthesis.getVoices().filter(v => /ru/i.test(v.lang)).concat(\n+        speechSynthesis.getVoices().filter(v => !/ru/i.test(v.lang)));\n+      const sel = $('#selVoice');\n+      sel.innerHTML = this.voices.map((v, i) => `<option value=\"${i}\">${escapeHtml(v.name)} (${v.lang})</option>`).join('');\n+      const saved = localStorage.getItem('koma.voice');\n+      if (saved && this.voices[+saved]) sel.value = saved;\n+      this.voice = this.voices[+sel.value] || null;\n+    };\n+    fill();\n+    speechSynthesis.onvoiceschanged = fill;\n+    $('#selVoice').onchange = (e) => {\n+      this.voice = this.voices[+e.target.value] || null;\n+      localStorage.setItem('koma.voice', e.target.value);\n+    };\n+    const r = $('#rngRate');\n+    r.value = +(localStorage.getItem('koma.rate') || (RULES.speechRate || 1));\n+    this.rate = +r.value;\n+    r.oninput = () => { this.rate = +r.value; localStorage.setItem('koma.rate', r.value); };\n+  },\n+  stop() {\n+    this.stopped = true; this.speaking = false; this.queue = [];\n+    speechSynthesis.cancel();\n+    Reader.current = null;\n+    Reader.paintAllFrames();\n+    $('#playBar').style.display = 'none';\n+    $('#btnRead').textContent = '▶';\n+  },\n+  /**\n+   * Держать читаемую реплику в «безопасной» полосе экрана: сверху шапка и\n+   * бейдж распознавания, снизу панель проигрывания и нижняя панель. Раньше\n+   * плеер стоял прямо на облачке — текст реплики был закрыт.\n+   * Масштаб не меняем (правило), только прокручиваем ленту.\n+   */\n+  followLine(line) {\n+    if (Reader.mode !== 'vertical' || !line) return;\n+    const wrap = document.querySelector(`.pagewrap[data-page=\"${Reader.page}\"]`);\n+    const sc = $('#strip');\n+    if (!wrap || !sc) return;\n+    const r = wrap.getBoundingClientRect();\n+    const sr = sc.getBoundingClientRect();\n+    if (!r.height || !sr.height) return;\n+    const top = r.top + line.top * r.height;\n+    const bottom = r.top + line.bottom * r.height;\n+    const safeTop = sr.top + 72;                        // шапка + бейдж\n+    const safeBottom = sr.top + sr.height - 170;         // панель чтения + нижняя\n+    if (top >= safeTop && bottom <= safeBottom) return;\n+    const want = sr.top + sr.height * 0.3;               // реплику — в верхнюю треть\n+    sc.scrollTo({ top: Math.max(0, sc.scrollTop + top - want), behavior: 'smooth' });\n+  },\n+  /**\n+   * Chrome/WebView разрешает озвучку только «из жеста»: если между нажатием и\n+   * speak() есть await (распознавание, чтение буфера), speak молча отбивается\n+   * с ошибкой not-allowed — панель есть, звука нет. Пустая фраза в самом\n+   * обработчике нажатия разблокирует синтезатор.\n+   */\n+  prime() {\n+    try {\n+      if (this.primed) { speechSynthesis.resume(); return; }\n+      const u = new SpeechSynthesisUtterance(' ');\n+      u.volume = 0.05;\n+      speechSynthesis.speak(u);\n+      this.primed = true;\n+    } catch (e) { console.warn('голос не разблокировался', e); }\n+  },\n+  /** Голос из списка, который реально доступен ПРЯМО СЕЙЧАС. */\n+  pickVoice() {\n+    let avail = [];\n+    try { avail = speechSynthesis.getVoices() || []; } catch (e) { avail = []; }\n+    if (!avail.length) return null;\n+    const cur = this.voice;\n+    if (cur && avail.some(v => v.voiceURI === cur.voiceURI || v.name === cur.name)) {\n+      return avail.find(v => v.voiceURI === cur.voiceURI || v.name === cur.name);\n+    }\n+    // Сохранённый голос исчез (перезапуск WebView, смена TTS-движка) —\n+    // берём русский по умолчанию, но НЕ подменяем выбор пользователя молча:\n+    // об этом говорим тостом ниже.\n+    return avail.find(v => /^ru/i.test(v.lang)) || null;\n+  },\n+  speakLine(line, then) {\n+    if (typeof speechSynthesis === 'undefined') { toast('В этой среде нет синтеза речи'); return; }\n+    let avail = [];\n+    try { avail = speechSynthesis.getVoices() || []; } catch (e) { avail = []; }\n+    if (!avail.length) {\n+      toast('Система не дала ни одного голоса: Настройки Android → Синтез речи', 7000);\n+    }\n+    const chosen = this.pickVoice();\n+    if (chosen && this.voice && chosen.voiceURI !== this.voice.voiceURI) {\n+      toast('Голос «' + (this.voice.name || '') + '» недоступен, читаю ' + chosen.name, 5000);\n+    }\n+    if (chosen) this.voice = chosen;\n+    // cancel() «на всякий случай» в WebView убивает очередь: следующий вызов\n+    // уже не запускается. Отменяем только если что-то реально звучит.\n+    try {\n+      if (speechSynthesis.speaking || speechSynthesis.pending) speechSynthesis.cancel();\n+    } catch (e) { /* ignore */ }\n+    const u = new SpeechSynthesisUtterance(line.text);\n+    if (this.voice) u.voice = this.voice;\n+    u.lang = this.voice?.lang || 'ru-RU';\n+    u.rate = this.rate;\n+    Reader.current = line;\n+    Reader.paintAllFrames();\n+    let started = false;\n+    u.onstart = () => { started = true; };\n+    u.onend = () => { if (then) then(); };\n+    u.onerror = (e) => {\n+      const code = (e && e.error) || 'unknown';\n+      this.speaking = false;\n+      // Молчать нельзя: раньше «голос не работает» выглядело как поломка\n+      // читалки, хотя браузер просто отбил озвучку.\n+      if (code === 'not-allowed') toast('Браузер не разрешил озвучку — нажмите ▶ ещё раз', 5000);\n+      else if (code === 'interrupted' || code === 'canceled') { /* это наш cancel() */ }\n+      else toast('Голос не сказал: ' + code, 5000);\n+      if (then) then();\n+    };\n+    try { speechSynthesis.speak(u); } catch (e) {\n+      toast('Синтез отказал: ' + (e.message || e), 6000);\n+      return;\n+    }\n+    // Если синтез не начал говорить и не сообщил ошибку — молчать нельзя:\n+    // именно это выглядело как «голос по умолчанию молчит».\n+    clearTimeout(this._watch);\n+    this._watch = setTimeout(() => {\n+      if (started || this.stopped) return;\n+      if (!speechSynthesis.speaking && !speechSynthesis.pending) {\n+        toast('Синтез не ответил. Нажмите ⚙ → «Проверить голос»', 6000);\n+      }\n+    }, 1200);\n+    // Прокрутка — ПОСЛЕ speak и в try: ошибка геометрии не должна съедать звук.\n+    try { this.followLine(line); } catch (e) { console.warn('не прокрутил к реплике', e); }\n+  },\n+  async readVisible() {\n+    // Если страница ещё не распознана — сначала распознать, потом читать.\n+    // Раньше в этот момент вылезало «На этой полосе нет распознанного текста»\n+    // прямо во время сканирования, хотя текст вот он.\n+    const i = Reader.page;\n+    if (!Reader.regions.get(i)) {\n+      if (State.scanning) {\n+        toast('Распознаю страницу, начну читать сразу после', 4000);\n+        const wait = setInterval(() => {\n+          if (!State.scanning) {\n+            clearInterval(wait);\n+            if (Reader.regions.get(i) && !this.stopped && !State.waitingScroll) this.readVisible();\n+          }\n+        }, 400);\n+        return;\n+      }\n+      if (OCR.ready) {\n+        toast('Сначала распознаю страницу…', 4000);\n+        await Reader.scanCurrent(false);\n+      }\n+    }\n+    const lines = Reader.visibleLines();\n+    if (!lines.length) {\n+      if (Reader.scrollBusy) return toast('Лента едет — дочитаю, когда остановится', 3000);\n+      const data = Reader.regions.get(i);\n+      if (!data) { toast('Сначала нужно распознать страницу: ✨ Текст страницы', 4000); return; }\n+      toast('На этой полосе нет распознанного текста — прокрутите к репликам', 4000);\n+      return;\n+    }\n+    this.queue = lines.slice();\n+    this.stopped = false; this.idx = 0;\n+    $('#playBar').style.display = 'flex';\n+    $('#btnRead').textContent = '⏸';\n+    this.step();\n+  },\n+  step() {\n+    if (this.stopped) return;\n+    if (this.idx >= this.queue.length) {\n+      this.onQueueEnd();\n+      return;\n+    }\n+    const line = this.queue[this.idx++];\n+    $('#playStatus').textContent = (RULES.semiManual && State.semi) ? 'ждём прокрутки' : '';\n+    this.speakLine(line, () => { if (!this.stopped) this.step(); });\n+  },\n+  async onQueueEnd() {\n+    Reader.current = null;\n+    Reader.paintAllFrames();\n+    if (!RULES.semiManual || !State.semi) {\n+      // обычный режим: листаем дальше и читаем следующую страницу\n+      if (Reader.page < Reader.pages.length - 1) {\n+        Reader.scrollToPage(Reader.page + 1);\n+        await sleep(350);\n+        Reader.scanCurrent(false).then(() => { if (!this.stopped) this.readVisible(); });\n+      } else { this.stop(); toast('Конец книги'); }\n+      return;\n+    }\n+    // полуручной: встали и ждём прокрутки\n+    State.waitingScroll = true;\n+    $('#playBar').style.display = 'flex';\n+    $('#playStatus').textContent = 'ждём прокрутки';\n+    showArrow();\n+  },\n+};\n+\n+/* ───────────────────────── 11. Состояние и интерфейс ───────────────────────── */\n+const State = { scanning: false, semi: false, waitingScroll: false, autoScroll: true, pendingScan: null };\n+\n+function show(id) {\n+  $$('.screen').forEach(s => s.classList.toggle('on', s.id === id));\n+}\n+function openSheet(id) {\n+  $$('.sheet').forEach(s => s.classList.toggle('on', s.id === id));\n+  const bg = $('#sheetBg');\n+  if (bg) bg.classList.toggle('on', !!id);\n+  // Новая шторка всегда открывается сверху, а не с прокруткой от прошлой.\n+  const sh = document.getElementById(id);\n+  if (sh) { const b = sh.querySelector('.body'); if (b) b.scrollTop = 0; }\n+}\n+function closeSheets() {\n+  $$('.sheet').forEach(s => s.classList.remove('on'));\n+  const bg = $('#sheetBg');\n+  if (bg) bg.classList.remove('on');\n+}\n+\n+function showArrow() {\n+  const a = $('#nextArrow');\n+  a.className = 'nextArrow ' + (Reader.mode === 'vertical' ? 'down' : Reader.mode === 'rtl' ? 'left' : 'right');\n+  a.textContent = Reader.mode === 'vertical' ? '▼ Прокрутить' : Reader.mode === 'rtl' ? '◀ Прокрутить' : '▶ Прокрутить';\n+  a.style.display = 'flex';\n+}\n+function hideArrow() { $('#nextArrow').style.display = 'none'; }\n+\n+/**\n+ * Повторная чистка готовых строк: правила мусора менялись, а в буфере лежит\n+ * текст, распознанный раньше. Пустые строки выпадают вместе со своими рамками.\n+ */\n+async function cleanLines(lines) {\n+  const keyOf = (t) => String(t || '').toLowerCase().replace(/[^\\p{L}\\p{N}]+/gu, ' ').trim();\n+  const out = [];\n+  for (const ln of lines) {\n+    const text = Words.ready ? Words.polish(ln.text, RULES.junkRatio, ln.confidence) : ln.text;\n+    if (!text) continue;\n+    // Один и тот же текст в том же месте — дубль от полос прежней версии.\n+    const k = keyOf(text);\n+    const dup = k && out.some(o => keyOf(o.text) === k\n+      && Math.min(o.bottom, ln.bottom) > Math.max(o.top, ln.top));\n+    if (dup) continue;\n+    out.push(text === ln.text ? ln : { ...ln, text });\n+  }\n+  return out;\n+}\n+\n+function renderTextSheet(i) {\n+  // Открывая шторку, сначала сверяем индекс с тем, что реально на экране:\n+  // раньше здесь стоял «застрявший» Reader.page, и текст открывался не той\n+  // страницы, которую человек видит.\n+  if (i == null) i = Reader.syncPage();\n+  const onScreen = Reader.pageAtViewport();\n+  const data = Reader.regions.get(i);\n+  $('#textTitle').innerHTML = `Текст страницы ${i + 1}`\n+    + (i === onScreen ? '' : `<span class=\"hint\" style=\"font-weight:400\"> · на экране стр. ${onScreen + 1}</span>`);\n+  if ($('#textNav')) {\n+    const hasPrev = i > 0, hasNext = i < Reader.pages.length - 1;\n+    $('#textNav').innerHTML = `<button class=\"btn\" id=\"textPrev\" ${hasPrev ? '' : 'disabled'}>◀${hasPrev ? ' стр. ' + i : ''}</button>`\n+      + `<span class=\"hint\" style=\"align-self:center\">${i + 1} из ${Reader.pages.length}</span>`\n+      + `<button class=\"btn\" id=\"textNext\" ${hasNext ? '' : 'disabled'}>${hasNext ? 'стр. ' + (i + 2) + ' ' : ''}▶</button>`;\n+    if ($('#textPrev')) $('#textPrev').onclick = () => renderTextSheet(i - 1);\n+    if ($('#textNext')) $('#textNext').onclick = () => renderTextSheet(i + 1);\n+  }\n+  if (!data) { $('#textStats').textContent = 'Страница ещё не распознана'; $('#textOrdered').innerHTML = ''; $('#textRaw').textContent = ''; return; }\n+  Reader.textPage = i;\n+  const raw = data.regions || [];\n+  const stamp = data.at ? ' · обновлено ' + data.at : '';\n+  $('#textStats').textContent = data.cached\n+    ? `${data.lines.length} реплик · из буфера (без повторного распознавания)`\n+    : `${raw.length} строк · ${data.boxes} блоков · ${data.crops} кропов · `\n+      + `итого ${(data.ms / 1000).toFixed(1)} с = детектор ${(data.detMs / 1000).toFixed(1)} с `\n+      + `+ распознавание ${(data.recMs / 1000).toFixed(1)} с`\n+      + (data.bands > 1 ? ` · полос: ${data.bands}` : '')\n+      + (data.detPass && data.detPass !== 'normal'\n+        ? ' · детектор нашёл со 2-й попытки: ' + ({\n+          contrast: 'контраст', binary: 'бинаризация',\n+          'binary-inv': 'инверсия', imagenet: 'нормализация кадра',\n+        }[data.detPass] || data.detPass) : '')\n+      + (data.largePasses ? ` · 2-й проход по крупному тексту: ${data.largePasses}` : '')\n+      + (data.variantRuns ? ` · перебор вариантов: ${data.variantRuns}` : '')\n+      + (data.uncoveredLines ? ` · строк вне боксов: ${data.uncoveredLines}` : '')\n+      + (data.wordsFixed ? ` · дочинено слов: ${data.wordsFixed}` : '')\n+      + stamp;\n+  $('#textOrdered').innerHTML = data.lines.length\n+    ? data.lines.map((l, n) => `<div class=\"lineitem${l.large ? ' large' : ''}\">`\n+        + `<b>${n + 1}</b>${escapeHtml(l.text)}`\n+        + (l.large ? '<span class=\"hint\"> · крупный текст</span>' : '') + '</div>').join('')\n+    : '<div class=\"hint\">Реплик не найдено</div>';\n+  $('#textRaw').textContent = raw.map(r => r.text).join('\\n') || '—';\n+}\n+async function renderBufferSheet() {\n+  const items = await Buffer.all();\n+  const total = items.reduce((a, b) => a + b.lines.length, 0);\n+  $('#bufferInfo').textContent = `Страниц в буфере: ${items.length} · строк: ${total}`;\n+  $('#bufferList').innerHTML = items.map(p => p.lines.map(l =>\n+    `<div class=\"lineitem\"><b>${p.page + 1}</b>${escapeHtml(l.text)}</div>`).join('')).join('');\n+}\n+function renderRulesInfo() {\n+  $('#rulesVer').textContent = `Версия: ${RULES.version}`+\n+    (RULES.wordFixes && Object.keys(RULES.wordFixes).length ? ` · правок слов: ${Object.keys(RULES.wordFixes).length}` : '');\n+  $('#wordFixesBox').value = JSON.stringify(RULES.wordFixes || {}, null, 2);\n+}\n+\n+/* ─── модели ─── */\n+async function renderModels() {\n+  const det = await DB.get('kv', 'model:det');\n+  const rec = await DB.get('kv', 'model:rec');\n+  const dict = await DB.get('kv', 'model:dict');\n+  const f = (x, n) => x ? `${n}: ${(x.v.byteLength / 1048576).toFixed(1)} МБ` : `${n}: нет`;\n+  const mark = (ok) => ok ? '✅' : '❌';\n+  $('#modelsState').innerHTML = [\n+    `${mark(!!det)} ${f(det, 'detection.onnx')}`,\n+    `${mark(!!rec)} ${f(rec, 'cyrillic.onnx')}`,\n+    `${mark(!!dict)} ${dict ? `cyrillic.txt: ${String(dict.v).split('\\n').filter(Boolean).length} символов` : 'cyrillic.txt: нет'}`,\n+  ].join('<br>');\n+  const note = $('#engineNote');\n+  if (note) {\n+    note.style.display = OCR.engine === 'blocked' || OCR.engine === 'failed' ? 'block' : 'none';\n+    note.innerHTML = OCR.engine === 'blocked'\n+      ? 'Так выглядит запрет WebAssembly на этой странице (предпросмотр в приложении). '\n+        + 'Модели уже сохранены — открывать заново не нужно. Скачайте файл и откройте в Chrome: '\n+        + 'там движок поднимется с теми же тремя файлами.'\n+      : '';\n+  }\n+  if ($('#dictState')) {\n+    const row = Words.ready\n+      ? '✅ словарь: ' + Words.size.toLocaleString('ru-RU') + ' слов (' + (Words.source || 'вшит') + ')'\n+      : '❌ словарь не разжался — мусорные строки попадут в озвучку';\n+    $('#dictState').innerHTML = row;\n+  }\n+  $('#ortState').textContent = (typeof ort === 'undefined')\n+    ? 'onnxruntime-web не загрузился: нужна сеть при первом открытии файла.'\n+    : OCR.statusText() + (OCR.reason ? ' — ' + OCR.reason : '');\n+}\n+/**\n+ * Проверка движка на синтетической странице: гоняем ровно тот же путь, что и на\n+ * кадре, но на картинке, нарисованной кодом. Так видно, работает ли WASM, не\n+ * открывая главу. Если WASM запрещён политикой страницы (предпросмотр), здесь\n+ * это будет сказано прямо, а не «движок загружен, моделей нет».\n+ */\n+/**\n+ * Проверка голоса по нажатию: говорит тестовую фразу и возвращает отчёт о том,\n+ * что видит браузер. Нужна, потому что «молчит» — это три разные причины\n+ * (нет голосов в системе, браузер запретил озвучку, синтез не ответил).\n+ */\n+async function selfTestVoice() {\n+  if (typeof speechSynthesis === 'undefined' || typeof SpeechSynthesisUtterance === 'undefined') {\n+    return 'В этой среде вообще нет синтеза речи (speechSynthesis undefined)';\n+  }\n+  let avail = [];\n+  try { avail = speechSynthesis.getVoices() || []; } catch (e) { avail = []; }\n+  const chosen = TTS.pickVoice();\n+  const parts = [];\n+  parts.push('голосов в системе: ' + avail.length);\n+  parts.push('выбран: ' + (chosen ? chosen.name + ' [' + chosen.lang + ']' : 'системный по умолчанию (ru-RU)'));\n+  const u = new SpeechSynthesisUtterance('Проверка голоса. Раз, два, три.');\n+  if (chosen) u.voice = chosen;\n+  u.lang = (chosen && chosen.lang) || 'ru-RU';\n+  u.rate = TTS.rate || 1;\n+  let started = false, err = '';\n+  u.onstart = () => { started = true; };\n+  u.onerror = (e) => { err = (e && e.error) || 'unknown'; };\n+  try {\n+    if (speechSynthesis.speaking || speechSynthesis.pending) speechSynthesis.cancel();\n+    speechSynthesis.speak(u);\n+  } catch (e) {\n+    parts.push('система не приняла фразу: ' + (e.message || e));\n+    return parts.join(' · ');\n+  }\n+  await sleep(1500);\n+  parts.push(started ? 'синтез заговорил' : (err ? 'ошибка синтеза: ' + err : 'синтез не ответил за 1,5 с'));\n+  return parts.join(' · ');\n+}\n+\n+async function selfTestEngine() {\n+  if (!OCR.ready) {\n+    const ok = await OCR.loadModels().catch(e => { OCR.engine = 'failed'; OCR.reason = String(e.message || e); return false; });\n+    if (!ok) { await renderModels(); toast(OCR.statusText() + (OCR.reason ? ': ' + OCR.reason : ''), 8000); return; }\n+  }\n+  try {\n+    // Тестовая «страница» рисуется НАСТОЯЩИМ canvas: у элемента нет свойства\n+    // .data (оно было только в Node-заглушке), из-за этого проверка падала с\n+    // «Cannot read properties of undefined (reading 'length')».\n+    const W = 600, H = 800;\n+    const c = makeCanvas(W, H);\n+    const ctx = c.getContext('2d', { willReadFrequently: true });\n+    ctx.fillStyle = '#ffffff';\n+    ctx.fillRect(0, 0, W, H);\n+    ctx.fillStyle = '#101010';\n+    for (let y = 120; y < 180; y += 2) ctx.fillRect(80, y, 440, 1);\n+    const boxes = await detectBoxes(c, DEFAULT_RULES.pageSide, RULES);\n+    toast(boxes.length\n+      ? 'Движок считает: детектор вернул ' + boxes.length + ' бокс(ов) на тестовой картинке'\n+      : 'Движок считает, но на тестовой картинке боксов 0 — проверьте модели', 7000);\n+    await renderModels();\n+  } catch (e) {\n+    toast('Движок не считает: ' + (e.message || e), 8000);\n+    OCR.engine = 'failed'; OCR.reason = String(e.message || e); await renderModels();\n+  }\n+}\n+\n+/**\n+ * Принять любое количество выбранных файлов модели. Ключевое: шторку не\n+ * закрываем, разбираем по именам, показываем, чего ещё не хватает.\n+ */\n+async function storeModelFiles(files) {\n+  if (!files || !files.length) return;\n+  const saved = [];\n+  for (const f of files) {\n+    const n = f.name.toLowerCase();\n+    if (n === 'detection.onnx') { await DB.put('kv', { k: 'model:det', v: await f.arrayBuffer() }); saved.push('detection.onnx'); }\n+    else if (n === 'cyrillic.onnx') { await DB.put('kv', { k: 'model:rec', v: await f.arrayBuffer() }); saved.push('cyrillic.onnx'); }\n+    else if (n === 'cyrillic.txt') { await DB.put('kv', { k: 'model:dict', v: await f.text() }); saved.push('cyrillic.txt'); }\n+  }\n+  if (!saved.length) {\n+    await renderModels();\n+    toast('Нужны файлы detection.onnx, cyrillic.onnx, cyrillic.txt — по именам. Выбрано: '\n+      + Array.from(files).map(f => f.name).join(', '), 6000);\n+    return;\n+  }\n+  await renderModels();\n+  const det = await DB.get('kv', 'model:det');\n+  const rec = await DB.get('kv', 'model:rec');\n+  const dict = await DB.get('kv', 'model:dict');\n+  const missing = [!det && 'detection.onnx', !rec && 'cyrillic.onnx', !dict && 'cyrillic.txt'].filter(Boolean);\n+  toast('Принято: ' + saved.join(', ') + (missing.length ? ' · ещё нужно: ' + missing.join(', ') : ''), 5000);\n+  if (!missing.length) {\n+    try {\n+      const ok = await OCR.loadModels();\n+      toast(ok ? 'Все три модели на месте, движок готов'\n+               : 'Модели сохранены. ' + OCR.statusText() + (OCR.reason ? ': ' + OCR.reason : ''), 9000);\n+    } catch (e) {\n+      OCR.engine = 'failed'; OCR.reason = String(e.message || e);\n+      toast('Движок не поднялся: ' + OCR.reason, 8000);\n+    }\n+    await renderModels();\n+    if (typeof selfCheck === 'function') await selfCheck();\n+  }\n+}\n+\n+/* Совместимость: старый вход выбора моделей ведёт на общий разбор файлов,\n+   но НЕ через общий input библиотеки (из-за него выбор модели открывал читалку). */\n+async function pickModels() {\n+  const inp = document.getElementById('modelPick');\n+  if (inp) inp.click();\n+}\n+\n+/* ─── прокрутка: ждём остановки ─── */\n+function watchScroll() {\n+  const strip = $('#strip');\n+  let t = null, raf = 0;\n+  const busy = () => {\n+    Reader.scrollBusy = true;\n+    clearTimeout(t);\n+    t = setTimeout(async () => {\n+      Reader.scrollBusy = false;\n+      Reader.syncPage();\n+      onScrollSettled();\n+    }, Math.max(120, RULES.semiManualSettleMs));\n+  };\n+  const onScroll = () => {\n+    busy();\n+    // Страницу определяем НА КАЖДОМ кадре прокрутки, а не только когда\n+    // «успокоится»: иначе шапка и распознавание живут прошлой страницей.\n+    if (raf) return;\n+    raf = requestAnimationFrame(() => {\n+      raf = 0;\n+      const before = Reader.page;\n+      Reader.syncPage();\n+      if (Reader.page !== before) {\n+        Reader.ensureLoaded(Reader.page);\n+        Reader.ensureLoaded(Reader.page + 1);\n+      }\n+    });\n+  };\n+  strip.addEventListener('scroll', onScroll, { passive: true });\n+  // В части браузеров scrollend есть — используем как точку «остановились».\n+  if ('onscrollend' in strip) strip.addEventListener('scrollend', () => Reader.syncPage(), { passive: true });\n+  window.addEventListener('resize', () => Reader.syncPage());\n+  window.addEventListener('orientationchange', () => setTimeout(() => Reader.syncPage(), 300));\n+  if (window.visualViewport) window.visualViewport.addEventListener('resize', () => Reader.syncPage());\n+  $('#paged').addEventListener('scroll', (e) => {\n+    if (e.target.classList && e.target.classList.contains('pagebox')) busy();\n+  }, true);\n+  $('#paged').addEventListener('touchmove', () => busy(), { passive: true });\n+  document.addEventListener('keydown', (e) => {\n+    if (!document.getElementById('reader').classList.contains('on')) return;\n+    if (e.key === 'ArrowRight' || e.key === 'PageDown') turnPage(1);\n+    if (e.key === 'ArrowLeft' || e.key === 'PageUp') turnPage(-1);\n+  });\n+}\n+/**\n+ * Собрать реплики страницы из полос без дублей.\n+ *\n+ * Полосы перекрываются (запас нужен детектору), поэтому одно и то же облачко\n+ * попадало в две-три полосы и реплика повторялась — на скриншоте 11:26 было\n+ * 11 реплик там, где в оригинале 5. Правило: полоса, распознанная позже,\n+ * вытесняет всё, что раньше попало в её вертикальный диапазон; одинаковый\n+ * текст с пересечением по вертикали тоже считается дублем.\n+ */\n+function mergeBandLines(parts, canvas) {\n+  const H = (canvas && canvas.height) || 1;\n+  const out = [];\n+  const keyOf = (t) => String(t || '').toLowerCase().replace(/[^\\p{L}\\p{N}]+/gu, ' ').trim();\n+  const overlapV = (a, b) => Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);\n+  for (const part of parts) {\n+    for (const ln of part.lines) {\n+      const k = keyOf(ln.text);\n+      const h = Math.max(1e-6, ln.bottom - ln.top);\n+      // Тот же текст в том же месте — дубль от перекрытия полос.\n+      if (k && out.some(o => keyOf(o.text) === k && overlapV(o, ln) > h * 0.2)) continue;\n+      // Разный текст на одном месте: оставляем тот, что осмысленнее. Ничего не\n+      // выбрасываем «по диапазону полосы» — так терялись реплики, которые\n+      // соседняя полоса просто не распознала.\n+      const same = out.findIndex(o => {\n+        const oh = Math.max(1e-6, o.bottom - o.top);\n+        return overlapV(o, ln) > Math.min(h, oh) * 0.6;\n+      });\n+      if (same >= 0) {\n+        const q1 = qualityOf([out[same].text]) + Math.min(ln.text.length, 60) * 0.3;\n+        const q2 = qualityOf([ln.text]) + Math.min(ln.text.length, 60) * 0.3;\n+        if (q2 > q1) out[same] = ln;\n+        continue;\n+      }\n+      out.push(ln);\n+    }\n+  }\n+  return out.sort((a, b) => a.top - b.top);\n+}\n+\n+async function onScrollSettled() {\n+  if (!$('#reader').classList.contains('on')) return;\n+  const i = Reader.page;\n+  await Reader.ensureLoaded(i);\n+  // Распознаём видимую полосу, если она ещё не распознана (вебтун: страница\n+  // длиннее экрана, полосы идут по мере прокрутки).\n+  if (OCR.ready && !State.scanning) {\n+    const band = Reader.visibleBandPx(i);\n+    const key = band ? band.key : 'page';\n+    const bandMap = Reader.bandCache.get(i);\n+    const done = bandMap && bandMap.has(key);\n+    const hasPage = Reader.regions.get(i) && !band;\n+    if (!done && !hasPage) await Reader.scanPage(i, {});\n+  }\n+  if (RULES.semiManual && State.semi) {\n+    if (State.waitingScroll) {\n+      // человек прокрутил — читаем то, что видно\n+      State.waitingScroll = false; hideArrow();\n+      await sleep(RULES.semiManualSettleMs);\n+      if (!Reader.scrollBusy) TTS.readVisible();\n+    }\n+  }\n+}\n+function turnPage(dir) {\n+  const next = clamp(Reader.page + dir, 0, Reader.pages.length - 1);\n+  if (Reader.mode === 'vertical') {\n+    const wrap = document.querySelector(`.pagewrap[data-page=\"${next}\"]`);\n+    wrap?.scrollIntoView({ behavior: 'smooth', block: 'start' });\n+  } else {\n+    document.querySelectorAll('.pagebox').forEach(b => b.classList.toggle('on', +b.dataset.page === next));\n+    Reader.page = next; Reader.syncSub(); Reader.ensureLoaded(next); Reader.afterPageReady(); Reader.saveProgress();\n+  }\n+}\n", "additions": 1029, "deletions": 0, "status": "added"}, {"file": "part5.js", "patch": "Index: part5.js\n===================================================================\n--- part5.js\t\n+++ part5.js\t\n@@ -0,0 +1,492 @@\n+\n+/* ───────────────────────── 12. Привязка событий ───────────────────────── */\n+/**\n+ * Что браузер умеет на самом деле. В вебе нет Android SAF — его нельзя\n+ * вызвать из страницы. Ближайшее: File System Access API (Chrome Android 132+,\n+ * Chrome/Edge на десктопе) и старый input[webkitdirectory] (только десктоп).\n+ * Ниже — честный ответ на вопрос «почему нет кнопки \"выбрать папку\"».\n+ */\n+const FILES = (() => {\n+  const ua = navigator.userAgent || '';\n+  const m = ua.match(/Chrome\\/(\\d+)/);\n+  const chromium = m ? +m[1] : 0;\n+  const android = /Android/i.test(ua);\n+  const fsa = typeof window.showDirectoryPicker === 'function';\n+  const dirInput = 'webkitdirectory' in document.createElement('input');\n+  const secure = window.isSecureContext !== false;\n+  let why = '';\n+  if (fsa) why = 'выбор папки доступен (File System Access)';\n+  else if (android) {\n+    why = 'выбор папки в этом браузере недоступен: Android-браузеры отдают только файлы';\n+    if (chromium && chromium < 132) why += ` (у вас Chrome ${chromium}, папка появится с 132)`;\n+  } else if (dirInput) why = 'выбор папки доступен (input webkitdirectory)';\n+  else why = 'выбор папки недоступен: браузер его не поддерживает';\n+  if (!secure) why += ' · страница не в защищённом контексте';\n+  return { fsa, dirInput, android, chromium, secure, why };\n+})();\n+\n+function bindUI() {\n+  // ── Шторки: крестик в шапке и закрытие по подложке ──\n+  // Раньше «Закрыть» была только в самом низу: на телефоне шторка выше экрана,\n+  // и до кнопки надо было долистать. Плюс часть шторок закрывалась только ею.\n+  $$('.sheet').forEach(sh => {\n+    const head = sh.querySelector('.head');\n+    if (head && !head.querySelector('.x')) {\n+      const x = document.createElement('button');\n+      x.className = 'x'; x.type = 'button'; x.setAttribute('aria-label', 'Закрыть');\n+      x.textContent = '✕';\n+      x.onclick = () => closeSheets();\n+      head.appendChild(x);\n+    }\n+  });\n+  const bg = $('#sheetBg');\n+  if (bg) bg.onclick = () => closeSheets();\n+  // закрытие свайпом вниз по шапке — привычный жест\n+  $$('.sheet .head').forEach(head => {\n+    let y0 = null;\n+    head.addEventListener('touchstart', (e) => { y0 = e.touches[0].clientY; }, { passive: true });\n+    head.addEventListener('touchend', (e) => {\n+      if (y0 != null && e.changedTouches[0].clientY - y0 > 60) closeSheets();\n+      y0 = null;\n+    }, { passive: true });\n+  });\n+\n+  // ── Импорт главы ────────────────────────────────────────────────────────\n+  // Каждый выбор — свой input: общий переиспользовался, и выбор модели\n+  // запускал импорт библиотеки («выбрал onnx — и меня выбросило в читалку»).\n+  const imgInput = $('#imgPick');\n+  const dirInput = $('#dirPick');\n+  const modelInput = $('#modelPick');\n+  const modelDirInput = $('#modelDirPick');\n+  const rulesInput = $('#rulesPick');\n+\n+  $('#btnImport').onclick = () => {\n+    const fsOK = FILES.fsa;\n+    const dirOK = FILES.dirInput;\n+    // Кнопки не прячем: видно, что они есть и почему не работают.\n+    $('#btnPickDir').style.display = 'block';\n+    $('#btnPickDir').disabled = !dirOK;\n+    $('#btnPickDir').style.opacity = dirOK ? '1' : '.45';\n+    $('#btnPickFolderModern').style.display = 'block';\n+    $('#btnPickFolderModern').disabled = !fsOK;\n+    $('#btnPickFolderModern').style.opacity = fsOK ? '1' : '.45';\n+    $('#importCaps').textContent = 'Ваш браузер: ' + FILES.why;\n+    // Куда добавлять: список существующих глав\n+    const sel = $('#importTarget');\n+    const books = Library.books || [];\n+    sel.innerHTML = '<option value=\"\">Новая глава</option>'\n+      + books.map(b => `<option value=\"${b.id}\">Добавить страницы в «${escapeHtml(b.title)}» (${b.count} стр.)</option>`).join('');\n+    $('#importNote').innerHTML = dirOK || fsOK\n+      ? 'Папка: страницы берутся все сразу, порядок — по именам файлов.'\n+      : 'Этот браузер не умеет выбирать папку. Нажмите «Выбрать файлы или CBZ» '\n+        + 'и отметьте сразу все страницы главы — порядок возьмём из имён.';\n+    $('#importTip').innerHTML = 'Подойдёт: папка с главой · CBZ/ZIP · просто набор картинок.<br>'\n+      + (ENV.android\n+        ? 'На Android папку браузер не отдаёт: в файловом менеджере удерживайте первую '\n+          + 'страницу, затем последнюю — выберутся все, порядок возьмём из имён.'\n+        : 'На десктопе проще всего выбрать папку целиком.');\n+    openSheet('sheetImport');\n+  };\n+\n+  async function addImages(files) {\n+    const target = ($('#importTarget') && $('#importTarget').value) || '';\n+    const imgs = Array.from(files).filter(f => /\\.(jpe?g|png|webp|avif|bmp|gif)$/i.test(f.name));\n+    if (!imgs.length) { toast('Среди выбранных файлов нет картинок'); return; }\n+    // Одна книга на главу: имя папки, если оно есть, иначе имя файла/общий заголовок.\n+    const rel = (f) => f.webkitRelativePath || f.name;\n+    const folders = new Set(imgs.map(f => (f.webkitRelativePath || '').split('/')[0]).filter(Boolean));\n+    imgs.sort((a, b) => rel(a).localeCompare(rel(b), undefined, { numeric: true }));\n+    const title = folders.size === 1 ? Array.from(folders)[0]\n+      : imgs.length === 1 ? imgs[0].name.replace(/\\.[^.]+$/, '')\n+      : 'Глава из ' + imgs.length + ' страниц';\n+    toast('Сохраняю ' + imgs.length + ' страниц…', 5000);\n+    const items = imgs.map(f => ({ name: f.name, blob: f }));\n+    if (target) {\n+      const book = await Library.appendTo(target, items);\n+      await Library.load();\n+      toast('Добавлено ' + imgs.length + ' стр. в «' + book.title + '» — всего ' + book.count);\n+    } else {\n+      await Library.addBook(title, items, 'files');\n+      await Library.load();\n+      toast('Добавлено: ' + title + ' (' + imgs.length + ' стр.)');\n+    }\n+  }\n+\n+  $('#btnPickDir').onclick = () => {\n+    if (!FILES.dirInput) {\n+      toast('Этот браузер не умеет выбирать папку — ' + FILES.why + '. Выберите файлы или CBZ.', 7000);\n+      return;\n+    }\n+    dirInput.click();\n+  };\n+  $('#btnPickFolderModern').onclick = async () => {\n+    if (!FILES.fsa) {\n+      toast('Выбор папки недоступен: ' + FILES.why\n+        + '. Обновите Chrome до 132+ или соберите страницы в CBZ.', 7000);\n+      return;\n+    }\n+    try {\n+      const handle = await window.showDirectoryPicker();\n+      const files = [];\n+      for await (const entry of handle.values()) {\n+        if (entry.kind !== 'file') continue;\n+        files.push(await entry.getFile());\n+      }\n+      closeSheets();\n+      await addImages(files);\n+    } catch (e) {\n+      if (e && e.name === 'AbortError') return;\n+      toast('Папка не открылась: ' + (e.message || e) + ' — выбирайте файлами', 5000);\n+      imgInput.click();\n+    }\n+  };\n+  $('#btnPickFiles').onclick = () => imgInput.click();\n+\n+  dirInput.addEventListener('change', async () => {\n+    const files = Array.from(dirInput.files || []);\n+    dirInput.value = '';\n+    if (!files.length) return;\n+    closeSheets();\n+    try { await addImages(files); }\n+    catch (e) { toast('Не удалось добавить папку: ' + (e.message || e), 5000); }\n+  });\n+  imgInput.addEventListener('change', async () => {\n+    const files = Array.from(imgInput.files || []);\n+    imgInput.value = '';\n+    if (!files.length) return;\n+    closeSheets();\n+    try {\n+      const zips = files.filter(f => /\\.(cbz|zip)$/i.test(f.name));\n+      for (const z of zips) await importZip(z);\n+      const rest = files.filter(f => !/\\.(cbz|zip)$/i.test(f.name));\n+      if (rest.length) await addImages(rest);\n+    } catch (e) { toast('Импорт не удался: ' + (e.message || e), 5000); }\n+  });\n+  $('#closeImport').onclick = closeSheets;\n+\n+  $('#btnModels').onclick = () => { openSheet('sheetModels'); renderModels(); };\n+\n+  $('#btnRulesLib').onclick = () => { openSheet('sheetRules'); renderRulesInfo(); renderBufferSheet(); };\n+  $$('#closeSheets,#closeSheets2,#closeSheets3,#closeSheets4').forEach(b => b.onclick = closeSheets);\n+\n+  // Кнопка «Проверить движок» была в разметке, но НИ К ЧЕМУ не привязана:\n+  // нажатие не делало ничего. Теперь она запускает синтетическую страницу и\n+  // показывает работу: «Проверяю…» → результат.\n+  if ($('#btnTestVoice')) {\n+    const b = $('#btnTestVoice');\n+    b.onclick = async (e) => {\n+      const el2 = e.currentTarget;\n+      if (el2.disabled) return;\n+      const label = el2.textContent || 'Проверить голос';\n+      el2.disabled = true; el2.textContent = 'Говорю…';\n+      try {\n+        // Проговариваем и показываем отчёт: какая из трёх причин молчания.\n+        const report = await selfTestVoice();\n+        toast(report, 9000);\n+      } finally {\n+        el2.disabled = false; el2.textContent = label;\n+      }\n+    };\n+  }\n+\n+  const btnTest = $('#btnTestEngine');\n+  if (btnTest) btnTest.onclick = async (e) => {\n+    const b = e.currentTarget;\n+    if (b.disabled) return;\n+    const label = b.textContent || 'Проверить движок';\n+    b.disabled = true; b.textContent = 'Проверяю…';\n+    try { await selfTestEngine(); }\n+    finally { b.disabled = false; b.textContent = label; }\n+  };\n+  $('#btnPickModels').onclick = () => modelInput.click();\n+  // Осознанный выбор в шторке текста: распознать ВСЮ страницу, а не только\n+  // видимую полосу (у вебтуна полос много, автопрокрутка идёт по экрану).\n+  if ($('#btnFullPage')) {\n+    const b = $('#btnFullPage');\n+    b.onclick = async () => {\n+      const i = Reader.page;\n+      b.disabled = true;\n+      try {\n+        await Reader.scanPage(i, { force: true, keepSheet: true, full: true });\n+        renderTextSheet(i);\n+      } finally {\n+        b.disabled = false;\n+      }\n+    };\n+  }\n+  // Словарь — отдельным выбором: его берут из того же APK (assets/koma/dict).\n+  $('#btnPickDict').onclick = () => {\n+    const inp = document.createElement('input');\n+    inp.type = 'file'; inp.accept = '.txt,text/plain';\n+    inp.onchange = async () => {\n+      const f = inp.files && inp.files[0];\n+      if (!f) return;\n+      if (!/250k|ru_|russian|dict|словар/i.test(f.name) && f.size < 100000) {\n+        const ok = true; void ok;\n+      }\n+      toast('Читаю словарь…', 4000);\n+      const text = await f.text();\n+      const count = text.split('\\n').filter(l => l.trim()).length;\n+      if (count < 1000) { toast('Это не словарь: ' + count + ' строк', 6000); return; }\n+      await DB.put('kv', { k: 'dict:ru250k', v: text });\n+      const ok = await Words.load();\n+      await renderModels();\n+      toast(ok ? 'Словарь загружен: ' + Words.size + ' слов' : 'Словарь не разобрался', 5000);\n+    };\n+    inp.click();\n+  };\n+  $('#btnPickModelDir').onclick = () => {\n+    if (!('webkitdirectory' in document.createElement('input'))) {\n+      toast('Папку браузер не выберет — выберите три файла сразу', 4000);\n+      modelInput.click();\n+      return;\n+    }\n+    modelDirInput.click();\n+  };\n+  modelInput.addEventListener('change', async () => {\n+    const files = Array.from(modelInput.files || []);\n+    modelInput.value = '';\n+    try { await storeModelFiles(files); }\n+    catch (e) { toast('Модель не принялась: ' + (e.message || e), 5000); }\n+  });\n+  modelDirInput.addEventListener('change', async () => {\n+    const files = Array.from(modelDirInput.files || []);\n+    modelDirInput.value = '';\n+    try { await storeModelFiles(files); }\n+    catch (e) { toast('Модели из папки не принялись: ' + (e.message || e), 5000); }\n+  });\n+  // Случайно стереть 12 МБ моделей одним касанием не даём.\n+  let armedClear = false, armTimer = null;\n+  $('#btnClearModels').onclick = async (e) => {\n+    const b = e.currentTarget;\n+    if (!armedClear) {\n+      armedClear = true; b.textContent = 'Точно убрать?';\n+      clearTimeout(armTimer);\n+      armTimer = setTimeout(() => { armedClear = false; b.textContent = 'Убрать модели'; }, 3000);\n+      return;\n+    }\n+    clearTimeout(armTimer); armedClear = false; b.textContent = 'Убрать модели';\n+    for (const k of ['model:det', 'model:rec', 'model:dict']) await DB.del('kv', k);\n+    OCR.ready = false; OCR.det = OCR.rec = null; OCR.engine = 'idle';\n+    await renderModels();\n+    toast('Модели убраны. Словарь вшит в файл — его трогать не нужно', 5000);\n+  };\n+\n+  // правила\n+  $('#btnRulesImport').onclick = () => {\n+    const inp = rulesInput;\n+    inp.onchange = async () => {\n+      const f = inp.files?.[0]; inp.value = '';\n+      if (!f) return;\n+      try {\n+        RULES = sanitizeRules(JSON.parse(await f.text()));\n+        await DB.put('kv', { k: 'rules', v: JSON.stringify(RULES) });\n+        renderRulesInfo(); toast('Правила применены: ' + RULES.version);\n+      } catch (e) { toast('Файл правил не разобрался: ' + e.message); }\n+    };\n+    inp.click();\n+  };\n+  $('#btnRulesExport').onclick = () => {\n+    const blob = new Blob([JSON.stringify(RULES, null, 2)], { type: 'application/json' });\n+    const a = document.createElement('a');\n+    a.href = URL.createObjectURL(blob); a.download = 'koma-rules.json'; a.click();\n+  };\n+  $('#btnRulesReset').onclick = async () => {\n+    RULES = sanitizeRules({ ...DEFAULT_RULES });\n+    await DB.put('kv', { k: 'rules', v: JSON.stringify(RULES) });\n+    renderRulesInfo(); toast('Встроенные правила');\n+  };\n+  $('#btnWordFixesSave').onclick = async () => {\n+    try {\n+      const obj = JSON.parse($('#wordFixesBox').value || '{}');\n+      RULES.wordFixes = obj;\n+      await DB.put('kv', { k: 'rules', v: JSON.stringify(RULES) });\n+      toast('Правки слов сохранены: ' + Object.keys(obj).length);\n+      // пересчитываем порядок из буфера, без нового OCR\n+      const i = Reader.page;\n+      const buf = await Buffer.get(i);\n+      if (buf) {\n+        const data = Reader.regions.get(i);\n+        if (data) {\n+          data.lines = readingOrder(data.regions, Reader.mode === 'rtl', true, RULES);\n+          Reader.paintPage(i);\n+          toast('Порядок пересчитан из буфера: ' + data.lines.length + ' реплик');\n+        }\n+      }\n+    } catch (e) { toast('JSON правок не разобрался: ' + e.message); }\n+  };\n+  $('#btnBufferExport').onclick = async () => {\n+    const items = await Buffer.all();\n+    const text = items.map(p => `стр. ${p.page + 1} · r${p.rules}\\n` +\n+      p.lines.map(l => '  ' + l.text).join('\\n')).join('\\n\\n') || 'Буфер пуст';\n+    const blob = new Blob([text], { type: 'text/plain' });\n+    const a = document.createElement('a');\n+    a.href = URL.createObjectURL(blob); a.download = 'koma-buffer.txt'; a.click();\n+  };\n+  $('#btnBufferClear').onclick = async () => { await Buffer.clear(); await renderBufferSheet(); toast('Буфер очищен'); };\n+\n+  // читалка\n+  $('#btnBack').onclick = () => { TTS.stop(); show('library'); Library.load(); };\n+  // Открывая текст, ставим авточтение на паузу: иначе лента уезжает на\n+  // следующую страницу, пока человек читает текст, и кажется, что «текст не тот».\n+  const openTextSheet = () => {\n+    if (!TTS.stopped) { TTS.stop(); toast('Авточтение остановлено — вы открыли текст страницы', 3500); }\n+    openSheet('sheetText');\n+    renderTextSheet(null);           // страницу берём С ЭКРАНА, а не из сохранённого индекса\n+  };\n+  $('#btnScan').onclick = openTextSheet;\n+  $('#btnOcr2').onclick = openTextSheet;\n+  $('#btnSettings').onclick = () => { openSheet('sheetSettings'); syncSettingsUI(); };\n+  $('#btnMore').onclick = () => { openSheet('sheetRules'); renderRulesInfo(); renderBufferSheet(); };\n+  // Шторку НЕ закрываем: иначе не видно, что происходит, и результат некуда\n+  // показать. Сканируем ту страницу, чей текст открыт (Reader.textPage), а не\n+  // «текущую в ленте» — из-за этого раньше реплики не перезаписывались вовсе.\n+  $('#btnRescan').onclick = async () => {\n+    const i = (Reader.textPage ?? Reader.page);\n+    $('#btnRescan').disabled = true;\n+    try {\n+      await Reader.scanPage(i, { force: true, keepSheet: true });\n+    } finally {\n+      $('#btnRescan').disabled = false;\n+    }\n+  };\n+  $('#btnSpeakPage').onclick = async () => {\n+    TTS.prime();                        // «Прочитать» в шторке — тот же жест\n+    const i = (Reader.textPage ?? Reader.page);\n+    await Reader.scanPage(i, { keepSheet: false });\n+    closeSheets();\n+    TTS.readVisible();\n+  };\n+  $('#btnFrames').onclick = () => {\n+    Reader.frames = !Reader.frames;\n+    $('#btnFrames').classList.toggle('hot', Reader.frames);\n+    Reader.paintAllFrames();\n+  };\n+  $('#btnRead').onclick = () => {\n+    if (TTS.stopped) {\n+      TTS.prime();                       // разблокировать голос в жесте\n+      Reader.scanCurrent(false).then(() => TTS.readVisible());\n+    } else { TTS.stop(); }\n+  };\n+  $('#btnStop').onclick = () => TTS.stop();\n+  $('#btnPause').onclick = () => {\n+    if (speechSynthesis.speaking) { speechSynthesis.pause(); $('#btnPause').textContent = '▶'; }\n+    else { speechSynthesis.resume(); $('#btnPause').textContent = '⏸'; }\n+  };\n+  $('#btnSkip').onclick = () => { speechSynthesis.cancel(); if (!TTS.stopped) TTS.step(); };\n+  $('#nextArrow').onclick = async () => {\n+    hideArrow();\n+    TTS.prime();\n+    const step = Math.round(window.innerHeight * 0.85);\n+    $('#strip').scrollBy({ top: step, behavior: 'smooth' });\n+    await sleep(300 + RULES.semiManualSettleMs);\n+    if (!Reader.scrollBusy) TTS.readVisible();\n+  };\n+\n+  // настройки чтения\n+  $('#modeChips').onclick = (e) => {\n+    const chip = e.target.closest('.chip'); if (!chip) return;\n+    Reader.mode = chip.dataset.mode;\n+    if (Reader.book) { Reader.book.mode = Reader.mode; DB.put('books', Reader.book); }\n+    Reader.buildStrip().then(() => { Reader.syncSub(); syncSettingsUI(); });\n+  };\n+  $('#dirChips').onclick = (e) => {\n+    const chip = e.target.closest('.chip'); if (!chip) return;\n+    Reader.dir = chip.dataset.dir;\n+    if (Reader.book) { Reader.book.dir = Reader.dir; DB.put('books', Reader.book); }\n+    Reader.rescanInDir();\n+    syncSettingsUI();\n+  };\n+  $('#cbAuto').onchange = (e) => {\n+    if (e.target.checked) Reader.scanCurrent(false).then(() => TTS.readVisible());\n+    else TTS.stop();\n+  };\n+  $('#cbSemi').onchange = (e) => { State.semi = e.target.checked; RULES.semiManual = e.target.checked; };\n+  $('#numSettle').onchange = async (e) => {\n+    RULES.semiManualSettleMs = clamp(+e.target.value || 0, 0, 5000);\n+    await DB.put('kv', { k: 'rules', v: JSON.stringify(RULES) });\n+  };\n+  $('#cbFrames').onchange = (e) => {\n+    Reader.frames = e.target.checked;\n+    $('#btnFrames').classList.toggle('hot', Reader.frames);\n+    Reader.paintAllFrames();\n+  };\n+  $('#cbFollow').onchange = (e) => { Reader.follow = e.target.checked; };\n+  $('#reader').addEventListener('click', (e) => {\n+    if (e.target.closest('.frame') || e.target.closest('button') || e.target.closest('.bottombar')) return;\n+    if (e.target.tagName === 'IMG') {\n+      $('#readerBar').classList.toggle('hide');\n+      $('#readerHeader').style.transform =\n+        $('#readerBar').classList.contains('hide') ? 'translateY(-110%)' : 'translateY(0)';\n+    }\n+  });\n+}\n+function syncSettingsUI() {\n+  $$('#modeChips .chip').forEach(c => c.classList.toggle('on', c.dataset.mode === Reader.mode));\n+  $$('#dirChips .chip').forEach(c => c.classList.toggle('on', c.dataset.dir === (Reader.dir || 'rtl')));\n+  $('#cbSemi').checked = !!RULES.semiManual;\n+  $('#cbFrames').checked = Reader.frames;\n+  $('#cbFollow').checked = Reader.follow;\n+  $('#numSettle').value = RULES.semiManualSettleMs;\n+  $('#cbAuto').checked = !TTS.stopped;\n+}\n+\n+/* ───────────────────────── 13. Старт ───────────────────────── */\n+// Ошибки не должны прятаться в консоли: иначе кнопка «молчит», и непонятно почему.\n+window.addEventListener('error', (e) => {\n+  const msg = e.message || (e.error && e.error.message) || 'ошибка';\n+  toast('Ошибка: ' + msg, 5000);\n+  console.error(e.error || msg);\n+});\n+window.addEventListener('unhandledrejection', (e) => {\n+  toast('Ошибка: ' + ((e.reason && e.reason.message) || e.reason || 'неизвестно'), 5000);\n+  console.error(e.reason);\n+});\n+\n+const ENV = {\n+  sandboxed: (() => { try { return window.self !== window.top; } catch { return true; } })(),\n+  android: /Android/i.test(navigator.userAgent),\n+};\n+\n+function showEnvBanner() {\n+  const b = $('#envBanner');\n+  const lines = [];\n+  if (ENV.sandboxed) lines.push('Открыто в предпросмотре: выбор файлов и IndexedDB могут быть заблокированы. Скачайте файл и откройте в Chrome.');\n+  if (DB.inMemory) lines.push('Хранилище недоступно — библиотека живёт только до перезагрузки страницы.');\n+  b.style.display = lines.length ? 'block' : 'none';\n+  b.innerHTML = lines.join('<br>');\n+}\n+async function selfCheck() {\n+  const det = await DB.get('kv', 'model:det');\n+  const parts = [];\n+  parts.push('OCR: ' + OCR.statusText());\n+  parts.push('словарь: ' + (Words.ready ? Words.size.toLocaleString('ru-RU') + ' слов (' + (Words.source || 'вшит') + ')' : 'не загрузился'));\n+  parts.push(typeof ort === 'undefined' ? 'onnxruntime-web не загружен (нужна сеть)' : 'onnxruntime-web загружен');\n+  parts.push('TTS ' + (speechSynthesis.getVoices().length ? 'есть' : 'нет голосов'));\n+  if (ENV.android) parts.push('Android: папки нет, выбирайте файлы/CBZ');\n+  $('#selfCheck').textContent = 'KOMA Web ' + VERSION + ' · ' + parts.join(' · ');\n+}\n+\n+(async function boot() {\n+  bindUI();\n+  Words.load().catch(e => console.warn('словарь не загрузился', e));\n+  watchScroll();\n+  TTS.init();\n+  const saved = await DB.get('kv', 'rules');\n+  if (saved) { try { RULES = sanitizeRules(JSON.parse(saved.v)); } catch (e) { console.warn(e); } }\n+  await Library.load();\n+  await renderModels();\n+  const ok = await OCR.loadModels().catch(e => { console.warn('модели не загрузились', e); return false; });\n+  if (!ok && (await DB.get('kv', 'model:det'))) toast('Модели есть, но движок не загрузился — нужна сеть для onnxruntime-web', 5000);\n+  renderRulesInfo();\n+  showEnvBanner();\n+  await selfCheck();\n+  setTimeout(selfCheck, 2500);\n+  // предупреждение о среде\n+  if (typeof ort === 'undefined') {\n+    $('#ortState').textContent = 'onnxruntime-web не загрузился: нет сети или открыто в предпросмотре без интернета.';\n+  }\n+})();\n+</script>\n+</body>\n+</html>\n", "additions": 492, "deletions": 0, "status": "added"}]}, "id": "msg_179966fdb001IV7IY6colWeglU", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU"}, "parts": [{"type": "text", "metadata": {"compaction_continue": true}, "synthetic": true, "text": "Continue if you have next steps, or stop and ask for clarification if you are unsure how to proceed.", "time": {"start": 1793041264605, "end": 1793041264605}, "id": "prt_179966fdd001UpdXtvvTa3dQ6T", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_179966fdb001IV7IY6colWeglU"}]}, {"info": {"parentID": "msg_179966fdb001IV7IY6colWeglU", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai-web/code", "root": "/home/runner/hub-work/yomikai-web/code"}, "cost": 0, "tokens": {"total": 175083, "input": 174758, "output": 52, "reasoning": 273, "cache": {"write": 0, "read": 0}}, "modelID": "nemotron-3.5-lightning-free", "providerID": "opencode", "time": {"created": 1793041265050, "completed": 1793041277434}, "finish": "tool-calls", "id": "msg_17996719a001VE6wFWraDNuxVJ", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU"}, "parts": [{"snapshot": "8dd4f5466ee4a83d0b26b3e7bfff909d83a98e81", "type": "step-start", "id": "prt_1799692ba00147mzT48ENrfAbo", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_17996719a001VE6wFWraDNuxVJ"}, {"type": "reasoning", "text": "The user wants to continue with the task. Let me review what we've accomplished and what the next logical steps would be.\n\nCurrent state:\n1. v1.9.12 is deployed with embedded models\n2. GitHub release created\n3. Tests pass (6/6 e2e)\n4. Mobile hang issue addressed with yieldUI\n5. Mobile smoke test passed\n\nWhat next steps would be useful?\n- User download and test on phone (already in \"Next Move\")\n- Merge PR #2 into main (if needed)\n- Additional optimization\n- Cleanup\n\nThe user said \"исходники также запуш и закомить и смержи\" - \"also push and commit and merge\". Let me push the latest changes (v1.9.13 fix for mobile hang) and merge the branch.\n\nLet me do the final steps:\n1. Push the latest commit\n2. Merge the fix/title-line-crop branch into main\n3. Create final release with updated assets\n\nActually looking at the commit history: we have commit `43de94e` for v1.9.13 fix on top of `99746fe` v1.9.12. The user wants to push, commit, and merge.\n\nLet me execute the push and merge operations.", "time": {"start": 1793041273532, "end": 1793041276895}, "id": "prt_1799692bc001YKukENUFqn3WWt", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_17996719a001VE6wFWraDNuxVJ"}, {"type": "tool", "tool": "bash", "callID": "call-43a77030-2cbe-4a34-a1f0-7a8380963b49", "state": {"status": "completed", "input": {"command": "cd /home/runner/hub-work/yomikai-web/code && git push origin fix/title-line-crop && echo \"push done\""}, "output": "Everything up-to-date\npush done\n", "metadata": {"output": "Everything up-to-date\npush done\n", "exit": 0, "truncated": false}, "title": "cd /home/runner/hub-work/yomikai-web/code && git push origin fix/title-line-crop && echo \"push done\"", "time": {"start": 1793041276907, "end": 1793041277391}}, "id": "prt_179969fe2001Kt9d1iw2JQqd35", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_17996719a001VE6wFWraDNuxVJ"}, {"reason": "tool-calls", "snapshot": "8dd4f5466ee4a83d0b26b3e7bfff909d83a98e81", "type": "step-finish", "tokens": {"total": 175083, "input": 174758, "output": 52, "reasoning": 273, "cache": {"write": 0, "read": 0}}, "cost": 0, "id": "prt_17996a1e700101NuqvIEMTRu8V", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_17996719a001VE6wFWraDNuxVJ"}]}, {"info": {"parentID": "msg_179966fdb001IV7IY6colWeglU", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai-web/code", "root": "/home/runner/hub-work/yomikai-web/code"}, "cost": 0, "tokens": {"total": 175214, "input": 1139, "output": 92, "reas