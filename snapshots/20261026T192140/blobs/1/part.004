 i < extra.length; i++) {\n  ...\n  if (onProgress) onProgress(i + 1, extra.length, 'доп. области');\n  await yieldUI();\n}\n```\n\nBut scanPage callback signature (done, total) - adding phase as 3rd arg is backward compatible.\n\nscanPage:\n```js\n(done, total, phase) => {\n  const t = phase\n    ? `Распознаём… ${phase} ${Math.ceil(done)}/${total}`\n    : `Распознаём… ${Math.min(total, Math.max(1, Math.ceil(done)))}/${total}`;\n```\n\nLet me read the exact pass 2 and pass 3 code as currently in file to patch precisely.", "time": {"start": 1793039844000, "end": 1793039850022}, "id": "prt_17980c2a0001v9oDVHCBDoI3Aa", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_1798096b4001EUIZ915VxAasLy"}, {"type": "tool", "tool": "bash", "callID": "call_d2b7d22ab6f54393a8d3152b", "state": {"status": "completed", "input": {"command": "cd /home/runner/hub-work/yomikai-web/code && grep -n \"Проход 2\\|Проход 3\\|largePasses\\|uncoveredPass\\|uncoveredBands\\|recognizeLargeBox\" koma-web.html | head -20 && sed -n '3646,3700p' koma-web.html"}, "output": "2560:  uncoveredPass: true,     // искать строки, которые детектор не закрыл боксом\n2582:  R.uncoveredPass = R.uncoveredPass !== false;\n3558:  let largePasses = 0;\n3651:  // ── Проход 2: крупный текст (титул, каллиграфия, большие буквы). На обычном\n3666:    largePasses++;\n3667:    const alt = await recognizeLargeBox(src, entry.box, R, { visible, y0, pageH: imgCanvas.height, W });\n3676:  // ── Проход 3: то, что детектор не закрыл боксами. Дешёвый поиск полос с\n3678:  if (R.uncoveredPass !== false) {\n3679:    const extra = uncoveredBands(src, det.boxes, R);\n3708:    largePasses,\n3724:function uncoveredBands(src, boxes, R) {\n3858:async function recognizeLargeBox(src, box, R, ctxInfo) {\n4721:      const largePasses = res.largePasses || 0;\n4729:        detPass, largePasses,\n5074:      + (data.largePasses ? ` · 2-й проход по крупному тексту: ${data.largePasses}` : '')\n    done++;\n    if (onProgress) onProgress(done, det.boxes.length + 0);\n    await sleep(0);      // не блокируем кадр\n  }\n\n  // ── Проход 2: крупный текст (титул, каллиграфия, большие буквы). На обычном\n  // масштабе такой блок слипается в одну «строку» и читается плохо. Кроп\n  // увеличиваем и ищем заново — тогда блок делится на строки, и каждая\n  // распознаётся отдельно. Берём результат, только если он лучше первого.\n  const pageMedian = medianLineHeight(byBox);\n  for (const entry of byBox) {\n    if (R.largeText === false) break;\n    const own = entry.items.map(i => i.bottom - i.top).sort((a, b) => a - b);\n    const h = own.length ? own[own.length >> 1] * imgCanvas.height : 0;\n    const boxW = (entry.box.right - entry.box.left) / W;\n    const firstTexts = entry.items.map(i => i.text);\n    const letters = lettersOf(firstTexts);\n    const hard = letters >= 8 && knownShare(firstTexts) < 0.5;\n    const big = pageMedian > 0 && h > pageMedian * 1.8;\n    if (boxW < (R.largeMinWidth ?? 0.22) || !(hard || big)) continue;\n    largePasses++;\n    const alt = await recognizeLargeBox(src, entry.box, R, { visible, y0, pageH: imgCanvas.height, W });\n    crops += alt.crops;\n    // Текст не теряем: принимаем второй проход, только если он сохранил хотя\n    // бы 80 % букв (иначе из титула пропадали строки).\n    if (!alt.items.length || lettersOf(alt.items.map(i => i.text)) < letters * 0.8) continue;\n    if (qualityOf(alt.items.map(i => i.text)) > qualityOf(firstTexts)) entry.items = alt.items;\n  }\n  for (const entry of byBox) for (const item of entry.items) regions.push(item);\n\n  // ── Проход 3: то, что детектор не закрыл боксами. Дешёвый поиск полос с\n  // «чернилами» без боксов; если в такой полосе нашлись строки — распознаём.\n  if (R.uncoveredPass !== false) {\n    const extra = uncoveredBands(src, det.boxes, R);\n    for (const band of extra) {\n      for (const ln of textLines(src, band, R)) {\n        if (!visible(ln)) continue;\n        const wide = (ln.right - ln.left) / W >= 0.25;\n        const { text, conf } = await decodeLine(src, ln, wide);\n        if (!text.trim() || conf <= R.minConfidence) continue;\n        DECODE_STATS.uncoveredLines++;\n        const item = {\n          text,\n          left: ln.left / W, top: (y0 + ln.top) / imgCanvas.height,\n          right: ln.right / W, bottom: (y0 + ln.bottom) / imgCanvas.height,\n          confidence: conf,\n        };\n        // уже есть почти то же самое на этом месте — не дублируем\n        const dup = regions.some(o =>\n          Math.min(o.bottom, item.bottom) - Math.max(o.top, item.top) > (item.bottom - item.top) * 0.5\n          && Math.abs(o.left - item.left) < 0.2);\n        if (!dup) regions.push(item);\n      }\n    }\n  }\n", "metadata": {"output": "2560:  uncoveredPass: true,     // искать строки, которые детектор не закрыл боксом\n2582:  R.uncoveredPass = R.uncoveredPass !== false;\n3558:  let largePasses = 0;\n3651:  // ── Проход 2: крупный текст (титул, каллиграфия, большие буквы). На обычном\n3666:    largePasses++;\n3667:    const alt = await recognizeLargeBox(src, entry.box, R, { visible, y0, pageH: imgCanvas.height, W });\n3676:  // ── Проход 3: то, что детектор не закрыл боксами. Дешёвый поиск полос с\n3678:  if (R.uncoveredPass !== false) {\n3679:    const extra = uncoveredBands(src, det.boxes, R);\n3708:    largePasses,\n3724:function uncoveredBands(src, boxes, R) {\n3858:async function recognizeLargeBox(src, box, R, ctxInfo) {\n4721:      const largePasses = res.largePasses || 0;\n4729:        detPass, largePasses,\n5074:      + (data.largePasses ? ` · 2-й проход по крупному тексту: ${data.largePasses}` : '')\n    done++;\n    if (onProgress) onProgress(done, det.boxes.length + 0);\n    await sleep(0);      // не блокируем кадр\n  }\n\n  // ── Проход 2: крупный текст (титул, каллиграфия, большие буквы). На обычном\n  // масштабе такой блок слипается в одну «строку» и читается плохо. Кроп\n  // увеличиваем и ищем заново — тогда блок делится на строки, и каждая\n  // распознаётся отдельно. Берём результат, только если он лучше первого.\n  const pageMedian = medianLineHeight(byBox);\n  for (const entry of byBox) {\n    if (R.largeText === false) break;\n    const own = entry.items.map(i => i.bottom - i.top).sort((a, b) => a - b);\n    const h = own.length ? own[own.length >> 1] * imgCanvas.height : 0;\n    const boxW = (entry.box.right - entry.box.left) / W;\n    const firstTexts = entry.items.map(i => i.text);\n    const letters = lettersOf(firstTexts);\n    const hard = letters >= 8 && knownShare(firstTexts) < 0.5;\n    const big = pageMedian > 0 && h > pageMedian * 1.8;\n    if (boxW < (R.largeMinWidth ?? 0.22) || !(hard || big)) continue;\n    largePasses++;\n    const alt = await recognizeLargeBox(src, entry.box, R, { visible, y0, pageH: imgCanvas.height, W });\n    crops += alt.crops;\n    // Текст не теряем: принимаем второй проход, только если он сохранил хотя\n    // бы 80 % букв (иначе из титула пропадали строки).\n    if (!alt.items.length || lettersOf(alt.items.map(i => i.text)) < letters * 0.8) continue;\n    if (qualityOf(alt.items.map(i => i.text)) > qualityOf(firstTexts)) entry.items = alt.items;\n  }\n  for (const entry of byBox) for (const item of entry.items) regions.push(item);\n\n  // ── Проход 3: то, что детектор не закрыл боксами. Дешёвый поиск полос с\n  // «чернилами» без боксов; если в такой полосе нашлись строки — распознаём.\n  if (R.uncoveredPass !== false) {\n    const extra = uncoveredBands(src, det.boxes, R);\n    for (const band of extra) {\n      for (const ln of textLines(src, band, R)) {\n        if (!visible(ln)) continue;\n        const wide = (ln.right - ln.left) / W >= 0.25;\n        const { text, conf } = await decodeLine(src, ln, wide);\n        if (!text.trim() || conf <= R.minConfidence) continue;\n        DECODE_STATS.uncoveredLines++;\n        const item = {\n          text,\n          left: ln.left / W, top: (y0 + ln.top) / imgCanvas.height,\n          right: ln.right / W, bottom: (y0 + ln.bottom) / imgCanvas.height,\n          confidence: conf,\n        };\n        // уже есть почти то же самое на этом месте — не дублируем\n        const dup = regions.some(o =>\n          Math.min(o.bottom, item.bottom) - Math.max(o.top, item.top) > (item.bottom - item.top) * 0.5\n          && Math.abs(o.left - item.left) < 0.2);\n        if (!dup) regions.push(item);\n      }\n    }\n  }\n", "exit": 0, "truncated": false}, "title": "cd /home/runner/hub-work/yomikai-web/code && grep -n \"Проход 2\\|Проход 3\\|largePasses\\|uncoveredPass\\|uncoveredBands\\|recognizeLargeBox\" koma-web.html | head -20 && sed -n '3646,3700p' koma-web.html", "time": {"start": 1793039850981, "end": 1793039851055}}, "id": "prt_17980da29001U5Dk4Fu7nWyWvV", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_1798096b4001EUIZ915VxAasLy"}, {"reason": "tool-calls", "snapshot": "d18faa6d254463edee0454cfb94507c90c29ad2d", "type": "step-finish", "tokens": {"total": 160766, "input": 3941, "output": 99, "reasoning": 566, "cache": {"write": 0, "read": 156160}}, "cost": 0, "id": "prt_17980de3d001tvUDBQU2EjlzE6", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_1798096b4001EUIZ915VxAasLy"}]}, {"info": {"parentID": "msg_1797264b8001MKovw19BPjr4bF", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai-web/code", "root": "/home/runner/hub-work/yomikai-web/code"}, "cost": 0, "tokens": {"total": 163908, "input": 1937, "output": 961, "reasoning": 1010, "cache": {"write": 0, "read": 160000}}, "modelID": "mimo-v2.6-flash-free", "providerID": "opencode", "time": {"created": 1793039851499, "completed": 1793039889098}, "finish": "tool-calls", "id": "msg_17980dfeb001d7zd8WM6zxU2Rt", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU"}, "parts": [{"snapshot": "d18faa6d254463edee0454cfb94507c90c29ad2d", "type": "step-start", "id": "prt_1798112c7001yNP7hwp2CpxtW1", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_17980dfeb001d7zd8WM6zxU2Rt"}, {"type": "reasoning", "text": "Now I'll patch:\n\n1. Pass 2 loop: add index-based onProgress with phase 'крупный' + yieldUI (also yield inside recognizeLargeBox variants loop)\n2. Pass 3 loop: onProgress with phase 'непокрытые' per band + yield per line\n3. scanPage callback: handle 3rd phase arg\n4. decodeLargeLines: yield per line (decodeCrop yields already - decodeBetter->decodeCrop has yieldUI at end - so each line yields). recognizeLargeBox variants: detectBoxes is heavy sync+await - add yieldUI after each variant.\n\nAlso pass 2 loop itself only runs recognizeLargeBox for matching entries - the hang was90s after 14/14. With 14 boxes maybe several large candidates each doing 3 variants × detect + lines + decodeBetter chains. decodeCrop yields now - so why was evaluate starved?\n\nWait - the mobile test that just ran ALREADY had yieldUI in decodeCrop! And badge updated through 14/14. Then WATCH EXPIRED still scanning - so something after pass1 ran 90s WITHOUT the badge updating (onProgress not called in pass 2/3) but WITH yields... if yields existed, evaluate should have worked and State.scanning polled - it did! `WATCH EXPIRED - still scanning? True` - evaluate worked, State.scanning was True for remaining time.\n\nSo it's NOT a hard hang of main thread - it's SLOW work in pass 2/3 without progress display, lasting 90+s. User sees badge frozen at 14/14 for minutes -> \"зависло\".\n\nWhat makes pass 2/3 so slow?\n- Pass 2: recognizeLargeBox - for wide boxes (boxW >= 0.22) with hard/big - on an illustrated cover many boxes might qualify? 14 boxes, some large. Each does 3× (detectBoxes at up to 1200px upscaled + textLines + decodeLargeLines with decodeBetter variants).\n- Pass 3: up to 12 uncovered bands × textLines × decodeLine (with extension up to 18 decodes per line!)\n\ndecodeLine extension on uncovered garbage \"ink\" from illustrations could be massive - each line has unknown words -> 18+6 decodes. 12 bands × many lines × 24 decodes = thousands of model runs. That's the 90s+.\n\nFixes:\n1. Progress for pass 2/3 (badge honesty)\n2. Yields already in decodeCrop - good\n3. Cap pass 3 work: limit uncovered lines per band, or disable extension preps for uncovered (wide/unknown), or budget\n4. Cap pass 2: already limited by conditions\n\nFor pass 3, lines from uncovered bands are often noise (illustration). decodeLine extension makes it expensive. Options:\n- Don't run extension (ext preps) in uncovered pass - pass a flag to decodeLine\n- Or limit total uncovered decodes with a budget\n\ndecodeLine signature: `decodeLine(canvas, ln, wide)` - add opts `{ noExt: true }` for uncovered pass.\n\nAlso limit lines per uncovered band (e.g., first 8).\n\nAnd pass 2/3 progress.\n\nLet me also check - maybe pass2's detectBoxes on upscaled variants with pageSide 1600 - sync float loops - each variant1200px -> ratio to 1600 - w,h up to 1600 - normalize loop 1600*1600*3 ~ 7.7M ops - fine.\n\ndecodeLargeLines: decodeBetter with wide lines - up to 6 variants each - OK with yield.\n\nMain cost: pass 3 decodeLine extensions on noise.\n\nImplementation:\n1. decodeLine third param becomes `wide` still; add 4th param `opts = {}` with `skipExt`\n2. uncovered loop: `decodeLine(src, ln, wide, { skipExt: true })` + yield + progress\n3. pass2: progress + phase + yield after each entry\n4. scanPage: phase in badge\n\nAlso early-exit extension is already there when allWordsKnown - noise rarely becomes known so it always runs full 18. skipExt for uncovered is right - the title fix matters for detector boxes (pass 1), not for uncovered noise. Actually uncovered could also contain missed title lines... but those would be in detector boxes usually after retry. Risk: lose \"будучи\" fix on uncovered title remnants. The original bug was line IN detector box (cropped). Keep extension for pass 1 only; uncovered uses plain decodeLine. If needed later we can re-enable.\n\nLet me patch.", "time": {"start": 1793039864525, "end": 1793039880884}, "id": "prt_1798112cd00172OgkhPM7fxRHe", "sessionID": "ses_e870b7496ffeoaBu30bGkMD4sU", "messageID": "msg_17980dfeb001d7zd8WM6zxU2Rt"}, {"type": "tool", "tool": "bash", "callID": "call_57f5bdcc5dd341b7bcedec07", "state": {"status": "completed", "input": {"command": "cd /home/runner/hub-work/yomikai-web && python3 - <<'PY'\npath='code/koma-web.html'\nsrc=open(path).read()\n\ndef rep(old, new, cnt=1):\n    global src\n    c=src.count(old)\n    assert c==cnt, f'count {c}!={cnt}: {old[:90]!r}'\n    src=src.replace(old, new)\n\n# decodeLine: accept opts.skipExt\nrep(\"\"\"  const decodeLine = async (canvas, ln, wide) => {\"\"\",\n    \"\"\"  const decodeLine = async (canvas, ln, wide, opts) => {\"\"\")\n\nrep(\"\"\"    if (text && !allWordsKnown(text) && (wide || (text.match(/\\\\p{L}/gu) || []).length >= 5)) {\"\"\",\n    \"\"\"    if (text && !allWordsKnown(text) && !(opts && opts.skipExt)\n        && (wide || (text.match(/\\\\p{L}/gu) || []).length >= 5)) {\"\"\")\n\n# Pass 2: progress + yield\nrep(\"\"\"  const pageMedian = medianLineHeight(byBox);\n  for (const entry of byBox) {\n    if (R.largeText === false) break;\n    const own = entry.items.map(i => i.bottom - i.top).sort((a, b) => a - b);\"\"\",\n    \"\"\"  const pageMedian = medianLineHeight(byBox);\n  let largeIdx = 0;\n  for (const entry of byBox) {\n    if (R.largeText === false) break;\n    if (onProgress) onProgress(++largeIdx, byBox.length, 'крупный текст');\n    await yieldUI();\n    const own = entry.items.map(i => i.bottom - i.top).sort((a, b) => a - b);\"\"\")\n\n# Pass 3: progress + yield + skipExt\nrep(\"\"\"    const extra = uncoveredBands(src, det.boxes, R);\n    for (const band of extra) {\n      for (const ln of textLines(src, band, R)) {\n        if (!visible(ln)) continue;\n        const wide = (ln.right - ln.left) / W >= 0.25;\n        const { text, conf } = await decodeLine(src, ln, wide);\"\"\",\n    \"\"\"    const extra = uncoveredBands(src, det.boxes, R);\n    for (let bi = 0; bi < extra.length; bi++) {\n      if (onProgress) onProgress(bi + 1, extra.length, 'области без боксов');\n      await yieldUI();\n      for (const ln of textLines(src, extra[bi], R)) {\n        if (!visible(ln)) continue;\n        const wide = (ln.right - ln.left) / W >= 0.25;\n        const { text, conf } = await decodeLine(src, ln, wide, { skipExt: true });\n        await yieldUI();\"\"\")\n\n# scanPage badge with phase\nrep(\"\"\"      const res = await recognizePage(c, RULES, (done, total) => {\n        const t = `Распознаём… ${Math.min(total, Math.max(1, Math.ceil(done)))}/${total}`;\"\"\",\n    \"\"\"      const res = await recognizePage(c, RULES, (done, total, phase) => {\n        const n = Math.max(1, Math.ceil(done));\n        const t = phase\n          ? `Распознаём… ${phase} ${n}/${total}`\n          : `Распознаём… ${Math.min(total, n)}/${total}`;\"\"\")\n\n# recognizeLargeBox: yield between variants\nrep(\"\"\"  let best = null;\n  for (const work of variants) {\n    const boxes = await detectBoxes(work, R.pageSide, R);\"\"\",\n    \"\"\"  let best = null;\n  for (const work of variants) {\n    await yieldUI();\n    const boxes = await detectBoxes(work, R.pageSide, R);\"\"\")\n\nopen(path,'w').write(src)\nprint('ok')\nPY\npython3 - <<'PY'\nimport re\nsrc=open('/home/runner/hub-work/yomikai-web/code/koma-web.html').read()\nm=re.search(r'<script>(.*)</script>', src, re.S)\nopen('/tmp/koma-main.js','w').write(m.group(1))\nPY\nnode --check /tmp/koma-main.js && echo SYNTAX_OK"}, "output": "ok\nSYNTAX_OK\n", "metadata": {"output": "ok\nSYNTAX_OK\n", "exit": 0, "truncated": false}, "title": "cd /home/runner/hub-work/yomikai-web && python3 - <<'PY'\npath='code/koma-web.html'\nsrc=open(path).read()\n\ndef rep(old, new, cnt=1):\n    global src\n    c=src.count(old)\n    assert c==cnt, f'count {c}!={cnt}: {old[:90]!r}'\n    src=src.replace(old, new)\n\n# decodeLine: accept opts.skipExt\nrep(\"\"\"  const decodeLine = async (canvas, ln, wide) => {\"\"\",\n    \"\"\"  const decodeLine = async (canvas, ln, wide, opts) => {\"\"\")\n\nrep(\"\"\"    if (text && !allWordsKnown(text) && (wide || (text.match(/\\\\p{L}/gu) || []).length >= 5)) {\"\"\",\n    \"\"\"    if (text && !allWordsKnown(text) && !(opts && opts.skipExt)\n        && (wide || (text.match(/\\\\p{L}/gu) || []).length >= 5)) {\"\"\")\n\n# Pass 2: progress + yield\nrep(\"\"\"  const pageMedian = medianLineHeight(byBox);\n  for (const entry of byBox) {\n    if (R.largeText === false) break;\n    const own = entry.items.map(i => i.bottom - i.top).sort((a, b) => a - b);\"\"\",\n    \"\"\"  const pageMedian = medianLineHeight(byBox);\n  let largeIdx = 0;\n  for (const entry of byBox) {\n    if (R.largeText === false) break;\n    if (onProgress) onProgress(++largeIdx, byBox.length, 'крупный текст');\n    await yieldUI();\n    const own = entry.items.map(i => i.bottom - i.top).sort((a, b) => a - b);\"\"\")\n\n# Pass 3: progress + yield + skipExt\nrep(\"\"\"    const extra = uncoveredBands(src, det.boxes, R);\n    for (const band of extra) {\n      for (const ln of textLines(src, band, R)) {\n        if (!visible(ln)) continue;\n        const wide = (ln.right - ln.left) / W >= 0.25;\n        const { text, conf } = await decodeLine(src, ln, wide);\"\"\",\n    \"\"\"    const extra = uncoveredBands(src, det.boxes, R);\n    for (let bi = 0; bi < extra.length; bi++) {\n      if (onProgress) onProgress(bi + 1, extra.length, 'области без боксов');\n      await yieldUI();\n      for (const ln of textLines(src, extra[bi], R)) {\n        if (!visible(ln)) continue;\n        const wide = (ln.right - ln.left) / W >= 0.25;\n        const { text, conf } = await decodeLine(src, ln, wide, { skipExt: true });\n        await yieldUI();\"\"\")\n\n# scanPage badge with phase\nrep(\"\"\"      const res = await recognizePage(c, RULES, (done, total) => {\n        const t = `Распознаём… ${Math.min(total, Math.max(1, Math.ceil(done)))}/${total}`;\"\"\",\n    \"\"\"      const res = await recognizePage(c