+  const names = toolNames(calls);
+  const e = new Error(
+    `«${label}» вместо ответа вызвал${names.length === 1 ? 'а' : 'и'} инструмент` +
+    `${names.length ? 'ы: ' + names.join(', ') : ''}. В чате VoiceComic инструментов нет — задайте вопрос текстом ` +
