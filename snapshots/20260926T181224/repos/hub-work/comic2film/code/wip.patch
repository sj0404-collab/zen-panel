+    private fun sniff(b: ByteArray): String {
+        fun s(o: Int, l: Int) = String(b, o, minOf(l, b.size - o), Charsets.ISO_8859_1)
+        if (b.size >= 8) {
+            if (b[0] == 0x89.toByte() && s(1, 3) == "PNG") return "image"
+            if (s(0, 3) == "GIF") return "image"
+            if (b[0] == 0xFF.toByte() && b[1] == 0xD8.toByte()) return "image"
+            if (b[0] == 0x42.toByte() && s(1, 1) == "M") return "image"
+            if (s(0, 4) == "RIFF" && s(8, 4) == "WEBP") return "image"
+        }
+        val printable = b.take(600).count { it.toInt() in 9..13 || it.toInt() in 32..126 || it.toInt() > 126 }
+        return if (b.isEmpty()) "text" else if (printable.toDouble() / b.size.coerceAtLeast(1) > 0.9) "text" else "binary"
+    }
+
+    private fun mimeOfImage(b: ByteArray): String {
+        fun s(o: Int, l: Int) = String(b, o, minOf(l, b.size - o), Charsets.ISO_8859_1)
+        return when {
+            b.size >= 8 && b[0] == 0x89.toByte() && s(1, 3) == "PNG" -> "image/png"
+            s(0, 3) == "GIF" -> "image/gif"
+            b.size >= 12 && s(0, 4) == "RIFF" && s(8, 4) == "WEBP" -> "image/webp"
+            b.size >= 2 && b[0] == 0x42.toByte() && b[1] == 0x4D.toByte() -> "image/bmp"
+            else -> "image/jpeg"
+        }
