     [38;5;255mOccular грузит страницы через PIL ([38;5;114mImage.open(...).convert([38;5;15m       
     [38;5;114m'RGB')[38;5;255m), поэтому bitmap-форматы (BMP, PNG, WEBP, TIFF, GIF) [38;5;15m      
     [38;5;255mподдерживаются на уровне движка. Но [38;5;114mscripts/occular_ocr.py[38;5;255m [38;5;15m       
     [38;5;255mотбирает файлы только по расширениям [38;5;114m.jpg/.jpeg/.png/.webp[38;5;255m ([38;5;15m      
     [38;5;114mscripts/occular_ocr.py:64[38;5;255m) — [38;5;114m.bmp[38;5;255m он просто пропустит.[38;5;15m            
                                                                       
     [38;5;255mЧто важно:[38;5;15m                                                        
                                                                       
     [38;5;216m- [1m[38;5;215mРазрешение bitmap не критично.[0m[38;5;255m[48;5;232m Детектор всё равно [38;5;15m              
       [38;5;255mмасштабирует длинную сторону входa до [38;5;114mOCCULAR_DET_VAL[38;5;255m (1152) [38;5;15m   
       [38;5;255m— маленький bitmap с экрана апскейлится, большой [38;5;15m               
       [38;5;255mдаунскейлится. То есть скриншот из мобильной читалки 800×1200 [38;5;15m  
       [38;5;255mотработает нормально.[38;5;15m                                           
     [38;5;216m- [1m[38;5;215mЕсли это скриншот с UI/полями[0m[38;5;255m[48;5;232m — эффективное разрешение текста [38;5;15m  
       [38;5;255mпадает (плейсхолдеры, отступы съедают пиксели), детектор 1152 [38;5;15m  
       [38;5;255mможет недобрать мелкие строки; тогда поднять [38;5;15m                   
       [38;5;114mOCCULAR_DET_VAL=1280[38;5;255m.[38;5;15m                                           
     [38;5;216m- [1m[38;5;215mРазворот на две страницы[0m[38;5;255m[48;5;232m — детектор справится, регионы просто [38;5;15m  
       [38;5;255mидут одним списком (порядок чтения — флаг [38;5;114mreading_order[38;5;255m, по [38;5;15m    
       [38;5;255mумолчанию off).[38;5;15m                                                 
     [38;5;216m- [1m[38;5;215mPDF-ридер[0m[38;5;255m[48;5;232m — лучше не bitmap'ить самому: у пайплайна есть [38;5;15m       
       [38;5;114mprocess_pdf(pdf_path, dpi=300, workers=...)[38;5;255m с параллелизмом [38;5;15m    
       [38;5;255mиз коробки.[38;5;15m                                                     
                                                                       
