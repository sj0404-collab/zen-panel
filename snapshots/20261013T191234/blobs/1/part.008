at.LogPriority\nimport tachiyomi.core.common.util.system.logcat\n\n/**\n * Частотный словарь русских словоформ для разбиения слипшегося OCR-текста\n * на слова (только вставка пробелов, без замены символов — словарная\n * «коррекция» запрещена правилами проекта).\n *\n * Источники (пересборка — `scripts/gen_ruwordlist.py`):\n *  * морфологический лексикон OpenCorpora;\n *  * ё/е-варианты каждой формы: OCR читает ё непоследовательно, и «НАМЁКА»\n *    обязано находиться так же, как «НАМЕКА»;\n *  * литературная лексика из прежней версии словаря (её в субтитрах нет);\n *  * сиды device-регрессий и однобуквенные служебные слова.\n *\n * 3 млн форм раскладываются по 256 чанкам-ассетам `assets/ocr/ru_words/NN.txt`\n * (NN — младший байт Java-`hashCode()` прописной формы). Раньше формы были\n * зашиты строковыми литералами в RuWordListPartNNN.kt: 3 млн форм раздували\n * APK на ~65 МБ (DEX), и установка падала с `Failed to allocate … because only\n * … allocatable` (ENOSPC) на телефонах с малым запасом свободного места.\n * Вынос в сжатый ассет убирает эти десятки мегабайт из DEX.\n *\n * Чанки грузятся ЛЕНИВО и по одному: первое обращение к слову читает только\n * его чанк (~12 тыс. форм), а не весь словарь. Сплошной `HashSet` на 3 млн\n * требовал единовременной аллокации сотен мегабайт и подвешивал телефон на\n * первом же OCR. Хранение по чанкам сохраняет O(1)-поиск прежнего HashSet,\n * но без всплеска памяти.\n */\nobject RuWordList {\n\n    private const val SHARD_DIR = \"ocr/ru_words\"\n\n    /** Число чанков — степень двойки, чтобы шардировать по младшим битам. */\n    private const val SHARD_COUNT = 256\n\n    /**\n     * Куда смотреть в JVM-юнит-тестах, где нет AssetManager. Gradle запускает\n     * тесты с рабочим каталогом = каталог модуля `data`, поэтому первый путь\n     * ведёт к тем же файлам, что упакованы в APK.\n     */\n    private val TEST_DIR_CANDIDATES = listOf(\n        \"src/main/assets/$SHARD_DIR\",\n        \"data/src/main/assets/$SHARD_DIR\",\n    )\n\n    @Volatile\n    private var opener: ((String) -> InputStream)? = null\n\n    private val lock = Any()\n    private val cache = HashMap<Int, Set<String>>()\n\n    /**\n     * Привязывает словарь к ассетам приложения и вызывается на старте (`App`)\n     * до первого обращения к [contains]. Без вызова доступен только тестовый\n     * источник из исходников модуля.\n     */\n    fun configure(context: Context) {\n        opener = { name -> context.assets.open(\"$SHARD_DIR/$name\") }\n    }\n\n    /** Правда, если ПРОПИСНАЯ словоформа есть во встроенном словаре. */\n    fun contains(word: String): Boolean {\n        if (word.isEmpty()) return false\n        val shard = word.hashCode() and (SHARD_COUNT - 1)\n        return shardWords(shard).contains(word)\n    }\n\n    private fun shardWords(shard: Int): Set<String> {\n        synchronized(lock) { cache[shard]?.let { return it } }\n        // Читаем вне блокировки: диск/ассет не держим под общим локом.\n        val words = loadShard(\"%02x.txt\".format(shard))\n        synchronized(lock) {\n            cache[shard]?.let { return it }\n            cache[shard] = words\n            return words\n        }\n    }\n\n    private fun loadShard(name: String): Set<String> {\n        val stream = openShard(name)\n        if (stream == null) {\n            logcat(LogPriority.WARN) {\n                \"RuWordList: чанк $SHARD_DIR/$name не найден — разбиение капса деградирует\"\n            }\n            return emptySet()\n        }\n        // Формы в файле уже прописные: вставляем как есть, без uppercase().\n        val set = HashSet<String>()\n        stream.bufferedReader(Charsets.UTF_8).use { reader ->\n            while (true) {\n                val line = reader.readLine() ?: break\n                if (line.isNotEmpty()) set.add(line)\n            }\n        }\n        return set\n    }\n\n    private fun openShard(name: String): InputStream? {\n        opener?.let { return it(name) }\n        for (dir in TEST_DIR_CANDIDATES) {\n            val file = File(dir, name)\n            if (file.isFile) return file.inputStream()\n        }\n        return null\n    }\n}\n"}, "output": "Wrote file successfully.", "metadata": {"diagnostics": {}, "filepath": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/RuWordList.kt", "exists": true, "truncated": false}, "title": "data/src/main/java/mihon/data/ocr/RuWordList.kt", "time": {"start": 1791916189861, "end": 1791916190038}}, "id": "prt_136870cc3001wdV61FXXd3CJuE", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13686fabc00131lfCExRw73Pvr"}, {"reason": "tool-calls", "snapshot": "a22f0baba37b826cdbf986c8817fba1dc2b7e3cb", "type": "step-finish", "tokens": {"total": 33756, "input": 193, "output": 1307, "reasoning": 0, "cache": {"write": 0, "read": 32256}}, "cost": 0, "id": "prt_136872a90001TEsicrjr2xhBmq", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13686fabc00131lfCExRw73Pvr"}, {"type": "patch", "hash": "7c5c3cbb3e9272da652cf249e371e302a4b5b0de", "files": ["/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/RuWordList.kt"], "id": "prt_136872afd0019cJ3BE4bjArIcq", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13686fabc00131lfCExRw73Pvr"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai/code", "root": "/home/runner/hub-work/yomikai/code"}, "cost": 0, "tokens": {"total": 34007, "input": 1388, "output": 235, "reasoning": 0, "cache": {"write": 0, "read": 32384}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1791916191697, "completed": 1791916205768}, "finish": "tool-calls", "id": "msg_136872fd1001nPpNZ1H1cnc5IK", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r"}, "parts": [{"snapshot": "a22f0baba37b826cdbf986c8817fba1dc2b7e3cb", "type": "step-start", "id": "prt_136873e25001dVDBYHqCjxNeX3", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136872fd1001nPpNZ1H1cnc5IK"}, {"type": "text", "text": "Обновляю оба места вызова:", "time": {"start": 1791916195457, "end": 1791916198880}, "id": "prt_136873e7f001qW6ABt7YE7MwHm", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136872fd1001nPpNZ1H1cnc5IK"}, {"type": "tool", "tool": "edit", "callID": "call_00_ok67gbdkq3l1q2ftg4loxplv", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt", "oldString": "        return up in RuWordList.upper", "newString": "        return RuWordList.contains(up)"}, "output": "Edit applied successfully.", "metadata": {"diagnostics": {}, "diff": "Index: /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt\n===================================================================\n--- /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt\n+++ /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt\n@@ -464,9 +464,9 @@\n     if (OcrVocabulary.isUserWord(up)) {\n         OcrTextCleanerStats.userDictHits++\n         return true\n     }\n-    return up in RuWordList.upper\n+    return RuWordList.contains(up)\n }\n \n fun userDictionaryCoverage(text: String): Float {\n     if (text.isBlank()) return 0f\n", "filediff": {"file": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt", "patch": "Index: /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt\n===================================================================\n--- /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt\n+++ /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt\n@@ -464,9 +464,9 @@\n     if (OcrVocabulary.isUserWord(up)) {\n         OcrTextCleanerStats.userDictHits++\n         return true\n     }\n-    return up in RuWordList.upper\n+    return RuWordList.contains(up)\n }\n \n fun userDictionaryCoverage(text: String): Float {\n     if (text.isBlank()) return 0f\n", "additions": 1, "deletions": 1}, "truncated": false}, "title": "data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt", "time": {"start": 1791916195805, "end": 1791916195840}}, "id": "prt_136873ea7001AHcS5BnCFQ82Vr", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136872fd1001nPpNZ1H1cnc5IK"}, {"type": "tool", "tool": "edit", "callID": "call_01_fdxvnxkyb4srx1tp94cumo6v", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "oldString": "        if (up in RuWordList.upper) return true", "newString": "        if (RuWordList.contains(up)) return true"}, "output": "Edit applied successfully.", "metadata": {"diagnostics": {}, "diff": "Index: /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt\n===================================================================\n--- /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt\n+++ /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt\n@@ -133,9 +133,9 @@\n /** Правда, если слово есть в пользовательском словаре ИЛИ в [RuWordList]. */\n fun isKnownWord(word: String): Boolean {\n     if (word.isEmpty()) return false\n     val up = word.uppercase()\n-    if (up in RuWordList.upper) return true\n+    if (RuWordList.contains(up)) return true\n     return lock.read { upper.contains(up) }\n }\n \n private fun persistLocked() {\n", "filediff": {"file": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "patch": "Index: /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt\n===================================================================\n--- /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt\n+++ /home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt\n@@ -133,9 +133,9 @@\n /** Правда, если слово есть в пользовательском словаре ИЛИ в [RuWordList]. */\n fun isKnownWord(word: String): Boolean {\n     if (word.isEmpty()) return false\n     val up = word.uppercase()\n-    if (up in RuWordList.upper) return true\n+    if (RuWordList.contains(up)) return true\n     return lock.read { upper.contains(up) }\n }\n \n private fun persistLocked() {\n", "additions": 1, "deletions": 1}, "truncated": false}, "title": "data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "time": {"start": 1791916198877, "end": 1791916198947}}, "id": "prt_136873fe2001IOo7EHYj9TlCUx", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136872fd1001nPpNZ1H1cnc5IK"}, {"reason": "tool-calls", "snapshot": "47cdf584ce7bdfcb8b18a3dd510296cc417985f9", "type": "step-finish", "tokens": {"total": 34007, "input": 1388, "output": 235, "reasoning": 0, "cache": {"write": 0, "read": 32384}}, "cost": 0, "id": "prt_136876648001Xku2fSTH6udIr2", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136872fd1001nPpNZ1H1cnc5IK"}, {"type": "patch", "hash": "a22f0baba37b826cdbf986c8817fba1dc2b7e3cb", "files": ["/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt", "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt"], "id": "prt_1368766bf0012zITiqmGqNnAwT", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136872fd1001nPpNZ1H1cnc5IK"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai/code", "root": "/home/runner/hub-work/yomikai/code"}, "cost": 0, "tokens": {"total": 34587, "input": 369, "output": 527, "reasoning": 27, "cache": {"write": 0, "read": 33664}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1791916206881, "completed": 1791916250626}, "finish": "tool-calls", "id": "msg_136876b21001o1Jss67Duo5BKV", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r"}, "parts": [{"snapshot": "47cdf584ce7bdfcb8b18a3dd510296cc417985f9", "type": "step-start", "id": "prt_136877bb0001ZmYysfTaOFnPAl", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136876b21001o1Jss67Duo5BKV"}, {"type": "reasoning", "text": "Now update the generator `write_asset` → `write_shards` and the docstring/main.\n\nLet me edit the generator.", "time": {"start": 1791916211136, "end": 1791916211251}, "id": "prt_136877bc0001j3WWyoe4fAhEc6", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136876b21001o1Jss67Duo5BKV"}, {"type": "text", "text": "Обновляю генератор — теперь он пишет 256 шардов:", "time": {"start": 1791916211258, "end": 1791916214268}, "id": "prt_136877c3a001FhrEbjS4crUWjM", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136876b21001o1Jss67Duo5BKV"}, {"type": "tool", "tool": "edit", "callID": "call_00_yqkjbguyokdk2v7cqjxlsx27", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py", "oldString": "Формы кладутся одним файлом-ассетом\ndata/src/main/assets/ocr/ru_wordlist.txt — по одной ПРОПИСНОЙ словоформе на\nстроку, отсортированные. Так словарь сжимается внутри APK и не попадает в\nDEX: раньше 3 млн форм лежали строковыми литералами в RuWordListPartNNN.kt\nи раздували APK на ~65 МБ, из-за чего установка падала с ENOSPC на телефонах\nс малым запасом свободного места. Прописные формы пишутся сразу, чтобы\n[RuWordList.upper] вставлял строки как есть, без 3 млн uppercase() на старте.", "newString": "Формы кладутся чанками-ассетами data/src/main/assets/ocr/ru_words/NN.txt\n(NN — младший байт Java-`hashCode()` прописной формы), по одной ПРОПИСНОЙ\nсловоформе на строку. Так словарь сжимается внутри APK и не попадает в DEX:\nраньше 3 млн форм лежали строковыми литералами в RuWordListPartNNN.kt и\nраздували APK на ~65 МБ, из-за чего установка падала с ENOSPC на телефонах с\nмалым запасом свободного места. Чанки нужны, чтобы [RuWordList] грузил только\nзапрошенные ~12 тыс. форм, а не строил `HashSet` на 3 млн на первом OCR\n(единовременная аллокация сотен мегабайт подвешивала телефон). Прописные\nформы пишутся сразу, чтобы [RuWordList] вставлял строки как есть, без\nuppercase() на 3 млн элементов."}, "output": "Edit applied successfully.", "metadata": {"diagnostics": {}, "diff": "Index: /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n===================================================================\n--- /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n+++ /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n@@ -12,15 +12,18 @@\n     текстов, которой в субтитрах нет);\n   * ручные сиды: слова из device-регрессий пользователя и однобуквенные\n     служебные слова, без которых не делятся слипшиеся прогоны («ЗАЭТИГОДЫЯ»).\n \n-Формы кладутся одним файлом-ассетом\n-data/src/main/assets/ocr/ru_wordlist.txt — по одной ПРОПИСНОЙ словоформе на\n-строку, отсортированные. Так словарь сжимается внутри APK и не попадает в\n-DEX: раньше 3 млн форм лежали строковыми литералами в RuWordListPartNNN.kt\n-и раздували APK на ~65 МБ, из-за чего установка падала с ENOSPC на телефонах\n-с малым запасом свободного места. Прописные формы пишутся сразу, чтобы\n-[RuWordList.upper] вставлял строки как есть, без 3 млн uppercase() на старте.\n+Формы кладутся чанками-ассетами data/src/main/assets/ocr/ru_words/NN.txt\n+(NN — младший байт Java-`hashCode()` прописной формы), по одной ПРОПИСНОЙ\n+словоформе на строку. Так словарь сжимается внутри APK и не попадает в DEX:\n+раньше 3 млн форм лежали строковыми литералами в RuWordListPartNNN.kt и\n+раздували APK на ~65 МБ, из-за чего установка падала с ENOSPC на телефонах с\n+малым запасом свободного места. Чанки нужны, чтобы [RuWordList] грузил только\n+запрошенные ~12 тыс. форм, а не строил `HashSet` на 3 млн на первом OCR\n+(единовременная аллокация сотен мегабайт подвешивала телефон). Прописные\n+формы пишутся сразу, чтобы [RuWordList] вставлял строки как есть, без\n+uppercase() на 3 млн элементов.\n \n Использование:\n     python3 gen_ruwordlist.py /path/to/ru_lexicon.txt /path/to/repo\n \"\"\"\n", "filediff": {"file": "/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py", "patch": "Index: /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n===================================================================\n--- /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n+++ /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n@@ -12,15 +12,18 @@\n     текстов, которой в субтитрах нет);\n   * ручные сиды: слова из device-регрессий пользователя и однобуквенные\n     служебные слова, без которых не делятся слипшиеся прогоны («ЗАЭТИГОДЫЯ»).\n \n-Формы кладутся одним файлом-ассетом\n-data/src/main/assets/ocr/ru_wordlist.txt — по одной ПРОПИСНОЙ словоформе на\n-строку, отсортированные. Так словарь сжимается внутри APK и не попадает в\n-DEX: раньше 3 млн форм лежали строковыми литералами в RuWordListPartNNN.kt\n-и раздували APK на ~65 МБ, из-за чего установка падала с ENOSPC на телефонах\n-с малым запасом свободного места. Прописные формы пишутся сразу, чтобы\n-[RuWordList.upper] вставлял строки как есть, без 3 млн uppercase() на старте.\n+Формы кладутся чанками-ассетами data/src/main/assets/ocr/ru_words/NN.txt\n+(NN — младший байт Java-`hashCode()` прописной формы), по одной ПРОПИСНОЙ\n+словоформе на строку. Так словарь сжимается внутри APK и не попадает в DEX:\n+раньше 3 млн форм лежали строковыми литералами в RuWordListPartNNN.kt и\n+раздували APK на ~65 МБ, из-за чего установка падала с ENOSPC на телефонах с\n+малым запасом свободного места. Чанки нужны, чтобы [RuWordList] грузил только\n+запрошенные ~12 тыс. форм, а не строил `HashSet` на 3 млн на первом OCR\n+(единовременная аллокация сотен мегабайт подвешивала телефон). Прописные\n+формы пишутся сразу, чтобы [RuWordList] вставлял строки как есть, без\n+uppercase() на 3 млн элементов.\n \n Использование:\n     python3 gen_ruwordlist.py /path/to/ru_lexicon.txt /path/to/repo\n \"\"\"\n", "additions": 10, "deletions": 7}, "truncated": false}, "title": "scripts/gen_ruwordlist.py", "time": {"start": 1791916214257, "end": 1791916214379}}, "id": "prt_136877cc70017o1h1qidtWx5mc", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136876b21001o1Jss67Duo5BKV"}, {"reason": "tool-calls", "snapshot": "2e17e9cc003c3d2b38a879f09c0d5b0c8fd84efb", "type": "step-finish", "tokens": {"total": 34587, "input": 369, "output": 527, "reasoning": 27, "cache": {"write": 0, "read": 33664}}, "cost": 0, "id": "prt_136881421001VjZ7i9zgLyBp5Q", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136876b21001o1Jss67Duo5BKV"}, {"type": "patch", "hash": "47cdf584ce7bdfcb8b18a3dd510296cc417985f9", "files": ["/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py"], "id": "prt_1368815ef001nGQu6SIh0hCE3E", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136876b21001o1Jss67Duo5BKV"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai/code", "root": "/home/runner/hub-work/yomikai/code"}, "cost": 0, "tokens": {"total": 34755, "input": 682, "output": 153, "reasoning": 0, "cache": {"write": 0, "read": 33920}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1791916253982, "completed": 1791916296242}, "finish": "tool-calls", "id": "msg_13688231d001avemsPwJ7onuTY", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r"}, "parts": [{"snapshot": "2e17e9cc003c3d2b38a879f09c0d5b0c8fd84efb", "type": "step-start", "id": "prt_136883fe5001jEHMTfWvw64lmE", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688231d001avemsPwJ7onuTY"}, {"type": "tool", "tool": "edit", "callID": "call_00_mfr1xujhn9wq3cl4krt6suyv", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py", "oldString": "FREQ_THRESHOLD = 20\nASSET_REL = \"data/src/main/assets/ocr/ru_wordlist.txt\"", "newString": "FREQ_THRESHOLD = 20\nSHARD_DIR_REL = \"data/src/main/assets/ocr/ru_words\"\nSHARD_COUNT = 256"}, "output": "Edit applied successfully.", "metadata": {"diagnostics": {}, "diff": "Index: /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n===================================================================\n--- /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n+++ /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n@@ -30,9 +30,10 @@\n import os\n import sys\n \n FREQ_THRESHOLD = 20\n-ASSET_REL = \"data/src/main/assets/ocr/ru_wordlist.txt\"\n+SHARD_DIR_REL = \"data/src/main/assets/ocr/ru_words\"\n+SHARD_COUNT = 256\n \n # Однобуквенные служебные слова: DP-разбиение разрешает их как отдельные\n # сегменты («ЗА ЭТИ ГОДЫ Я»), поэтому они обязаны быть в словаре.\n SINGLE_LETTER = [\"А\", \"В\", \"И\", \"К\", \"О\", \"С\", \"У\", \"Я\"]\n", "filediff": {"file": "/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py", "patch": "Index: /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n===================================================================\n--- /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n+++ /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n@@ -30,9 +30,10 @@\n import os\n import sys\n \n FREQ_THRESHOLD = 20\n-ASSET_REL = \"data/src/main/assets/ocr/ru_wordlist.txt\"\n+SHARD_DIR_REL = \"data/src/main/assets/ocr/ru_words\"\n+SHARD_COUNT = 256\n \n # Однобуквенные служебные слова: DP-разбиение разрешает их как отдельные\n # сегменты («ЗА ЭТИ ГОДЫ Я»), поэтому они обязаны быть в словаре.\n SINGLE_LETTER = [\"А\", \"В\", \"И\", \"К\", \"О\", \"С\", \"У\", \"Я\"]\n", "additions": 2, "deletions": 1}, "truncated": false}, "title": "scripts/gen_ruwordlist.py", "time": {"start": 1791916261989, "end": 1791916262377}}, "id": "prt_13688404d001fgEAILLt0QFtCw", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688231d001avemsPwJ7onuTY"}, {"reason": "tool-calls", "snapshot": "e3decde9fb5fe6082fb1ab6bf08f361ab9b7e654", "type": "step-finish", "tokens": {"total": 34755, "input": 682, "output": 153, "reasoning": 0, "cache": {"write": 0, "read": 33920}}, "cost": 0, "id": "prt_13688c69f001k28aLx9cTLjIi6", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688231d001avemsPwJ7onuTY"}, {"type": "patch", "hash": "2e17e9cc003c3d2b38a879f09c0d5b0c8fd84efb", "files": ["/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py"], "id": "prt_13688c823001b6ZekGXIv5hYIg", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688231d001avemsPwJ7onuTY"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai/code", "root": "/home/runner/hub-work/yomikai/code"}, "cost": 0, "tokens": {"total": 35480, "input": 210, "output": 710, "reasoning": 0, "cache": {"write": 0, "read": 34560}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1791916299449, "completed": 1791916352580}, "finish": "tool-calls", "id": "msg_13688d4b8001WZYnVBT1TwMJT4", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r"}, "parts": [{"snapshot": "e3decde9fb5fe6082fb1ab6bf08f361ab9b7e654", "type": "step-start", "id": "prt_13688eaee0016qxMqvu115CtMo", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688d4b8001WZYnVBT1TwMJT4"}, {"type": "tool", "tool": "edit", "callID": "call_00_hkmsvpw4x9abu0dddma5ebjl", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py", "oldString": "def write_asset(repo, forms):\n    \"\"\"Пишет отсортированные ПРОПИСНЫЕ формы в файл-ассет: одна на строку.\n\n    Прописной регистр — чтобы [RuWordList.upper] вставлял строки как есть,\n    без вызова uppercase() на каждый из 3 млн элементов при инициализации.\n    \"\"\"\n    os.makedirs(os.path.dirname(os.path.join(repo, ASSET_REL)), exist_ok=True)\n    with open(os.path.join(repo, ASSET_REL), \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n        for word in forms:\n            handle.write(word.upper() + \"\\n\")\n\n\ndef main():\n    lexicon_path, repo = sys.argv[1], sys.argv[2]\n    forms = build(lexicon_path, repo)\n    write_asset(repo, forms)\n    print(f\"форм: {len(forms)}, ассет: {ASSET_REL}\")", "newString": "def shard_of(word):\n    \"\"\"Младший байт Java-`String.hashCode()` — тот же хеш считает [RuWordList].\"\"\"\n    h = 0\n    for ch in word:\n        h = (h * 31 + ord(ch)) & 0xFFFFFFFF\n    return h & (SHARD_COUNT - 1)\n\n\ndef write_shards(repo, forms):\n    \"\"\"Раскладывает ПРОПИСНЫЕ формы по чанкам assets/ocr/ru_words/NN.txt.\n\n    Прописной регистр — чтобы [RuWordList] вставлял строки как есть, без\n    uppercase() на каждый из 3 млн элементов. Шардирование по `hashCode()`\n    даёт равномерные куски (~12 тыс. форм), которые грузятся по одному.\n    \"\"\"\n    out_dir = os.path.join(repo, SHARD_DIR_REL)\n    os.makedirs(out_dir, exist_ok=True)\n    for name in os.listdir(out_dir):\n        if name.endswith(\".txt\"):\n            os.remove(os.path.join(out_dir, name))\n\n    shards = {}\n    for word in forms:\n        up = word.upper()\n        shards.setdefault(shard_of(up), []).append(up)\n    for shard, words in shards.items():\n        with open(os.path.join(out_dir, f\"{shard:02x}.txt\"), \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n            for word in sorted(words):\n                handle.write(word + \"\\n\")\n\n\ndef main():\n    lexicon_path, repo = sys.argv[1], sys.argv[2]\n    forms = build(lexicon_path, repo)\n    write_shards(repo, forms)\n    print(f\"форм: {len(forms)}, чанки: {SHARD_DIR_REL}/\")"}, "output": "Edit applied successfully.", "metadata": {"diagnostics": {}, "diff": "Index: /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n===================================================================\n--- /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n+++ /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n@@ -114,25 +114,44 @@\n     forms = {f.replace(\"ё\", \"е\") for f in forms if f}\n     return sorted(forms)\n \n \n-def write_asset(repo, forms):\n-    \"\"\"Пишет отсортированные ПРОПИСНЫЕ формы в файл-ассет: одна на строку.\n+def shard_of(word):\n+    \"\"\"Младший байт Java-`String.hashCode()` — тот же хеш считает [RuWordList].\"\"\"\n+    h = 0\n+    for ch in word:\n+        h = (h * 31 + ord(ch)) & 0xFFFFFFFF\n+    return h & (SHARD_COUNT - 1)\n \n-    Прописной регистр — чтобы [RuWordList.upper] вставлял строки как есть,\n-    без вызова uppercase() на каждый из 3 млн элементов при инициализации.\n+\n+def write_shards(repo, forms):\n+    \"\"\"Раскладывает ПРОПИСНЫЕ формы по чанкам assets/ocr/ru_words/NN.txt.\n+\n+    Прописной регистр — чтобы [RuWordList] вставлял строки как есть, без\n+    uppercase() на каждый из 3 млн элементов. Шардирование по `hashCode()`\n+    даёт равномерные куски (~12 тыс. форм), которые грузятся по одному.\n     \"\"\"\n-    os.makedirs(os.path.dirname(os.path.join(repo, ASSET_REL)), exist_ok=True)\n-    with open(os.path.join(repo, ASSET_REL), \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n-        for word in forms:\n-            handle.write(word.upper() + \"\\n\")\n+    out_dir = os.path.join(repo, SHARD_DIR_REL)\n+    os.makedirs(out_dir, exist_ok=True)\n+    for name in os.listdir(out_dir):\n+        if name.endswith(\".txt\"):\n+            os.remove(os.path.join(out_dir, name))\n \n+    shards = {}\n+    for word in forms:\n+        up = word.upper()\n+        shards.setdefault(shard_of(up), []).append(up)\n+    for shard, words in shards.items():\n+        with open(os.path.join(out_dir, f\"{shard:02x}.txt\"), \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n+            for word in sorted(words):\n+                handle.write(word + \"\\n\")\n \n+\n def main():\n     lexicon_path, repo = sys.argv[1], sys.argv[2]\n     forms = build(lexicon_path, repo)\n-    write_asset(repo, forms)\n-    print(f\"форм: {len(forms)}, ассет: {ASSET_REL}\")\n+    write_shards(repo, forms)\n+    print(f\"форм: {len(forms)}, чанки: {SHARD_DIR_REL}/\")\n \n \n if __name__ == \"__main__\":\n     main()\n", "filediff": {"file": "/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py", "patch": "Index: /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n===================================================================\n--- /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n+++ /home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py\n@@ -114,25 +114,44 @@\n     forms = {f.replace(\"ё\", \"е\") for f in forms if f}\n     return sorted(forms)\n \n \n-def write_asset(repo, forms):\n-    \"\"\"Пишет отсортированные ПРОПИСНЫЕ формы в файл-ассет: одна на строку.\n+def shard_of(word):\n+    \"\"\"Младший байт Java-`String.hashCode()` — тот же хеш считает [RuWordList].\"\"\"\n+    h = 0\n+    for ch in word:\n+        h = (h * 31 + ord(ch)) & 0xFFFFFFFF\n+    return h & (SHARD_COUNT - 1)\n \n-    Прописной регистр — чтобы [RuWordList.upper] вставлял строки как есть,\n-    без вызова uppercase() на каждый из 3 млн элементов при инициализации.\n+\n+def write_shards(repo, forms):\n+    \"\"\"Раскладывает ПРОПИСНЫЕ формы по чанкам assets/ocr/ru_words/NN.txt.\n+\n+    Прописной регистр — чтобы [RuWordList] вставлял строки как есть, без\n+    uppercase() на каждый из 3 млн элементов. Шардирование по `hashCode()`\n+    даёт равномерные куски (~12 тыс. форм), которые грузятся по одному.\n     \"\"\"\n-    os.makedirs(os.path.dirname(os.path.join(repo, ASSET_REL)), exist_ok=True)\n-    with open(os.path.join(repo, ASSET_REL), \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n-        for word in forms:\n-            handle.write(word.upper() + \"\\n\")\n+    out_dir = os.path.join(repo, SHARD_DIR_REL)\n+    os.makedirs(out_dir, exist_ok=True)\n+    for name in os.listdir(out_dir):\n+        if name.endswith(\".txt\"):\n+            os.remove(os.path.join(out_dir, name))\n \n+    shards = {}\n+    for word in forms:\n+        up = word.upper()\n+        shards.setdefault(shard_of(up), []).append(up)\n+    for shard, words in shards.items():\n+        with open(os.path.join(out_dir, f\"{shard:02x}.txt\"), \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n+            for word in sorted(words):\n+                handle.write(word + \"\\n\")\n \n+\n def main():\n     lexicon_path, repo = sys.argv[1], sys.argv[2]\n     forms = build(lexicon_path, repo)\n-    write_asset(repo, forms)\n-    print(f\"форм: {len(forms)}, ассет: {ASSET_REL}\")\n+    write_shards(repo, forms)\n+    print(f\"форм: {len(forms)}, чанки: {SHARD_DIR_REL}/\")\n \n \n if __name__ == \"__main__\":\n     main()\n", "additions": 29, "deletions": 10}, "truncated": false}, "title": "scripts/gen_ruwordlist.py", "time": {"start": 1791916308545, "end": 1791916308713}}, "id": "prt_13688eb65001ekO0LGhkM27ddU", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688d4b8001WZYnVBT1TwMJT4"}, {"reason": "tool-calls", "snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-finish", "tokens": {"total": 35480, "input": 210, "output": 710, "reasoning": 0, "cache": {"write": 0, "read": 34560}}, "cost": 0, "id": "prt_13689a3700012zhQ6QbgY2VvzP", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688d4b8001WZYnVBT1TwMJT4"}, {"type": "patch", "hash": "e3decde9fb5fe6082fb1ab6bf08f361ab9b7e654", "files": ["/home/runner/hub-work/yomikai/code/scripts/gen_ruwordlist.py"], "id": "prt_13689a43a001E7Ed0jF4YJ5eHn", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_13688d4b8001WZYnVBT1TwMJT4"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistan