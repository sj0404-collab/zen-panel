           .fold(CompletableDeferred(true)) { acc: Deferred<Boolean>, migration: Migration ->\n18:                 if (!migrationContext.dryrun) {\n19:                     logcat {\n20:                         \"Running migration: { name = ${migration::class.simpleName}, version = ${migration.version} }\"\n21:                     }\n22:                     async(start = CoroutineStart.UNDISPATCHED) {\n23:                         val prev = acc.await()\n24:                         migration(migrationContext) || prev\n25:                     }\n26:                 } else {\n27:                     logcat {\n28:                         \"(Dry-run) Running migration: { name = ${migration::class.simpleName}, version = ${migration.version} }\"\n29:                     }\n30:                     CompletableDeferred(true)\n31:                 }\n32:             }\n33:     }\n34: }\n\n(End of file - total 34 lines)\n</content>", "metadata": {"preview": "package mihon.core.migration\n\nimport kotlinx.coroutines.CompletableDeferred\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.CoroutineStart\nimport kotlinx.coroutines.Deferred\nimport kotlinx.coroutines.async\nimport tachiyomi.core.common.util.system.logcat\n\nclass MigrationJobFactory(\n    private val migrationContext: MigrationContext,\n    private val scope: CoroutineScope,\n) {\n\n    fun create(migrations: List<Migration>): Deferred<Boolean> = with(scope) {\n        return migrations.sortedBy { it.version }\n            .fold(CompletableDeferred(true)) { acc: Deferred<Boolean>, migration: Migration ->\n                if (!migrationContext.dryrun) {\n                    logcat {\n                        \"Running migration: { name = ${migration::class.simpleName}, version = ${migration.version} }\"", "truncated": false, "loaded": [], "display": {"type": "file", "path": "/home/runner/hub-work/yomikai/code/app/src/main/java/mihon/core/migration/MigrationJobFactory.kt", "text": "package mihon.core.migration\n\nimport kotlinx.coroutines.CompletableDeferred\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.CoroutineStart\nimport kotlinx.coroutines.Deferred\nimport kotlinx.coroutines.async\nimport tachiyomi.core.common.util.system.logcat\n\nclass MigrationJobFactory(\n    private val migrationContext: MigrationContext,\n    private val scope: CoroutineScope,\n) {\n\n    fun create(migrations: List<Migration>): Deferred<Boolean> = with(scope) {\n        return migrations.sortedBy { it.version }\n            .fold(CompletableDeferred(true)) { acc: Deferred<Boolean>, migration: Migration ->\n                if (!migrationContext.dryrun) {\n                    logcat {\n                        \"Running migration: { name = ${migration::class.simpleName}, version = ${migration.version} }\"\n                    }\n                    async(start = CoroutineStart.UNDISPATCHED) {\n                        val prev = acc.await()\n                        migration(migrationContext) || prev\n                    }\n                } else {\n                    logcat {\n                        \"(Dry-run) Running migration: { name = ${migration::class.simpleName}, version = ${migration.version} }\"\n                    }\n                    CompletableDeferred(true)\n                }\n            }\n    }\n}", "lineStart": 1, "lineEnd": 34, "totalLines": 34, "truncated": false}}, "title": "app/src/main/java/mihon/core/migration/MigrationJobFactory.kt", "time": {"start": 1791916622971, "end": 1791916623046}}, "id": "prt_1368dc462001HWz9sUj2eBCf8G", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368db517001snkO3qBAzjnoiG"}, {"type": "tool", "tool": "bash", "callID": "call_01_buvsuxkll7wuqtg32wrio82n", "state": {"status": "completed", "input": {"command": "cd /home/runner/hub-work/yomikai/code && grep -rn \"awaitAndRelease\" --include=*.kt --exclude-dir=build ."}, "output": "./app/src/main/java/eu/kanade/tachiyomi/ui/main/MainActivity.kt:179:        Migrator.awaitAndRelease()\n./app/src/main/java/mihon/core/migration/Migrator.kt:38:    fun awaitAndRelease(): Boolean = runBlocking {\n", "metadata": {"output": "./app/src/main/java/eu/kanade/tachiyomi/ui/main/MainActivity.kt:179:        Migrator.awaitAndRelease()\n./app/src/main/java/mihon/core/migration/Migrator.kt:38:    fun awaitAndRelease(): Boolean = runBlocking {\n", "exit": 0, "truncated": false}, "title": "cd /home/runner/hub-work/yomikai/code && grep -rn \"awaitAndRelease\" --include=*.kt --exclude-dir=build .", "time": {"start": 1791916624589, "end": 1791916624650}}, "id": "prt_1368dc47d001ywlOf0MfvE1UQJ", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368db517001snkO3qBAzjnoiG"}, {"reason": "tool-calls", "snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-finish", "tokens": {"total": 46166, "input": 1624, "output": 126, "reasoning": 0, "cache": {"write": 0, "read": 44416}}, "cost": 0, "id": "prt_1368dd742001cFVvSV3ylUwpp8", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368db517001snkO3qBAzjnoiG"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai/code", "root": "/home/runner/hub-work/yomikai/code"}, "cost": 0, "tokens": {"total": 46884, "input": 707, "output": 144, "reasoning": 81, "cache": {"write": 0, "read": 45952}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1791916628769, "completed": 1791916637153}, "finish": "tool-calls", "id": "msg_1368ddb210018QlCCMP0Lb5evt", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r"}, "parts": [{"snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-start", "id": "prt_1368de9190019o5X53yZDpMvF0", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368ddb210018QlCCMP0Lb5evt"}, {"type": "reasoning", "text": "Let me read Migrator.kt and how `create` is invoked (which scope). The `CoroutineStart.UNDISPATCHED` means the first `async` block begins executing synchronously in the caller's thread before yielding. So if the scope is main, migrations run on main.\n\nWhere is Migrator used / where is `create` called?\n\nLet me read Migrator.kt.", "time": {"start": 1791916632348, "end": 1791916632357}, "id": "prt_1368de91c001P2EmrOhCpmAdX1", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368ddb210018QlCCMP0Lb5evt"}, {"type": "tool", "tool": "read", "callID": "call_00_5bwomc5gu0jmw1pci3bhycxs", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/app/src/main/java/mihon/core/migration/Migrator.kt"}, "output": "<path>/home/runner/hub-work/yomikai/code/app/src/main/java/mihon/core/migration/Migrator.kt</path>\n<type>file</type>\n<content>\n1: package mihon.core.migration\n2: \n3: import kotlinx.coroutines.CompletableDeferred\n4: import kotlinx.coroutines.CoroutineScope\n5: import kotlinx.coroutines.Deferred\n6: import kotlinx.coroutines.Dispatchers\n7: import kotlinx.coroutines.Job\n8: import kotlinx.coroutines.runBlocking\n9: \n10: object Migrator {\n11: \n12:     private var result: Deferred<Boolean>? = null\n13:     val scope = CoroutineScope(Dispatchers.IO + Job())\n14: \n15:     fun initialize(\n16:         old: Int,\n17:         new: Int,\n18:         migrations: List<Migration>,\n19:         dryrun: Boolean = false,\n20:         onMigrationComplete: () -> Unit,\n21:     ) {\n22:         val migrationContext = MigrationContext(dryrun, old)\n23:         val migrationJobFactory = MigrationJobFactory(migrationContext, scope)\n24:         val migrationStrategyFactory = MigrationStrategyFactory(migrationJobFactory, onMigrationComplete)\n25:         val strategy = migrationStrategyFactory.create(old, new)\n26:         result = strategy(migrations)\n27:     }\n28: \n29:     suspend fun await(): Boolean {\n30:         val result = result ?: CompletableDeferred(false)\n31:         return result.await()\n32:     }\n33: \n34:     fun release() {\n35:         result = null\n36:     }\n37: \n38:     fun awaitAndRelease(): Boolean = runBlocking {\n39:         await().also { release() }\n40:     }\n41: }\n\n(End of file - total 41 lines)\n</content>", "metadata": {"preview": "package mihon.core.migration\n\nimport kotlinx.coroutines.CompletableDeferred\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.Deferred\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.Job\nimport kotlinx.coroutines.runBlocking\n\nobject Migrator {\n\n    private var result: Deferred<Boolean>? = null\n    val scope = CoroutineScope(Dispatchers.IO + Job())\n\n    fun initialize(\n        old: Int,\n        new: Int,\n        migrations: List<Migration>,\n        dryrun: Boolean = false,\n        onMigrationComplete: () -> Unit,", "truncated": false, "loaded": [], "display": {"type": "file", "path": "/home/runner/hub-work/yomikai/code/app/src/main/java/mihon/core/migration/Migrator.kt", "text": "package mihon.core.migration\n\nimport kotlinx.coroutines.CompletableDeferred\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.Deferred\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.Job\nimport kotlinx.coroutines.runBlocking\n\nobject Migrator {\n\n    private var result: Deferred<Boolean>? = null\n    val scope = CoroutineScope(Dispatchers.IO + Job())\n\n    fun initialize(\n        old: Int,\n        new: Int,\n        migrations: List<Migration>,\n        dryrun: Boolean = false,\n        onMigrationComplete: () -> Unit,\n    ) {\n        val migrationContext = MigrationContext(dryrun, old)\n        val migrationJobFactory = MigrationJobFactory(migrationContext, scope)\n        val migrationStrategyFactory = MigrationStrategyFactory(migrationJobFactory, onMigrationComplete)\n        val strategy = migrationStrategyFactory.create(old, new)\n        result = strategy(migrations)\n    }\n\n    suspend fun await(): Boolean {\n        val result = result ?: CompletableDeferred(false)\n        return result.await()\n    }\n\n    fun release() {\n        result = null\n    }\n\n    fun awaitAndRelease(): Boolean = runBlocking {\n        await().also { release() }\n    }\n}", "lineStart": 1, "lineEnd": 41, "totalLines": 41, "truncated": false}}, "title": "app/src/main/java/mihon/core/migration/Migrator.kt", "time": {"start": 1791916632570, "end": 1791916632620}}, "id": "prt_1368de927001ROrYQxb3CDVHs6", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368ddb210018QlCCMP0Lb5evt"}, {"type": "tool", "tool": "bash", "callID": "call_01_aqesh1f17iv17hgzla9djbab", "state": {"status": "completed", "input": {"command": "cd /home/runner/hub-work/yomikai/code && grep -rn \"MigrationJobFactory\\|Migrator(\" --include=*.kt --exclude-dir=build app/src/main | grep -v \"class Migrator\\|class MigrationJobFactory\""}, "output": "app/src/main/java/eu/kanade/tachiyomi/App.kt:251:        initializeMigrator()\napp/src/main/java/eu/kanade/tachiyomi/App.kt:255:    private fun initializeMigrator() {\napp/src/main/java/mihon/core/migration/Migrator.kt:23:        val migrationJobFactory = MigrationJobFactory(migrationContext, scope)\napp/src/main/java/mihon/core/migration/MigrationStrategy.kt:13:    private val migrationJobFactory: MigrationJobFactory,\napp/src/main/java/mihon/core/migration/MigrationStrategyFactory.kt:4:    private val factory: MigrationJobFactory,\n", "metadata": {"output": "app/src/main/java/eu/kanade/tachiyomi/App.kt:251:        initializeMigrator()\napp/src/main/java/eu/kanade/tachiyomi/App.kt:255:    private fun initializeMigrator() {\napp/src/main/java/mihon/core/migration/Migrator.kt:23:        val migrationJobFactory = MigrationJobFactory(migrationContext, scope)\napp/src/main/java/mihon/core/migration/MigrationStrategy.kt:13:    private val migrationJobFactory: MigrationJobFactory,\napp/src/main/java/mihon/core/migration/MigrationStrategyFactory.kt:4:    private val factory: MigrationJobFactory,\n", "exit": 0, "truncated": false}, "title": "cd /home/runner/hub-work/yomikai/code && grep -rn \"MigrationJobFactory\\|Migrator(\" --include=*.kt --exclude-dir=build app/src/main | grep -v \"class Migrator\\|class MigrationJobFactory\"", "time": {"start": 1791916634054, "end": 1791916634103}}, "id": "prt_1368de9fd001jxm7fxRp0waizk", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368ddb210018QlCCMP0Lb5evt"}, {"reason": "tool-calls", "snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-finish", "tokens": {"total": 46884, "input": 707, "output": 144, "reasoning": 81, "cache": {"write": 0, "read": 45952}}, "cost": 0, "id": "prt_1368dfbaa001JYKmD1Ks6yKhsG", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368ddb210018QlCCMP0Lb5evt"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai/code", "root": "/home/runner/hub-work/yomikai/code"}, "cost": 0, "tokens": {"total": 49600, "input": 875, "output": 404, "reasoning": 1729, "cache": {"write": 0, "read": 46592}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1791916638079, "completed": 1791916654531}, "finish": "tool-calls", "id": "msg_1368dff7f001w6k7ubUsBkRAHB", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r"}, "parts": [{"snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-start", "id": "prt_1368e0d14001c9LUV0d2zXlSyM", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368dff7f001w6k7ubUsBkRAHB"}, {"type": "reasoning", "text": "`Migrator.scope = CoroutineScope(Dispatchers.IO + Job())`. So migrations run on Dispatchers.IO background. Good. `awaitAndRelease()` uses `runBlocking` on the main thread (called from MainActivity.onCreate) to wait for migrations to finish. This blocks the main thread until migrations complete! That's a startup stall. But it's needed to ensure DB is migrated before UI reads it.\n\nIn upstream Mihon, the migrator is awaited in some way. Actually upstream `MainActivity` does:\n```kotlin\nif (!isTaskRoot) { ... }\nMigrator.awaitAndRelease()\n```\nHmm, runBlocking on main waiting for IO migrations → stalls first frame. This is a known pattern but can be slow if migrations are heavy. The user's \"очень медленно прогружается интерфейс\" might partly be this.\n\nBut changing it risks data integrity (UI reading unmigrated DB). I should be cautious. A safer improvement: migrations already run on IO; `runBlocking` waits. Could we show the splash until done? They already installSplashScreen. Hmm.\n\nI think this is beyond a safe quick fix. Let me not touch MainActivity/Migrator now.\n\nGiven the constraints and the user's explicit \"no regression\" for performance, I'll:\n1. Fix AppModule main-executor → background thread (clear bug, safe, high impact).\n2. Move `OcrVocabulary.configure` and `OcrScreenshotBuffer.init` off main? These involve file I/O. OcrVocabulary.configure is small; but OcrScreenshotBuffer.load reads potentially large JSON. However the fields `persistFile`/`imagesDir` are set before load; if I split, I need care. \n\nLet me check: is there any reliance on OcrScreenshotBuffer being initialized synchronously before UI? The UI collects `_entries`. If init is async, entries start empty and populate. Fine. But `add()` uses `imagesDir` — during startup auto-read won't run before user opens a book. Safe enough. But `initialized` non-volatile flag race. I'll just move the whole `init` call into a background Thread in App.kt (same pattern as other inits), leaving `init` itself unchanged. Since `init` early-returns if already initialized, and it's called once, fine. But `@Synchronized on add` doesn't protect init. Two threads calling init? Only one call site. OK.\n\nHmm, but OcrVocabulary.configure is called with the file; then other code (CyrillicOcrEngine) may call isUserWord. If configure runs on background and OCR starts before it finishes, user words missing briefly. Acceptable (OCR not immediate).\n\nActually, a cleaner approach for both: create one low-priority background thread that does OcrVocabulary.configure + OcrScreenshotBuffer.init + maxEntries. Let me do that.\n\nBut wait — `RuWordList.configure` must stay on main? It just sets a lambda; no I/O. Fine on main.\n\nLet me make the change: replace lines 148-163 (OcrVocabulary.configure, RuWordList.configure stays, OcrScreenshotBuffer.init, maxEntries) with a background thread doing OcrVocabulary.configure + OcrScreenshotBuffer.init + maxEntries, and keep RuWordList.configure synchronous (it's trivial).\n\nActually careful: the debug Log.d line 146-147 should stay or move. It's just logging. Keep it or move into thread. I'll keep it inside the thread.\n\nLet me be surgical. Current block:\n\n```\n146:        android.util.Log.d(\"OcrVocabulary\", \"configure(file=\" +\n147:            java.io.File(filesDir, \"ocr_vocab.txt\").absolutePath + \")\")\n148:        mihon.data.ocr.OcrVocabulary.configure(\n149:            java.io.File(filesDir, \"ocr_vocab.txt\").absolutePath,\n150:        )\n151:\n152:        // Встроенный словарь ...\n156:        mihon.data.ocr.RuWordList.configure(applicationContext)\n157:\n158:        // Буфер скриншотов ...\n160:        mihon.data.ocr.OcrScreenshotBuffer.init(applicationContext)\n161:        // Лимит буфера ...\n162:        mihon.data.ocr.OcrScreenshotBuffer.maxEntries = Injekt.get<...>().screenshotBufferSize().get().coerceIn(10, 200)\n```\n\nNew:\n```\n        // Встроенный словарь ... (trivial lambda, main ok)\n        mihon.data.ocr.RuWordList.configure(applicationContext)\n\n        // Пользовательский словарь и буфер скриншотов читают файлы приложения:\n        // выносим чтение с главного потока, чтобы не задерживать первый кадр.\n        Thread {\n            runCatching {\n                val vocabPath = java.io.File(filesDir, \"ocr_vocab.txt\").absolutePath\n                logcat(LogPriority.DEBUG) { \"OcrVocabulary: configure(file=$vocabPath)\" }\n                mihon.data.ocr.OcrVocabulary.configure(vocabPath)\n                mihon.data.ocr.OcrScreenshotBuffer.init(applicationContext)\n                mihon.data.ocr.OcrScreenshotBuffer.maxEntries = Injekt.get<mihon.domain.ocr.service.OcrPreferences>()\n                    .screenshotBufferSize().get().coerceIn(10, 200)\n            }.onFailure { e ->\n                logcat(LogPriority.WARN, e) { \"OcrVocabulary/OcrScreenshotBuffer: фоновая инициализация не удалась\" }\n            }\n        }.apply { name = \"ocr-persist-init\"; priority = Thread.MIN_PRIORITY }.start()\n```\n\nWait, but is `logcat` imported in App.kt? Yes (lines 58-60). Good.\n\nHmm, but there's a concern: other startup code or UI might call `OcrVocabulary`/`OcrScreenshotBuffer` expecting config done. E.g., Settings screen reads OcrVocabulary.words(). By the time user navigates, thread done. Fine.\n\nBut the debug log earlier was `android.util.Log.d` with tag \"OcrVocabulary\" and message containing \"ОcrVocabulary\"? It logged `configure(file=...)`. I'm changing to logcat DEBUG; that changes log behavior slightly. Actually let me keep the `android.util.Log.d` call but move it into the thread, to not change behavior. Hmm, but logcat is the project's logging. The original used `android.util.Log.d` deliberately perhaps. I'll keep it as-is but inside the thread. Actually simpler to keep exact line. Let me keep `android.util.Log.d` inside the thread.\n\nNow the AppModule change.\n\nLet me apply both edits.\n\nFor AppModule: replace lines 151-160 and remove ContextCompat import.\n\n```kotlin\n        // Asynchronously init expensive components for a faster cold start.\n        // Фоновой поток, а не getMainExecutor(): построение БД, NetworkHelper,\n        // SourceManager (тянет загрузку всех расширений) и DownloadManager на\n        // UI-потоке подвешивало старт библиотеки.\n        Thread {\n            runCatching {\n                get<NetworkHelper>()\n                get<SourceManager>()\n                get<Database>()\n                get<DownloadManager>()\n            }.onFailure { e ->\n                logcat(LogPriority.WARN, e) { \"AppModule: фоновая инициализация компонентов не удалась\" }\n            }\n        }.apply { name = \"app-component-init\"; priority = Thread.MIN_PRIORITY }.start()\n```\n\nNeed imports for logcat and LogPriority in AppModule.kt. Let me add:\n```\nimport logcat.LogPriority\nimport tachiyomi.core.common.util.system.logcat\n```\n\nCheck that AppModule is in module `app` (has access to logcat). App.kt uses `logcat.LogPriority` and `tachiyomi.core.common.util.system.logcat`. Good.\n\nRemove `import androidx.core.content.ContextCompat`.\n\nLet me apply.", "time": {"start": 1791916641558, "end": 1791916652476}, "id": "prt_1368e0d16001vCcemImlqX5hoI", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368dff7f001w6k7ubUsBkRAHB"}, {"type": "text", "text": "`Migrator` уже крутит миграции на `Dispatchers.IO`, а `runBlocking` в MainActivity просто ждёт их — трогать рискованно (целостность БД), оставляю. Исправляю явный баг: «асинхронная» инициализация компонентов идёт на UI-потоке.", "time": {"start": 1791916652480, "end": 1791916654383}, "id": "prt_1368e37c0001vnIKLibYJuS3xp", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368dff7f001w6k7ubUsBkRAHB"}, {"type": "tool", "tool": "edit", "callID": "call_00_j1tf8zco3il1mejxz6xdlauu", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt", "newString": "        // Asynchronously init expensive components for a faster cold start.\n        // Фоновой поток, а не getMainExecutor(): построение БД, NetworkHelper,\n        // SourceManager (тянет загрузку всех расширений) и DownloadManager на\n        // UI-потоке подвешивало старт библиотеки.\n        Thread {\n            runCatching {\n                get<NetworkHelper>()\n\n                get<SourceManager>()\n\n                get<Database>()\n\n                get<DownloadManager>()\n            }.onFailure { e ->\n                logcat(LogPriority.WARN, e) { \"AppModule: фоновая инициализация компонентов не удалась\" }\n            }\n        }.apply { name = \"app-component-init\"; priority = Thread.MIN_PRIORITY }.start()", "oldString": "        // Asynchronously init expensive components for a faster cold start\n        ContextCompat.getMainExecutor(app).execute {\n            get<NetworkHelper>()\n\n            get<SourceManager>()\n\n            get<Database>()\n\n            get<DownloadManager>()\n        }"}, "output": "Edit applied successfully.", "metadata": {"diagnostics": {}, "diff": "Index: /home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt\n===================================================================\n--- /home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt\n+++ /home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt\n@@ -147,16 +147,23 @@\n         addSingletonFactory { LocalSourceFileSystem(get()) }\n         addSingletonFactory { LocalCoverManager(app, get()) }\n         addSingletonFactory { StorageManager(app, get()) }\n \n-        // Asynchronously init expensive components for a faster cold start\n-        ContextCompat.getMainExecutor(app).execute {\n-            get<NetworkHelper>()\n+        // Asynchronously init expensive components for a faster cold start.\n+        // Фоновой поток, а не getMainExecutor(): построение БД, NetworkHelper,\n+        // SourceManager (тянет загрузку всех расширений) и DownloadManager на\n+        // UI-потоке подвешивало старт библиотеки.\n+        Thread {\n+            runCatching {\n+                get<NetworkHelper>()\n \n-            get<SourceManager>()\n+                get<SourceManager>()\n \n-            get<Database>()\n+                get<Database>()\n \n-            get<DownloadManager>()\n-        }\n+                get<DownloadManager>()\n+            }.onFailure { e ->\n+                logcat(LogPriority.WARN, e) { \"AppModule: фоновая инициализация компонентов не удалась\" }\n+            }\n+        }.apply { name = \"app-component-init\"; priority = Thread.MIN_PRIORITY }.start()\n     }\n }\n", "filediff": {"file": "/home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt", "patch": "Index: /home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt\n===================================================================\n--- /home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt\n+++ /home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/di/AppModule.kt\n@@ -147,16 +147,23 @@\n         addSingletonFactory { LocalSourceFileSystem(get()) }\n         addSingletonFactory { LocalCoverManager(app, get()) }\n         addSingletonFactory { StorageManager(app, get()) }\n \n-        // Asynchronously init expensive components for a faster cold start\n-        ContextCompat.getMainExecutor(app).execute {\n-            get<NetworkHelper>()\n+        // Asynchronously init expensive components for a faster cold start.\n+        // Фоновой поток, а не getMainExecutor(): построение БД, NetworkHelper,\n+        // SourceManager (тянет загрузку всех расширений) и DownloadManager на\n+        // UI-потоке подвешивало старт библиотеки.\n+        Thread {\n+            runCatching {\n+                get<NetworkHelper>()\n \n-            get<SourceManager>()\n+                get<SourceManager>()\n \n-            get<Database>()\n+                get<Database>()\n \n-            get<DownloadManager>()\n-        }\n+                get<DownloadManager>()\n+            }.onFailure { e ->\n+                logcat(LogPriority.WARN, e) { \"AppModule: фоновая инициализация компонентов не удалась\" }\n+    