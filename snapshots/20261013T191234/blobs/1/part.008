варь только\n451:      * РАЗРЕШАЕТ вставить границу — сам текст при этом никогда не заменяется.\n452:      * Словарное слово пользователя дополнительно считается в статистику\n453:      * [OcrTextCleanerStats.userDictHits], чтобы индикатор сканирования не\n454:      * «врал», что словарь отработал.\n455:      */\n456:     fun knownWord(word: String): Boolean {\n457:         if (word.isEmpty()) return false\n458:         val up = word.uppercase()\n459:         // Пользовательский словарь проверяется ПЕРВЫМ. Раньше он шёл вторым, и\n460:         // слово, добавленное пользователем, но уже есть во встроенном\n461:         // словаре, не попадало в userDictHits — индикатор сканирования молчал.\n462:         // Приоритет пользовательского словаря отражает его смысл: это слова,\n463:         // которые он задал сам и которым хочет доверять.\n464:         if (OcrVocabulary.isUserWord(up)) {\n465:             OcrTextCleanerStats.userDictHits++\n466:             return true\n467:         }\n468:         return up in RuWordList.upper\n469:     }\n470: \n471:     fun userDictionaryCoverage(text: String): Float {\n472:         if (text.isBlank()) return 0f\n473:         var letters = 0\n474:         var covered = 0\n475:         for (token in text.split(Regex(\"[^\\\\p{L}\\\\p{N}]+\"))) {\n476:             val lexical = token.filter(Char::isLetter)\n477:             if (lexical.count { it.code in CYRILLIC_RANGE } == 0) continue\n478:             letters += lexical.length\n479:             if (OcrVocabulary.isUserWord(lexical)) covered += lexical.length\n480:         }\n481:         if (letters == 0) return 0f\n482:         return covered.toFloat() / letters\n483:     }\n484: \n485:     /**\n486:      * Доля букв кириллического текста, попавших в известные словарям слова\n487:      * (встроенный [RuWordList] + пользовательский [OcrVocabulary]).\n488:      *\n489:      * Нужна [CyrillicOcrEngine] для ранжирования кандидатов v3/v5: из двух\n490:      * гипотез с близкой уверенностью предпочтительнее та, чьи слова реально\n491:      * существуют у пользователя. Чистая латынь и звукоподражания не считаются.\n492:      */\n493:     fun dictionaryCoverage(text: String): Float {\n494:         if (text.isBlank()) return 0f\n495:         var letters = 0\n496:         var covered = 0\n497:         for (token in text.split(Regex(\"[^\\\\p{L}\\\\p{N}]+\"))) {\n498:             val lexical = token.filter(Char::isLetter)\n499:             val cyrillicCount = lexical.count { it.code in CYRILLIC_RANGE }\n\n(Showing lines 440-499 of 585. Use offset=500 to continue.)\n</content>", "metadata": {"preview": "        val stub = segments.any { it.length < MIN_SEGMENT_LETTERS && !RuMorph.isFunctionWord(it) }\n        if (stub) return false\n        return segments.zipWithNext().all { (left, right) ->\n            RuMorph.isFunctionWord(left) || RuMorph.isFunctionWord(right)\n        }\n\n    }\n\n    /**\n     * Правда, если слово есть во встроенном частотном словаре [RuWordList]\n     * ИЛИ в пользовательском словаре OCR ([OcrVocabulary]). Словарь только\n     * РАЗРЕШАЕТ вставить границу — сам текст при этом никогда не заменяется.\n     * Словарное слово пользователя дополнительно считается в статистику\n     * [OcrTextCleanerStats.userDictHits], чтобы индикатор сканирования не\n     * «врал», что словарь отработал.\n     */\n    fun knownWord(word: String): Boolean {\n        if (word.isEmpty()) return false\n        val up = word.uppercase()\n        // Пользовательский словарь проверяется ПЕРВЫМ. Раньше он шёл вторым, и", "truncated": true, "loaded": [], "display": {"type": "file", "path": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt", "text": "        val stub = segments.any { it.length < MIN_SEGMENT_LETTERS && !RuMorph.isFunctionWord(it) }\n        if (stub) return false\n        return segments.zipWithNext().all { (left, right) ->\n            RuMorph.isFunctionWord(left) || RuMorph.isFunctionWord(right)\n        }\n\n    }\n\n    /**\n     * Правда, если слово есть во встроенном частотном словаре [RuWordList]\n     * ИЛИ в пользовательском словаре OCR ([OcrVocabulary]). Словарь только\n     * РАЗРЕШАЕТ вставить границу — сам текст при этом никогда не заменяется.\n     * Словарное слово пользователя дополнительно считается в статистику\n     * [OcrTextCleanerStats.userDictHits], чтобы индикатор сканирования не\n     * «врал», что словарь отработал.\n     */\n    fun knownWord(word: String): Boolean {\n        if (word.isEmpty()) return false\n        val up = word.uppercase()\n        // Пользовательский словарь проверяется ПЕРВЫМ. Раньше он шёл вторым, и\n        // слово, добавленное пользователем, но уже есть во встроенном\n        // словаре, не попадало в userDictHits — индикатор сканирования молчал.\n        // Приоритет пользовательского словаря отражает его смысл: это слова,\n        // которые он задал сам и которым хочет доверять.\n        if (OcrVocabulary.isUserWord(up)) {\n            OcrTextCleanerStats.userDictHits++\n            return true\n        }\n        return up in RuWordList.upper\n    }\n\n    fun userDictionaryCoverage(text: String): Float {\n        if (text.isBlank()) return 0f\n        var letters = 0\n        var covered = 0\n        for (token in text.split(Regex(\"[^\\\\p{L}\\\\p{N}]+\"))) {\n            val lexical = token.filter(Char::isLetter)\n            if (lexical.count { it.code in CYRILLIC_RANGE } == 0) continue\n            letters += lexical.length\n            if (OcrVocabulary.isUserWord(lexical)) covered += lexical.length\n        }\n        if (letters == 0) return 0f\n        return covered.toFloat() / letters\n    }\n\n    /**\n     * Доля букв кириллического текста, попавших в известные словарям слова\n     * (встроенный [RuWordList] + пользовательский [OcrVocabulary]).\n     *\n     * Нужна [CyrillicOcrEngine] для ранжирования кандидатов v3/v5: из двух\n     * гипотез с близкой уверенностью предпочтительнее та, чьи слова реально\n     * существуют у пользователя. Чистая латынь и звукоподражания не считаются.\n     */\n    fun dictionaryCoverage(text: String): Float {\n        if (text.isBlank()) return 0f\n        var letters = 0\n        var covered = 0\n        for (token in text.split(Regex(\"[^\\\\p{L}\\\\p{N}]+\"))) {\n            val lexical = token.filter(Char::isLetter)\n            val cyrillicCount = lexical.count { it.code in CYRILLIC_RANGE }", "lineStart": 440, "lineEnd": 499, "totalLines": 585, "truncated": true}}, "title": "data/src/main/java/mihon/data/ocr/OcrTextCleaner.kt", "time": {"start": 1791916084305, "end": 1791916084409}}, "id": "prt_136858b1e001UtfiQEYAPgvB1j", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136857d77001Dn9xDgYJ4J2CNi"}, {"type": "tool", "tool": "read", "callID": "call_01_yhx1j9eryo8pyax71u1yvc7l", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "offset": 120, "limit": 40}, "output": "<path>/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt</path>\n<type>file</type>\n<content>\n120:         }\n121:     }\n122: \n123:     fun size(): Int = lock.read { upper.size }\n124: \n125:     fun words(): List<String> = lock.read { lower.toList().sorted() }\n126: \n127:     /** Правда, если слово есть в пользовательском словаре (без учёта регистра). */\n128:     fun isUserWord(word: String): Boolean {\n129:         if (word.isEmpty()) return false\n130:         return lock.read { upper.contains(word.uppercase()) }\n131:     }\n132: \n133:     /** Правда, если слово есть в пользовательском словаре ИЛИ в [RuWordList]. */\n134:     fun isKnownWord(word: String): Boolean {\n135:         if (word.isEmpty()) return false\n136:         val up = word.uppercase()\n137:         if (up in RuWordList.upper) return true\n138:         return lock.read { upper.contains(up) }\n139:     }\n140: \n141:     private fun persistLocked() {\n142:         val active = file ?: return\n143:         runCatching {\n144:             val parent = active.parentFile\n145:             if (parent != null && !parent.exists()) parent.mkdirs()\n146:             // Атомарная замена: пишем во временный файл, затем переименовываем.\n147:             // Это защищает от «оборванной» записи при случайном падении процесса.\n148:             val tmp = File(active.parentFile, active.name + \".tmp\")\n149:             tmp.writeText(lower.joinToString(\"\\n\", postfix = \"\\n\"))\n150:             val renamed = tmp.renameTo(active)\n151:             if (!renamed) {\n152:                 // На некоторых ФС renameTo поверх существующего не срабатывает:\n153:                 // пишем напрямую и убираем временный файл.\n154:                 active.writeText(lower.joinToString(\"\\n\", postfix = \"\\n\"))\n155:                 tmp.delete()\n156:             }\n157:         }\n158:     }\n159: }\n\n(End of file - total 159 lines)\n</content>", "metadata": {"preview": "        }\n    }\n\n    fun size(): Int = lock.read { upper.size }\n\n    fun words(): List<String> = lock.read { lower.toList().sorted() }\n\n    /** Правда, если слово есть в пользовательском словаре (без учёта регистра). */\n    fun isUserWord(word: String): Boolean {\n        if (word.isEmpty()) return false\n        return lock.read { upper.contains(word.uppercase()) }\n    }\n\n    /** Правда, если слово есть в пользовательском словаре ИЛИ в [RuWordList]. */\n    fun isKnownWord(word: String): Boolean {\n        if (word.isEmpty()) return false\n        val up = word.uppercase()\n        if (up in RuWordList.upper) return true\n        return lock.read { upper.contains(up) }\n    }", "truncated": false, "loaded": [], "display": {"type": "file", "path": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "text": "        }\n    }\n\n    fun size(): Int = lock.read { upper.size }\n\n    fun words(): List<String> = lock.read { lower.toList().sorted() }\n\n    /** Правда, если слово есть в пользовательском словаре (без учёта регистра). */\n    fun isUserWord(word: String): Boolean {\n        if (word.isEmpty()) return false\n        return lock.read { upper.contains(word.uppercase()) }\n    }\n\n    /** Правда, если слово есть в пользовательском словаре ИЛИ в [RuWordList]. */\n    fun isKnownWord(word: String): Boolean {\n        if (word.isEmpty()) return false\n        val up = word.uppercase()\n        if (up in RuWordList.upper) return true\n        return lock.read { upper.contains(up) }\n    }\n\n    private fun persistLocked() {\n        val active = file ?: return\n        runCatching {\n            val parent = active.parentFile\n            if (parent != null && !parent.exists()) parent.mkdirs()\n            // Атомарная замена: пишем во временный файл, затем переименовываем.\n            // Это защищает от «оборванной» записи при случайном падении процесса.\n            val tmp = File(active.parentFile, active.name + \".tmp\")\n            tmp.writeText(lower.joinToString(\"\\n\", postfix = \"\\n\"))\n            val renamed = tmp.renameTo(active)\n            if (!renamed) {\n                // На некоторых ФС renameTo поверх существующего не срабатывает:\n                // пишем напрямую и убираем временный файл.\n                active.writeText(lower.joinToString(\"\\n\", postfix = \"\\n\"))\n                tmp.delete()\n            }\n        }\n    }\n}", "lineStart": 120, "lineEnd": 159, "totalLines": 159, "truncated": false}}, "title": "data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "time": {"start": 1791916084617, "end": 1791916085052}}, "id": "prt_136858c55001AYfiXPIfxJmegX", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_136857d77001Dn9xDgYJ4J2CNi"}, {"type": "tool", "tool": "read", "callID": "call_02_qsi8fpoi27l7j1wh91qdbdls", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/data/src/test/java