     [38;5;216m- [38;5;114misAcceptableCyrillicOcrText()[38;5;255m — [38;5;114mOcrTextCleaner.kt:297[38;5;255m — [38;5;15m        
       [38;5;255mпроверяет [1m[38;5;215mалфавит[0m[38;5;255m[48;5;232m (кириллица против латиницы), а не [38;5;15m            
       [38;5;255mосмысленность[38;5;15m                                                   
                                                                       
     [38;5;255mПоэтому [38;5;114mХ[38;5;255m, [38;5;114mК[38;5;255m, [38;5;114mээ[38;5;255m, [38;5;114mНебниня[38;5;255m, [38;5;114mтій[38;5;255m проходят всё: это валидные буквы [38;5;15m  
