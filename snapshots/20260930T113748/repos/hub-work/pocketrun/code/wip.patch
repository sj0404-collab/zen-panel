+        var total = 0L
+        while (true) {
+            val read = input.read(buffer)
+            if (read <= 0) break
+            total += read
+            if (total > MAX_IMPORT_BYTES) throw IOException("файл больше ${FileText.human(MAX_IMPORT_BYTES)}")
+            out.write(buffer, 0, read)
+        }
