- */
-fun List<GlossaryNode>.collectText(): String {
-    val builder = StringBuilder()
-    forEach { node -> builder.appendNodeText(node) }
-    return builder.toString().replace("\n", " ").replace("\\s+".toRegex(), " ").trim()
