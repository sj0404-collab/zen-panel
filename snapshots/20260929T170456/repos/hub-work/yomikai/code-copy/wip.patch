-                    Preference.PreferenceItem.ListPreference(
-                        preference = prefs.voiceName(),
-                        entries = remember(prefs, effectivePlugin) {
-                            VoicePlugins.voices(
-                                context = context,
-                                plugin = VoicePlugins.current(prefs),
-                                prefs = prefs,
-                            ).associate { it.id to it.name }
-                        },
