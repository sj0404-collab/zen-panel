-fun UpdateScreen(
-    state: UpdatesScreenModel.State,
-    snackbarHostState: SnackbarHostState,
-    lastUpdated: Long,
-    onClickCover: (UpdatesItem) -> Unit,
-    onSelectAll: (Boolean) -> Unit,
