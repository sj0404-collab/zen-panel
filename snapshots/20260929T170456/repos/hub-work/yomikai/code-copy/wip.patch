-        val effectivePlugin = remember(voiceEngine, phoneOnly, prefs) { VoicePlugins.current(prefs) }
-
-        val online = rememberNetworkState(context)
-        val available = remember(online, prefs, effectivePlugin) {
-            VoicePlugins.available(
