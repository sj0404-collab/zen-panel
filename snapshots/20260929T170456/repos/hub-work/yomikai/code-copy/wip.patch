-        }
-
-        if (!shouldCleanup) {
-            return
-        }
-
-        try {
-            closeEngines()
-            cacheStore.close()
-            logcat(LogPriority.INFO) { "OcrRepositoryImpl cleaned up successfully" }
-        } catch (e: Exception) {
-            logcat(LogPriority.ERROR, e) { "Error cleaning up OcrRepositoryImpl" }
-        }
-    }
