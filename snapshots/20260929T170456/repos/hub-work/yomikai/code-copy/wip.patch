-        val sharedPkg = try {
-            context.packageManager.getPackageInfo(pkgName, PACKAGE_FLAGS)
-                .takeIf { isPackageAnExtension(it) }
-                ?.let {
-                    ExtensionInfo(
-                        packageInfo = it,
-                        isShared = true,
-                    )
-                }
