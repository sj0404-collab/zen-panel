-    var refresh by remember { mutableStateOf(0) }
-
-    /** Пак моделей, который нужен движку (null = скачивать нечего). */
-    fun packOf(model: OcrModel): String? = when (model) {
-        OcrModel.CYRILLIC -> "cyrillic_ocr"
