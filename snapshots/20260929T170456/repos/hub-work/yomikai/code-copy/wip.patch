-            cyrillicEngine?.close()
-            cyrillicEngine = null
-
-            mlKitEngine?.close()
-            mlKitEngine = null
-
-            legacyEngine?.close()
-            legacyEngine = null
-
-            fastEngine?.close()
-            fastEngine = null
-
-            glensEngine?.close()
-            glensEngine = null
-
-            owOcrEngine?.close()
-            owOcrEngine = null
-
-            openRouterEngine?.close()
-            openRouterEngine = null
-
-            googleAiEngine?.close()
-            googleAiEngine = null
-
-            zenFreeEngine?.close()
