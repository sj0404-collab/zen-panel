-                val ok = ocrChapterScanner.scanChapter(
-                    chapterId = chapter.id,
-                    onProgress = { p ->
-                        _chapterAutoRead.value = _chapterAutoRead.value.copy(
-                            running = true,
-                            processed = p.processedPages,
-                            total = p.totalPages,
-                            title = p.chapterName,
