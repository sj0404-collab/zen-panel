-        val chapterIds = ocrScanManager.queueState.value.entries.map(OcrScanQueueEntry::chapterId)
-        if (chapterId !in chapterIds) {
-            return
-        }
-
-        val seriesIds = resolveSeriesIds(chapterIds, chapterId)
