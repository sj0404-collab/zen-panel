-                LazyColumn(
-                    modifier = modifier.fillMaxSize(),
-                    state = listState,
-                    contentPadding = contentPadding,
-                    horizontalAlignment = Alignment.CenterHorizontally,
-                ) {
-                    items(
-                        items = it,
-                        key = { i -> i.hashCode() },
-                    ) { item ->
-                        Column(
-                            modifier = Modifier
-                                .fillMaxWidth()
-                                .clickable { onItemClick(item) }
-                                .padding(horizontal = 24.dp, vertical = 14.dp),
