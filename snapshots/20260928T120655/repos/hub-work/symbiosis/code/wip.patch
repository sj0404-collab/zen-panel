   if (FILTER === 'mod') list = list.filter(g => (g.addons||[]).some(a => a && a.enabled !== false));
   if (FILTER === 'fresh') list = list.filter(g => !g.playSeconds && !g.lastPlayed);
-  list.sort((a,b) => {
-    if (SORT === 'recent') return (b.lastPlayed||0) - (a.lastPlayed||0) || (a.title||'').localeCompare(b.title||'','ru');
-    if (SORT === 'play') return (b.playSeconds||0) - (a.playSeconds||0) || (a.title||'').localeCompare(b.title||'','ru');
-    return (a.title||'').localeCompare(b.title||'','ru');
-  });
-  return list;
+  return sortGames(list);
+}
+
+// «Лаунчер»: вся библиотека, всегда.
+//
+// Раньше здесь стоял visibleGames(), и вкладка «Список» могла урезать
+// карусель до одной игры: остальные становились недоступны для запуска из
+// лаунчера, а «не прокручивается» выглядело как «их тут нет».
+function railGames() {
+  return sortGames(GAMES.slice());
 }
 
 function progressOf(g) {
@@ -751,7 +767,7 @@ function openShots(g) {
 function renderLauncher() {
   const rail = $('rail'), dock = $('dock');
   if (!rail || !dock) return;
