+  RAIL_LIST = railGames();
   if (!RAIL_LIST.length) {
     rail.innerHTML = '';
     dock.innerHTML = '<div class="empty">нет игр — откройте Список и добавьте папку</div>';
@@ -831,6 +847,7 @@ function paintDock() {
     <div class="dock-head">
       <h2>${esc(g.title || 'без имени')}</h2>
