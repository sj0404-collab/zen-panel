+@Composable
+fun SliderRow(
+    label: String,
+    value: Int,
+    range: IntRange,
+    steps: Int = 0,
+    suffix: String = "",
+    onChange: (Int) -> Unit
+) {
+    Column(Modifier.fillMaxWidth().padding(vertical = 2.dp)) {
