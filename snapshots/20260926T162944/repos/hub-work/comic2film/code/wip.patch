+    private fun previewSize(): Pair<Int, Int> {
+        val (w, h) = Timeline.resolveSize(settings.res, project.pages)
+        val k = min(1.0, 640.0 / maxOf(w, h))
+        val pw = ((w * k).toInt() / 2 * 2).coerceAtLeast(2)
+        val ph = ((h * k).toInt() / 2 * 2).coerceAtLeast(2)
+        return pw to ph
+    }
