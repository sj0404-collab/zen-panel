+    /** Часы прогресса озвучивания: подсветка блока i по мере чтения текста. */
+    private fun startSpeakClock(text: String) {
+        ui.removeCallbacks(speakTick)
+        val n = layoutBlocks.size
+        if (n <= 0) {
+            activeBlock = -1
+            refreshFrame()
+            return
+        }
+        val rate = prefs.getFloat("rate", 1.0f).coerceAtLeast(0.25f)
+        speakTotalMs = ((text.length * 1000L) / (16L * rate)).coerceAtLeast(1500L)
+        speakStartMs = SystemClock.elapsedRealtime()
+        activeBlock = 0
+        refreshFrame()
+        ui.postDelayed(speakTick, 400L)
+    }
+
+    private fun tickSpeak() {
+        if (layoutBlocks.isEmpty() || !speaking) {
+            stopSpeakClock()
+            return
+        }
+        val f = (SystemClock.elapsedRealtime() - speakStartMs).toFloat() / speakTotalMs
+        val n = layoutBlocks.size
+        val idx = (f * n).toInt().coerceIn(0, n - 1)
+        if (idx != activeBlock) {
+            activeBlock = idx
+            refreshFrame()
+        }
+        if (f < 1f) ui.postDelayed(speakTick, 400L) else stopSpeakClock()
+    }
+
+    private fun stopSpeakClock() {
+        ui.removeCallbacks(speakTick)
+    }
