+    /** ML Kit: блоки текста на битмапе → координаты экрана, порядок чтения. */
+    private fun computeLayout(bmp: Bitmap): List<Rect> {
+        if (layoutOcr == null) {
+            layoutOcr = try { LayoutOcr() } catch (e: Throwable) { null }
+        }
+        val lo = layoutOcr
+        if (lo == null || !lo.isAvailable) return emptyList()
+        val r = regionRatio()
+        val w = bmp.width.toFloat().coerceAtLeast(1f)
+        val h = bmp.height.toFloat().coerceAtLeast(1f)
+        val rw = (r.right - r.left)
+        val rh = (r.bottom - r.top)
+        val mapped = try {
+            lo.blocks(bmp).map { b ->
+                val bx = b.rect
+                Rect(
+                    r.left + (bx.left / w * rw).toInt(),
+                    r.top + (bx.top / h * rh).toInt(),
+                    r.left + (bx.right / w * rw).toInt(),
+                    r.top + (bx.bottom / h * rh).toInt()
+                )
+            }
+        } catch (e: Throwable) {
+            emptyList()
+        }
+        return ReadingOrder.order(mapped, readOrderMode())
+    }
+
