+
+    private fun parseStage(tokens: List<String>, dir: File): Stage {
+        val kept = mutableListOf<String>()
+        var output: File? = null
+        var append = false
+        var input: File? = null
+        var i = 0
+        while (i < tokens.size) {
+            val t = tokens[i]
+            when {
+                t == ">" || t == ">>" -> {
+                    val target = tokens.getOrNull(i + 1)
+                        ?: return Stage(kept, null, false, null, "bash: $t: нужен файл\n")
+                    val file = sandboxPath(target, dir)
+                        ?: return Stage(kept, null, false, null, "bash: $target: путь вне песочницы\n")
+                    output = file
+                    append = t == ">>"
+                    i++
+                }
+                t == "<" -> {
+                    val target = tokens.getOrNull(i + 1)
+                        ?: return Stage(kept, null, false, null, "bash: <: нужен файл\n")
+                    val file = sandboxPath(target, dir)
+                        ?: return Stage(kept, null, false, null, "bash: $target: путь вне песочницы\n")
+                    input = file
+                    i++
+                }
+                else -> kept += t
+            }
+            i++
+        }
+        return Stage(kept, output, append, input, null)
+    }
+
+    /** Splits on top-level `|`, honouring quotes. */
+    private fun splitPipes(segment: String): List<String> {
+        val stages = mutableListOf<String>()
+        val cur = StringBuilder()
+        var quote: Char? = null
+        var i = 0
+        while (i < segment.length) {
+            val c = segment[i]
+            when {
+                quote != null -> { cur.append(c); if (c == quote) quote = null }
+                c == '"' || c == '\'' -> { quote = c; cur.append(c) }
+                // A single `&` in the background is not supported; treating it as
+                // a literal keeps `a & b` from silently meaning something else.
+                c == '|' -> {
+                    stages += cur.toString().trim()
+                    cur.clear()
+                }
+                else -> cur.append(c)
+            }
+            i++
+        }
+        stages += cur.toString().trim()
+        return stages.filter { it.isNotEmpty() }
     }
 
