[38;5;15m[48;5;232m     [38;5;255m01:25:16 Запуск уже идёт, но адрес хаб ещё не сообщил (или он [38;5;15m    
     [38;5;255mуже выключен)[38;5;15m                                                     
                                                                       
     [38;5;255mПри этом карточка «Последние запуски» показывала [1m[38;5;215mNPM Hub #385 — [0m[38;5;15m[48;5;232m  
     [1m[38;5;215mидёт 5 ч 33 мин[0m[38;5;255m[48;5;232m. То есть ран GitHub [1m[38;5;215mжив[0m[38;5;255m[48;5;232m, а панель подключиться [38;5;15m   
     [38;5;255mне может. Пользователь залип в ручном цикле: «Запустить хаб» → [38;5;15m   
     [38;5;255m«Хаб уже запущен» → «туннель мёртв» → тупик, надо жать [38;5;15m           
     [38;5;255m«Остановить и перезапустить ранер» вручную.[38;5;15m                       
                                                                       
     [1m[38;5;215mПричина (нашёл в [38;5;114mhub/src/main/assets/hub/index.html[38;5;215m):[0m[38;5;15m[48;5;232m             
                                                                       
     [38;5;114mtryOpenLive()[38;5;255m (строка 541) читает файл сессии [1m[38;5;215mтолько[0m[38;5;255m[48;5;232m через [38;5;15m       
     [38;5;114mreadHubSessionRaw()[38;5;255m — это [38;5;114mraw.githubusercontent.com[38;5;255m, CDN- edge [38;5;15m   
     [38;5;255mс копией, отстающей на минуты. В коде самом это признано в [38;5;15m       
     [38;5;255mкомментарии на строках 629-634, и [38;5;114mwaitForHub[38;5;255m (строка 639) после [38;5;15m  
     [38;5;255m3 устаревших чтений переключается на авторизованный REST API. [1m[38;5;215mА [0m[38;5;15m[48;5;232m  
     [1m[38;5;114mtryOpenLive[38;5;215m такого переключения не имеет.[0m[38;5;255m[48;5;232m Итог:[38;5;15m                   
                                                                       
     [38;5;216m- [38;5;255mпрочитал устаревший [38;5;114mstate: ended[38;5;255m → печатает ровно ту строку [38;5;15m    
       [38;5;255mот 01:25:16 → [38;5;114mreturn false[38;5;255m;[38;5;15m                                     
     [38;5;216m- [38;5;255mпрочитал устаревший [38;5;114mstate: live[38;5;255m со старым мёртвым ngrok → [38;5;15m      
       [38;5;255m«туннель мёртв» (строка 557) → [38;5;114mreturn false[38;5;255m.[38;5;15m                    
                                                                       
     [38;5;255mАвтоматического действия нет вообще — хотя [38;5;114mrestartRunner[38;5;255m ([38;5;15m        
     [38;5;255mстрока 573) и [38;5;114mcancelAndWait[38;5;255m (строка 527) лежат на той же [38;5;15m         
     [38;5;255mстранице. Более того [38;5;114mrestartRunner[38;5;255m вообще нигде не вызывается ([38;5;15m   
     [38;5;255mмёртвый код), а реальный рестарт продублирован инлайном на [38;5;15m       
     [38;5;255mстроках 986-998.[38;5;15m                                                  
                                                                       
     [1m[38;5;215mГлавная находка:[0m[38;5;255m[48;5;232m на раннере уже есть готовый канал починки — [38;5;15m     
     [38;5;114mtools/hub_control.sh[38;5;255m слушает очередь [38;5;114mcontrol/queue.json[38;5;255m на [38;5;15m       
     [38;5;255mветке [38;5;114msession-state[38;5;255m и умеет [38;5;114mreopen-tunnel[38;5;255m (строка 119): убивает [38;5;15m  
     [38;5;255mcloudflared, открывает новый туннель и [1m[38;5;215mпубликует новый адрес [0m[38;5;15m[48;5;232m     
     [1m[38;5;215mсессии[0m[38;5;255m[48;5;232m. Панель про [38;5;114mcontrol/[38;5;255m не знает вообще — [38;5;114mgrep[38;5;255m даёт 0 [38;5;15m        
     [38;5;255mсовпадений. Один PUT в очередь чинит мёртвый туннель на живом [38;5;15m    
     [38;5;255mране, не убивая его.[38;5;15m                                              
                                                                       
     [1m[38;5;215mЕщё баги:[0m[38;5;255m[48;5;232m [38;5;114mopenLast()[38;5;255m (строка 858) не перечитывает файл сессии [38;5;15m    
     [38;5;255mвовсе, поэтому кнопка «Открыть последний» самовосстановиться не [38;5;15m  
     [38;5;255mможет. [38;5;114mopenSlot[38;5;255m (строка 1302) передаёт в [38;5;114mdescribeBaseFailure[38;5;255m [38;5;15m     
     [38;5;255mзаведомо пустой [38;5;114mzt[38;5;255m ([38;5;114mhubCandidates[38;5;255m всегда кончается пустыми [38;5;15m       
     [38;5;255mворотами), поэтому диагноз «нет токена запуска» выводится [38;5;15m        
     [1m[38;5;215mвсегда[0m[38;5;255m[48;5;232m, даже когда настоящая причина — мёртвый туннель.[38;5;15m           
                                                                       
