+      : '▦'}</div>
+    <div class="grow">
+      <div class="name">${esc(a.label)}</div>
+      <div class="meta">${esc(a.pkg || '')}</div>
+    </div>
+  </div>`).join('');
+}
+// The list is filtered on every keystroke, so a tap has to find the app in the
+// filtered view rather than in the original array.
+function appsOpen(i) {
+  const a = appsFilter()[i];
+  if (!a || !a.pkg) return;
+  try {
+    ZenBridge.launchApp(a.pkg);
+  } catch (e) {
+    alert('Не открылось: ' + (e.message || e));
+  }
+}
