+    return;
+  }
+  appsRender();
+}
+function appsFilter() {
+  const q = String(($('apps-q') && $('apps-q').value) || '').trim().toLowerCase();
+  const all = APPS || [];
+  if (!q) return all;
+  return all.filter(a => a.label.toLowerCase().indexOf(q) >= 0
+    || String(a.pkg || '').toLowerCase().indexOf(q) >= 0);
+}
+function appsRender() {
+  const box = $('apps-list');
+  if (!box || !APPS) return;
+  const list = appsFilter();
+  if (!list.length) {
+    box.innerHTML = '<span class="note">' + (APPS.length ? 'Ничего не подходит.' : 'Ничего не найдено.') + '</span>';
+    return;
+  }
