+let APPS = null;
+function appsLoad() {
+  const box = $('apps-list');
+  if (typeof ZenBridge === 'undefined' || !ZenBridge.listApps) {
+    if (box) box.innerHTML = '<span class="note">Список есть только в APK-оболочке. В браузере этой вкладки не будет.</span>';
