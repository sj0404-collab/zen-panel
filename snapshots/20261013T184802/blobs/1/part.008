н-движок, и его пак (~21 МБ, 5 файлов)\n358:  * лежит вне APK и скачивается один раз. Зовётся из MainActivity после того,\n359:  * как спросили разрешение POST_NOTIFICATIONS: раньше загрузка стартовала в\n360:  * Application.onCreate, раньше диалога разрешения, и весь её прогресс (~21 МБ\n361:  * пятью файлами) был не виден — уведомления уходили в пустоту.\n362:  * Сбой не фатален: повторить можно из настроек распознавания текста.\n363:  */\n364: fun ensureOcrModelsInstalled() {\n365:     Thread {\n366:         runCatching {\n367:             val ocrPrefs = Injekt.get<mihon.domain.ocr.service.OcrPreferences>()\n368:             if (\n369:                 ocrPrefs.ocrModel().get() in setOf(\n370:                     mihon.domain.ocr.model.OcrModel.LEGACY,\n371:                     mihon.domain.ocr.model.OcrModel.FAST,\n372:                     mihon.domain.ocr.model.OcrModel.TESSERACT,\n373:                 )\n374:             ) {\n375:                 // Старые значения — алиасы кириллицы; выбираем её явно.\n376:                 ocrPrefs.ocrModel().set(mihon.domain.ocr.model.OcrModel.CYRILLIC)\n377:             }\n378:             val downloader = eu.kanade.tachiyomi.data.ocr.OcrModelDownloader\n379:             if (!downloader.isPackInstalled(applicationContext, \"cyrillic_ocr\")) {\n380:                 downloader.downloadPack(applicationContext, \"cyrillic_ocr\")\n381:             }\n382:         }\n383:     }.apply { name = \"cyrillic-ocr-init\"; priority = Thread.MIN_PRIORITY }.start()\n384: }\n385: \n386:     private fun setupNotificationChannels() {\n387:         try {\n388:             Notifications.createChannels(this)\n389:         } catch (e: Exception) {\n\n(Showing lines 350-389 of 422. Use offset=390 to continue.)\n</content>", "metadata": {"preview": "        } catch (_: Exception) {\n        }\n\n        return super.getPackageName()\n    }\n\n    /**\n * Кириллический PP-OCR — единственный офлайн-движок, и его пак (~21 МБ, 5 файлов)\n * лежит вне APK и скачивается один раз. Зовётся из MainActivity после того,\n * как спросили разрешение POST_NOTIFICATIONS: раньше загрузка стартовала в\n * Application.onCreate, раньше диалога разрешения, и весь её прогресс (~21 МБ\n * пятью файлами) был не виден — уведомления уходили в пустоту.\n * Сбой не фатален: повторить можно из настроек распознавания текста.\n */\nfun ensureOcrModelsInstalled() {\n    Thread {\n        runCatching {\n            val ocrPrefs = Injekt.get<mihon.domain.ocr.service.OcrPreferences>()\n            if (\n                ocrPrefs.ocrModel().get() in setOf(", "truncated": true, "loaded": [], "display": {"type": "file", "path": "/home/runner/hub-work/yomikai/code/app/src/main/java/eu/kanade/tachiyomi/App.kt", "text": "        } catch (_: Exception) {\n        }\n\n        return super.getPackageName()\n    }\n\n    /**\n * Кириллический PP-OCR — единственный офлайн-движок, и его пак (~21 МБ, 5 файлов)\n * лежит вне APK и скачивается один раз. Зовётся из MainActivity после того,\n * как спросили разрешение POST_NOTIFICATIONS: раньше загрузка стартовала в\n * Application.onCreate, раньше диалога разрешения, и весь её прогресс (~21 МБ\n * пятью файлами) был не виден — уведомления уходили в пустоту.\n * Сбой не фатален: повторить можно из настроек распознавания текста.\n */\nfun ensureOcrModelsInstalled() {\n    Thread {\n        runCatching {\n            val ocrPrefs = Injekt.get<mihon.domain.ocr.service.OcrPreferences>()\n            if (\n                ocrPrefs.ocrModel().get() in setOf(\n                    mihon.domain.ocr.model.OcrModel.LEGACY,\n                    mihon.domain.ocr.model.OcrModel.FAST,\n                    mihon.domain.ocr.model.OcrModel.TESSERACT,\n                )\n            ) {\n                // Старые значения — алиасы кириллицы; выбираем её явно.\n                ocrPrefs.ocrModel().set(mihon.domain.ocr.model.OcrModel.CYRILLIC)\n            }\n            val downloader = eu.kanade.tachiyomi.data.ocr.OcrModelDownloader\n            if (!downloader.isPackInstalled(applicationContext, \"cyrillic_ocr\")) {\n                downloader.downloadPack(applicationContext, \"cyrillic_ocr\")\n            }\n        }\n    }.apply { name = \"cyrillic-ocr-init\"; priority = Thread.MIN_PRIORITY }.start()\n}\n\n    private fun setupNotificationChannels() {\n        try {\n            Notifications.createChannels(this)\n        } catch (e: Exception) {", "lineStart": 350, "lineEnd": 389, "totalLines": 422, "truncated": true}}, "title": "app/src/main/java/eu/kanade/tachiyomi/App.kt", "time": {"start": 1791916517146, "end": 1791916517833}}, "id": "prt_1368c2680001Oj0xnwXlL5Ri41", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368bd847001sXpCStjnxWlqSt"}, {"reason": "tool-calls", "snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-finish", "tokens": {"total": 36614, "input": 507, "output": 242, "reasoning": 409, "cache": {"write": 0, "read": 35456}}, "cost": 0, "id": "prt_1368c6daf001i4VzhofXW76yJ6", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368bd847001sXpCStjnxWlqSt"}]}, {"info": {"parentID": "msg_136851e9f001vbQSM6Hp2bsA9j", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/yomikai/code", "root": "/home/runner/hub-work/yomikai/code"}, "cost": 0, "tokens": {"total": 38614, "input": 2583, "output": 144, "reasoning": 47, "cache": {"write": 0, "read": 35840}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1791916537103, "completed": 1791916547592}, "finish": "tool-calls", "id": "msg_1368c750f001EdXyhzp4X8PV7U", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r"}, "parts": [{"snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-start", "id": "prt_1368c863a001wuzJC4Vj35ahod", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368c750f001EdXyhzp4X8PV7U"}, {"type": "reasoning", "text": "Now let me understand OcrVocabulary.configure and OcrScreenshotBuffer.init to see if they do blocking I/O on the main thread.\n\nLet me read OcrVocabulary.configure (top part) and OcrScreenshotBuffer.init.", "time": {"start": 1791916541500, "end": 1791916541507}, "id": "prt_1368c863c001htdgMd04R1rwBP", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368c750f001EdXyhzp4X8PV7U"}, {"type": "tool", "tool": "read", "callID": "call_00_muaxba1fxh2wd6ckw8klv9s4", "state": {"status": "completed", "input": {"filePath": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "limit": 120}, "output": "<path>/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt</path>\n<type>file</type>\n<content>\n1: package mihon.data.ocr\n2: \n3: import java.io.File\n4: import java.util.concurrent.locks.ReentrantReadWriteLock\n5: import kotlin.concurrent.read\n6: import kotlin.concurrent.write\n7: \n8: /**\n9:  * Пользовательский словарь OCR.\n10:  *\n11:  * Слова, добавленные на карточке результата («＋ Словарь»), вручную в\n12:  * настройках или накопленные при считывании глав. Используется вторым\n13:  * источником слов (после встроенного [RuWordList]):\n14:  *  * [OcrTextCleaner.splitGluedRun] разбивает слипшиеся прогоны капса и по\n15:  *    словам пользователя — без этого «имя персонажа» не делилось на слова;\n16:  *  * [CyrillicOcrEngine.candidateQuality] даёт бонус кандидату v3/v5, слова\n17:  *    которого реально есть в словаре, — выбор «читаемого» результата.\n18:  *\n19:  * Это не словарная коррекция: словарь только разбивает/подсвечивает уже\n20:  * распознанное, ничего не подменяя.\n21:  *\n22:  * Хранилище — текстовый файл (UTF-8, одно слово на строку, регистр не\n23:  * важен). Путь задаётся [configure] на старте приложения; без файла словарь\n24:  * живёт в памяти (режим тестов).\n25:  */\n26: object OcrVocabulary {\n27: \n28:     private val lock = ReentrantReadWriteLock()\n29: \n30:     @Volatile\n31:     private var file: File? = null\n32: \n33:     private val lower = HashSet<String>()\n34:     private val upper = HashSet<String>()\n35: \n36:     /** Максимальная длина слова — дольше не бывает осмысленного токена. */\n37:     private const val MAX_WORD_LEN = 48\n38: \n39:     /**\n40:      * Привязывает словарь к файлу и загружает его. null/пустая строка =\n41:      * только оперативная память (тесты). Замена файла очищает словарь.\n42:      */\n43:     fun configure(path: String?) {\n44:         lock.write {\n45:             file = path?.takeIf { it.isNotBlank() }?.let { File(it) }\n46:             lower.clear()\n47:             upper.clear()\n48:             val active = file\n49:             if (active != null && active.exists()) {\n50:                 runCatching {\n51:                     active.useLines { lines ->\n52:                         for (line in lines) {\n53:                             val word = line.trim()\n54:                             if (word.isNotEmpty() && word.length <= MAX_WORD_LEN) {\n55:                                 lower.add(word.lowercase())\n56:                                 upper.add(word.uppercase())\n57:                             }\n58:                         }\n59:                     }\n60:                 }\n61:             }\n62:         }\n63:     }\n64: \n65:     /** Добавляет все буквенно-цифровые токены текста. Возвращает число новых слов. */\n66:     fun addFromText(text: String): Int {\n67:         if (text.isBlank()) return 0\n68:         var added = 0\n69:         lock.write {\n70:             text.split(Regex(\"[^\\\\p{L}\\\\p{N}-]+\"))\n71:                 .map(String::trim)\n72:                 .filter { it.length in 2..MAX_WORD_LEN }\n73:                 .forEach { raw ->\n74:                     // Разрешаем и кириллицу, и латынь, и смешанные токены\n75:                     // («Wi-Fi»), чтобы пользователь мог учить двигатель своим\n76:                     // словам. Пунктуация уже отрезана разбиением.\n77:                     if (upper.add(raw.uppercase())) {\n78:                         lower.add(raw.lowercase())\n79:                         added++\n80:                     }\n81:                 }\n82:             if (added > 0) persistLocked()\n83:         }\n84:         return added\n85:     }\n86: \n87:     /** Добавляет одно слово. Возвращает true, если слово реально добавлено. */\n88:     fun addWord(word: String): Boolean {\n89:         val clean = word.trim()\n90:         if (clean.isEmpty() || clean.length > MAX_WORD_LEN) return false\n91:         lock.write {\n92:             if (upper.add(clean.uppercase())) {\n93:                 lower.add(clean.lowercase())\n94:                 persistLocked()\n95:                 return true\n96:             }\n97:         }\n98:         return false\n99:     }\n100: \n101:     /** Удаляет слово. Возвращает true, если слово было в словаре. */\n102:     fun removeWord(word: String): Boolean {\n103:         val clean = word.trim()\n104:         if (clean.isEmpty()) return false\n105:         lock.write {\n106:             if (upper.remove(clean.uppercase())) {\n107:                 lower.remove(clean.lowercase())\n108:                 persistLocked()\n109:                 return true\n110:             }\n111:         }\n112:         return false\n113:     }\n114: \n115:     fun clear() {\n116:         lock.write {\n117:             lower.clear()\n118:             upper.clear()\n119:             persistLocked()\n120:         }\n\n(Showing lines 1-120 of 159. Use offset=121 to continue.)\n</content>", "metadata": {"preview": "package mihon.data.ocr\n\nimport java.io.File\nimport java.util.concurrent.locks.ReentrantReadWriteLock\nimport kotlin.concurrent.read\nimport kotlin.concurrent.write\n\n/**\n * Пользовательский словарь OCR.\n *\n * Слова, добавленные на карточке результата («＋ Словарь»), вручную в\n * настройках или накопленные при считывании глав. Используется вторым\n * источником слов (после встроенного [RuWordList]):\n *  * [OcrTextCleaner.splitGluedRun] разбивает слипшиеся прогоны капса и по\n *    словам пользователя — без этого «имя персонажа» не делилось на слова;\n *  * [CyrillicOcrEngine.candidateQuality] даёт бонус кандидату v3/v5, слова\n *    которого реально есть в словаре, — выбор «читаемого» результата.\n *\n * Это не словарная коррекция: словарь только разбивает/подсвечивает уже\n * распознанное, ничего не подменяя.", "truncated": true, "loaded": [], "display": {"type": "file", "path": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "text": "package mihon.data.ocr\n\nimport java.io.File\nimport java.util.concurrent.locks.ReentrantReadWriteLock\nimport kotlin.concurrent.read\nimport kotlin.concurrent.write\n\n/**\n * Пользовательский словарь OCR.\n *\n * Слова, добавленные на карточке результата («＋ Словарь»), вручную в\n * настройках или накопленные при считывании глав. Используется вторым\n * источником слов (после встроенного [RuWordList]):\n *  * [OcrTextCleaner.splitGluedRun] разбивает слипшиеся прогоны капса и по\n *    словам пользователя — без этого «имя персонажа» не делилось на слова;\n *  * [CyrillicOcrEngine.candidateQuality] даёт бонус кандидату v3/v5, слова\n *    которого реально есть в словаре, — выбор «читаемого» результата.\n *\n * Это не словарная коррекция: словарь только разбивает/подсвечивает уже\n * распознанное, ничего не подменяя.\n *\n * Хранилище — текстовый файл (UTF-8, одно слово на строку, регистр не\n * важен). Путь задаётся [configure] на старте приложения; без файла словарь\n * живёт в памяти (режим тестов).\n */\nobject OcrVocabulary {\n\n    private val lock = ReentrantReadWriteLock()\n\n    @Volatile\n    private var file: File? = null\n\n    private val lower = HashSet<String>()\n    private val upper = HashSet<String>()\n\n    /** Максимальная длина слова — дольше не бывает осмысленного токена. */\n    private const val MAX_WORD_LEN = 48\n\n    /**\n     * Привязывает словарь к файлу и загружает его. null/пустая строка =\n     * только оперативная память (тесты). Замена файла очищает словарь.\n     */\n    fun configure(path: String?) {\n        lock.write {\n            file = path?.takeIf { it.isNotBlank() }?.let { File(it) }\n            lower.clear()\n            upper.clear()\n            val active = file\n            if (active != null && active.exists()) {\n                runCatching {\n                    active.useLines { lines ->\n                        for (line in lines) {\n                            val word = line.trim()\n                            if (word.isNotEmpty() && word.length <= MAX_WORD_LEN) {\n                                lower.add(word.lowercase())\n                                upper.add(word.uppercase())\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    /** Добавляет все буквенно-цифровые токены текста. Возвращает число новых слов. */\n    fun addFromText(text: String): Int {\n        if (text.isBlank()) return 0\n        var added = 0\n        lock.write {\n            text.split(Regex(\"[^\\\\p{L}\\\\p{N}-]+\"))\n                .map(String::trim)\n                .filter { it.length in 2..MAX_WORD_LEN }\n                .forEach { raw ->\n                    // Разрешаем и кириллицу, и латынь, и смешанные токены\n                    // («Wi-Fi»), чтобы пользователь мог учить двигатель своим\n                    // словам. Пунктуация уже отрезана разбиением.\n                    if (upper.add(raw.uppercase())) {\n                        lower.add(raw.lowercase())\n                        added++\n                    }\n                }\n            if (added > 0) persistLocked()\n        }\n        return added\n    }\n\n    /** Добавляет одно слово. Возвращает true, если слово реально добавлено. */\n    fun addWord(word: String): Boolean {\n        val clean = word.trim()\n        if (clean.isEmpty() || clean.length > MAX_WORD_LEN) return false\n        lock.write {\n            if (upper.add(clean.uppercase())) {\n                lower.add(clean.lowercase())\n                persistLocked()\n                return true\n            }\n        }\n        return false\n    }\n\n    /** Удаляет слово. Возвращает true, если слово было в словаре. */\n    fun removeWord(word: String): Boolean {\n        val clean = word.trim()\n        if (clean.isEmpty()) return false\n        lock.write {\n            if (upper.remove(clean.uppercase())) {\n                lower.remove(clean.lowercase())\n                persistLocked()\n                return true\n            }\n        }\n        return false\n    }\n\n    fun clear() {\n        lock.write {\n            lower.clear()\n            upper.clear()\n            persistLocked()\n        }", "lineStart": 1, "lineEnd": 120, "totalLines": 159, "truncated": true}}, "title": "data/src/main/java/mihon/data/ocr/OcrVocabulary.kt", "time": {"start": 1791916541540, "end": 1791916541659}}, "id": "prt_1368c8645001xbNoc8CIeKJxa7", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368c750f001EdXyhzp4X8PV7U"}, {"type": "tool", "tool": "bash", "callID": "call_01_d8otibia82945zr2cnbqwtus", "state": {"status": "completed", "input": {"command": "cd /home/runner/hub-work/yomikai/code && rg -n \"fun init\" data/src/main/java/mihon/data/ocr/OcrScreenshotBuffer.kt"}, "output": "/bin/bash: line 1: rg: command not found\n", "metadata": {"output": "/bin/bash: line 1: rg: command not found\n", "exit": 127, "truncated": false}, "title": "cd /home/runner/hub-work/yomikai/code && rg -n \"fun init\" data/src/main/java/mihon/data/ocr/OcrScreenshotBuffer.kt", "time": {"start": 1791916541581, "end": 1791916541625}}, "id": "prt_1368c8667001eFXufdHO8S0p10", "sessionID": "ses_ec9cf465fffebOZ3QlKFLFfp4r", "messageID": "msg_1368c750f001EdXyhzp4X8PV7U"}, {"reason": "tool-calls", "snapshot": "192cc822868ba7841b5abf635bc5b9ebd779bb2b", "type": "step-finish", "tokens": {"total": 38614, "input": 2583, "o