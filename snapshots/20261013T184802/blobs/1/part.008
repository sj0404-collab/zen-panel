word.isEmpty()) return false\n458:         val up = word.uppercase()\n459:         // Пользовательский словарь проверяется ПЕРВЫМ. Раньше он шёл вторым, и\n460:         // слово, добавленное пользователем, но уже есть во встроенном\n461:         // словаре, не попадало в userDictHits — индикатор сканирования молчал.\n462:         // Приоритет пользовательского словаря отражает его смысл: это слова,\n463:         // которые он задал сам и которым хочет доверять.\n464:         if (OcrVocabulary.isUserWord(up)) {\n465:             OcrTextCleanerStats.userDictHits++\n466:             return true\n467:         }\n468:         return up in RuWordList.upper\n469:     }\n470: \n471:     fun userDictionaryCoverage(text: String): Float {\n472:         if (text.isBlank()) return 0f\n473:         var letters = 0\n474:         var covered = 0\n475:         for (token in text.split(Regex(\"[^\\\\p{L}\\\\p{N}]+\"))) {\n476:             val lexical = token.filter(Char::isLetter)\n477:             if (lexical.count { it.code in CYRILLIC_RANGE } == 0) continue\n478:             letters += lexical.length\n479:             if (OcrVocabulary.isUserWord(lexical)) covered += lexical.length\n480:         }\n481:         if (letters == 0) return 0f\n482:         return covered.toFloat() / letters\n483:     }\n484: \n485:     /**\n486:      * Доля букв кириллического текста, попавших в известные словарям слова\n487:      * (встроенный [RuWordList] + пользовательский [OcrVocabulary]).\n488:      *\n489:      * Нужна [CyrillicOcrEngine] для ранжирования кандидатов v3/v5: из двух\n490:      * гипотез с близкой уверенностью предпочтительнее та, чьи слова реально\n491:      * существуют у пользователя. Чистая латынь и звукоподражания не считаются.\n492:      */\n493:     fun dictionaryCoverage(text: String): Float {\n494:         if (text.isBlank()) return 0f\n495:         var letters = 0\n496:         var covered = 0\n497:         for (token in text.split(Regex(\"[^\\\\p{L}\\\\p{N}]+\"))) {\n498