з UI иначе писали бы один JSON параллельно и перемешивали байты.\n82:     private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO.limitedParallelism(1))\n83: \n84:     private var persistFile: File? = null\n85:     private var imagesDir: File? = null\n86:     private var initialized = false\n87: \n88:     /** Контекст приложения: удаление копий из галереи идёт через ContentResolver. */\n89:     private var appContext: Context? = null\n90: \n91:     fun init(context: Context) {\n92:         if (initialized) return\n93:         initialized = true\n94:         appContext = context.applicationContext\n95: \n96:         persistFile = File(context.filesDir, FILE_NAME)\n97:         imagesDir = File(context.filesDir, IMAGE_DIR_NAME).apply { mkdirs() }\n98:         load()\n99:     }\n100: \n101:     // ---- Публичные методы ----\n102: \n103:     /**\n104:      * Добавить запись скриншота (текст + регионы ~1-5 KB, плюс необязательный\n105:      * JPEG-кадр [imageJpeg], который пишется файлом и показывается в галерее).\n106:      * Если буфер полон — самая старая запись (и её файл) удаляется.\n107:      *\n108:      * @return Созданная запись.\n109:      */\n110:     /**\n111:      * Добавить запись в буфер.\n112:      *\n113:      * synchronized не лишний: писателей стало два — авточтение пишет кадр за\n114:      * кадром, а кнопка «Скриншот сейчас» добавляет запись из отдельной\n115:      * корутины. Без блокировки оба собирали список от одного и того же\n116:      * состояния, и одна запись молча пропадала.\n117:      *\n118:      * [sourceWidth]/[sourceHeight]/[scanCrop] — геометрия того, какая часть\n119:      * файла страницы попала в кадр: без неё нормализованные координаты\n120:      * [regions] относятся к уменьшенному и обрезанному OCR-битмапу, и в книге\n121:      * по ним нельзя нарисовать ничего. Оставленные значения по умолчанию означают\n122:      * «геометрии нет»: запись читается как раньше, проекция для неё\n123:      * не выполняется.\n124:      */\n125:     @Synchronized\n126:     fun add(\n127:         chapterId: Long,\n128:         pageIndex: Int,\n129:         scrollFraction: Float,\n130:         regions: List<OcrRegion>,\n131:         engineUsed: String,\n132:         imageWidth: Int = 0,\n133:         imageHeight: Int = 0,\n134:         imageJpeg: ByteArray? = null,\n135:         scanRegion: String = \"viewport\",\n136:         sourceWidth: Int = 0,\n137:         sourceHeight: Int = 0,\n138:         scanCrop: SerializableNormalizedRect = SerializableNormalizedRect(),\n139:     ): OcrScreenshotEntry {\n140:         val id = System.currentTimeMillis()\n141:         val serializableRegions = regions.map { SerializableOcrRegion.fromOcrRegion(it) }\n142:         val summaryText = regions.joinToString(\" \") { it.text.trim() }.trim()\n143:         val imagePath = imageJpeg?.let { jpeg ->\n144:             imagesDir?.let { dir ->\n145:                 File(dir, \"$id.jpg\").apply { writeBytes(jpeg) }.absolutePath\n146:             }\n147:         }\n148:         val entry = OcrScreenshotEntry(\n149:             id = id,\n150:             chapterId = chapterId,\n151:             pageIndex = pageIndex,\n152:             scrollFraction = scrollFraction,\n153:             timestamp = id,\n154:             regions = serializableRegions,\n155:             engineUsed = engineUsed,\n156:             summaryText = summaryText,\n157:             imageWidth = imageWidth,\n158:             imageHeight = imageHeight,\n159:             imagePath = imagePath,\n\n(Showing lines 80-159 of 496. Use offset=160 to continue.)\n</content>", "metadata": {"preview": "    // Одно поток-исполнитель: add() из авточтения и clear()/clearChapter()\n    // из UI иначе писали бы один JSON параллельно и перемешивали байты.\n    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO.limitedParallelism(1))\n\n    private var persistFile: File? = null\n    private var imagesDir: File? = null\n    private var initialized = false\n\n    /** Контекст приложения: удаление копий из галереи идёт через ContentResolver. */\n    private var appContext: Context? = null\n\n    fun init(context: Context) {\n        if (initialized) return\n        initialized = true\n        appContext = context.applicationContext\n\n        persistFile = File(context.filesDir, FILE_NAME)\n        imagesDir = File(context.filesDir, IMAGE_DIR_NAME).apply { mkdirs() }\n        load()\n    }", "truncated": true, "loaded": [], "display": {"type": "file", "path": "/home/runner/hub-work/yomikai/code/data/src/main/java/mihon/data/ocr/OcrScreenshotBuffer.kt", "text": "    // Одно поток-исполнитель: add() из авточтения и clear()/clearChapter()\n    // из UI иначе писали бы один JSON параллельно и перемешивали байты.\n    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO.limitedParallelism(1))\n\n    private var persistFile: File? = null\n    private var imagesDir: File? = null\n    private var initialized = false\n\n    /** Контекст приложения: удаление копий из галереи идёт через ContentResolver. */\n    private var appContext: Context? = null\n\n    fun init(context: Context) {\n        if (initialized) return\n        initialized = true\n        appContext = context.applicationContext\n\n        persistFile = File(context.filesDir, FILE_NAME)\n        imagesDir = File(context.filesDir, IMAGE_DIR_NAME).apply { mkdirs() }\n        load()\n    }\n\n    // ---- Публичные методы ----\n\n    /**\n     * Добавить запись скриншота (текст + регионы ~1-5 KB, плюс необязательный\n     * JPEG-кадр [imageJpeg], который пишется файлом и показывается в галерее).\n     * Если буфер полон — самая старая запись (и её файл) удаляется.\n     *\n     * @return Созданная запись.\n     */\n    /**\n     * Добавить запись в буфер.\n     *\n     * synchronized не лишний: писателей стало два — авточтение пишет кадр за\n     * кадром, а кнопка «Скриншот сейчас» добавляет запись из отдельной\n     * корутины. Без блокировки оба собирали список от одного и того же\n     * состояния, и одна запись молча пропадала.\n     *\n     * [sourceWidth]/[sourceHeight]/[scanCrop] — геометрия того, какая часть\n     * файла страницы попала в кадр: без неё нормализованные координаты\n     * [regions] относятся к уменьшенному и обрезанному OCR-битмапу, и в книге\n     * по ним нельзя нарисовать ничего. Оставленные значения по умолчанию означают\n     * «геометрии нет»: запись читается как раньше, проекция для неё\n     * не выполняется.\n     */\n    @Synchronized\n    fun add(\n        chapterId: Long,\n        pageIndex: Int,\n        scrollFraction: Float,\n        regions: List<OcrRegion>,\n        engineUsed: String,\n        imageWidth: Int = 0,\n        imageHeight: Int = 0,\n        imageJpeg: ByteArray? = null,\n        scanRegion: String = \"viewport\",\n        sourceWidth: Int = 0,\n        sourceHeight: Int = 0,\n        scanCrop: SerializableNormalizedRect = SerializableNormalizedRect(),\n    ): OcrScreenshotEntry {\n        val id = System.currentTimeMillis()\n        val serializableRegions = regions.map { SerializableOcrRegion.fromOcrRegion(it) }\n        val summaryText = regions.joinToString(\" \") { it.text.trim() }.trim()\n        val imagePath = imageJpeg?.let { jpeg ->\n            imagesDir?.let { dir ->\n                File(dir, \"$id.jpg\").apply { writeBytes(jpeg) }.absolutePath\n            }\n        }\n        val entry = OcrScreenshotEntry(\n            id = id,\n            chapterId = chapterId,\n            pageIndex = pageIndex,\n            scrollFraction = scrollFraction,\n            timestamp = id,\n            regions = serializableRegions,\n            engineUsed = engineUsed,\n            summaryText = summaryText,\n            imageWidth = imageWidth,\n            imageHeight = imageHeight,\n            imagePath = imagePath,", "lineStart": 80, "lineEnd": 159, "totalLines": 496, "truncated": true}}, "title": "data/src/main/java/mihon/data/ocr/OcrScreenshotBuffer.kt", "