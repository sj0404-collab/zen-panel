     [38;5;216m- [1m[38;5;215mУбрал заливку.[0m[38;5;255m[48;5;232m Теперь помечаются сами блоки текста: тонкая [38;5;15m     
       [38;5;255mрамка вокруг каждого блока + номер [38;5;114m1..N[38;5;255m. Активный ([38;5;15m             
       [38;5;255mозвучиваемый в данный момент) блок — янтарная рамка и [38;5;15m          
       [38;5;255mянтарный номер.[38;5;15m                                                 
     [38;5;216m- [1m[38;5;215mПорядок чтения 1..N[0m[38;5;255m[48;5;232m — тап по плитке [1m[38;5;215m«Чтение»[0m[38;5;255m[48;5;232m циклично меняет [38;5;15m   
       [38;5;255mнаправление: [38;5;114mАвто → → слева направо → ← справа налево → ↓ [38;5;15m      
       [38;5;114mвертикально (колонки справа налево, манга) → ↑ снизу вверх[38;5;255m. [38;5;15m    
       [38;5;255mПлитка «Порядок 1..N» показывает, сколько блоков найдено.[38;5;15m       
     [38;5;216m- [38;5;255mКоординаты блоков даёт [1m[38;5;215mML Kit на устройстве[0m[38;5;255m[48;5;232m (без интернета), [38;5;15m   
       [38;5;255mа текст для озвучки/перевода — по-прежнему онлайн (Lens/Zen), [38;5;15m  
       [38;5;255mкак вы выбрали в «Гибрид».[38;5;15m                                      
     [38;5;216m- [38;5;255mПрогресс: во время речи подсветка переходит по блокам 1→N, [38;5;15m     
       [38;5;255mгаснет по окончании фразы.[38;5;15m                                      
                                                                       
