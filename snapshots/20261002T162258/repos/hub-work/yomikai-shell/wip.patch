-/*
- * Веб-интерфейс оболочки.
- *
- * Всё, что может сделать браузер, делает браузер. Нативный мост используется
- * ровно для трёх вещей, которые из страницы невозможны: выбор папки на
- * устройстве, чтение/запись настроек приложения и запросы к моделям (у них
- * нет CORS-заголовков, поэтому из JS их не сделать).
- *
- * Данные с устройства идут не мостом, а с локального сервера оболочки: там
- * потоковый отдача страниц архива, без base64 и без кэша.
- */
-'use strict';
-
-const qs = new URLSearchParams(location.search);
-const TOKEN = qs.get('k') || '';
-const TAB = qs.get('tab') || 'library';
-const BASE = location.origin;
-
-const view = document.getElementById('view');
-const titleEl = document.getElementById('title');
-const statusEl = document.getElementById('status');
-
-const TITLES = {
-  library: 'Библиотека',
-  reader: 'Читалка',
-  chat: 'AI-чат',
-  settings: 'Настройки',
-};
-
-const state = {
-  uri: null,        // текущая папка
-  archive: null,    // открытый архив
-  source: null,     // что читаем: {kind: title|archive|file, name}
-  pages: [],
-  page: 0,
-};
-
-function setStatus(text) { statusEl.textContent = text || ''; }
-function setTitle(text) { titleEl.textContent = text; }
-
-/** JSON с локального сервера оболочки. */
-async function api(path, params) {
-  const url = new URL(BASE + path);
-  url.searchParams.set('k', TOKEN);
-  Object.entries(params || {}).forEach(([k, v]) => {
-    if (v !== undefined && v !== null) url.searchParams.set(k, v);
-  });
-  const res = await fetch(url.toString());
-  const text = await res.text();
-  if (!res.ok) throw new Error(text || ('HTTP ' + res.status));
-  return text ? JSON.parse(text) : null;
-}
-
-function el(tag, props, children) {
-  const node = document.createElement(tag);
-  Object.entries(props || {}).forEach(([k, v]) => {
-    if (k === 'class') node.className = v;
-    else if (k === 'text') node.textContent = v;
-    else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
-    else if (v !== undefined) node.setAttribute(k, v);
-  });
-  (Array.isArray(children) ? children : [children]).forEach((c) => {
-    if (c === null || c === undefined) return;
-    node.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
-  });
-  return node;
-}
-
-function showError(message) {
-  view.replaceChildren(el('div', { class: 'error', text: String(message || 'Что-то пошло не так') }));
-}
-
-function humanSize(bytes) {
-  if (!bytes) return '';
-  const units = ['Б', 'КБ', 'МБ', 'ГБ'];
-  let value = bytes;
-  let i = 0;
-  while (value >= 1024 && i < units.length - 1) { value /= 1024; i++; }
-  return (i === 0 ? value : value.toFixed(1)) + ' ' + units[i];
-}
-
-/* --- библиотека ---------------------------------------------------------- */
-
-const IMAGES = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'avif', 'jxl'];
-const ARCHIVES = ['zip', 'cbz'];
-
-async function renderLibrary() {
-  setTitle(TITLES.library);
-  view.replaceChildren(el('div', { class: 'hint', text: 'Читаем с устройства' }));
-
-  const roots = await api('/api/roots');
-  if (!roots.length) {
-    view.replaceChildren(
-      el('div', { class: 'hint', text: 'Корень не выбран. Папка с CBZ/картинками лежит на устройстве — укажите её, права сохранятся.' }),
-      el('button', { class: 'primary', text: 'Выбрать папку', onclick: () => Yomi.pickLibraryFolder() }),
-    );
-    setStatus('');
-    return;
-  }
-
-  const chips = el('div', { class: 'row' }, roots.map((r) => el('button', {
-    text: r.name || 'Корень',
-    onclick: () => { state.uri = r.uri; renderList(); },
-  })));
-  const actions = el('div', { class: 'row', style: 'margin:10px 0' }, [
-    el('button', { text: 'Обновить', onclick: () => renderList() }),
-    el('button', { text: 'Другая папка', onclick: () => Yomi.pickLibraryFolder() }),
-  ]);
-  view.replaceChildren(chips, actions);
-  if (!state.uri) state.uri = roots[0].uri;
-  await renderList();
-}
-
-async function renderList() {
-  let nodes = [];
-  try {
-    nodes = await api('/api/list', { uri: state.uri });
-  } catch (e) {
-    showError(e.message);
-    return;
-  }
-  const items = nodes
-    .slice()
-    .sort((a, b) => (b.dir - a.dir) || a.name.localeCompare(b.name, 'ru'));
-
-  if (!items.length) {
-    view.appendChild(el('div', { class: 'hint', text: 'Папка пуста. Сюда кладут папки с картинками или CBZ/CBR.' }));
-    setStatus('');
-    return;
-  }
-  const list = el('ul', {}, items.map((node) => el('li', {
-    class: 'item' + (node.dir ? ' dir' : ''),
-    onclick: () => (node.dir ? enterDir(node) : openItem(node)),
-  }, [
-    el('span', { class: 'name', text: node.name }),
-    // Тап по строке открывает папку, а эта кнопка — читает её целиком: все
-    // главы подряд, без захода в каждый архив отдельно.
-    node.dir
-      ? el('button', {
-        class: 'read',
-        text: 'Читать',
-        onclick: (e) => { e.stopPropagation(); openTitle(node); },
-      })
-      : null,
-    el('span', { class: 'meta', text: node.dir ? 'папка' : humanSize(node.size) }),
-  ])));
-  view.appendChild(list);
-  setStatus(items.length + ' шт.');
-}
-
-function enterDir(node) {
-  state.uri = node.uri;
-  renderList();
-}
-
-/**
- * Читать тайтл целиком: папка раскладывается на главы (архивы) и отдельные
- * картинки, страницы сходятся в один список и идут подряд. Это то, чего не
- * хватало при чтении по архиву: зашёл в папку тайтла — получил все главы.
- */
-async function openTitle(node) {
-  state.archive = null;
-  state.pages = [];
-  state.page = 0;
-  state.source = { kind: 'title', name: node.name };
-  setTitle(TITLES.reader);
-  setStatus('Собираю главы…');
-  view.replaceChildren(el('div', { class: 'hint', text: 'Читаю папку с главами: ' + node.name }));
-  try {
-    const pages = await api('/api/title', { uri: node.uri });
-    if (!pages.length) {
-      showError('В папке нет ни архива, ни картинки — читать нечего.');
-      return;
-    }
-    state.pages = pages.map(toPage);
-    state.page = 0;
-    await renderReader();
-  } catch (e) {
-    showError('Главы не собраны: ' + e.message);
-  }
-}
-
-function toPage(p) {
-  return {
-    name: p.name,
-    url: p.kind === 'zip' ? entryUrl(p.uri, p.entry) : fileUrl(p.uri),
-  };
-}
-
-async function openItem(node) {
-  if (ARCHIVES.includes(node.ext)) {
-    state.archive = node;
-    state.source = { kind: 'archive', name: node.name };
-    state.pages = [];
-    state.page = 0;
-    await renderReader();
-    return;
-  }
-  if (IMAGES.includes(node.ext)) {
-    // Одиночная картинка: показываем как одностраничную «главу».
-    state.archive = null;
-    state.source = { kind: 'file', name: node.name };
-    state.pages = [{ name: node.name, url: fileUrl(node.uri) }];
-    state.page = 0;
-    await renderReader();
-    return;
-  }
-  if (['pdf', 'epub', 'fb2', 'txt', 'md', 'docx'].includes(node.ext)) {
-    state.archive = null;
-    state.source = { kind: 'file', name: node.name };
-    state.pages = [{ name: node.name, url: fileUrl(node.uri), book: true }];
-    state.page = 0;
-    await renderReader();
-  }
-}
-
-const fileUrl = (uri) => `${BASE}/api/file?k=${encodeURIComponent(TOKEN)}&uri=${encodeURIComponent(uri)}`;
-const entryUrl = (uri, name) =>
-  `${BASE}/api/zip/entry?k=${encodeURIComponent(TOKEN)}&uri=${encodeURIComponent(uri)}&e=${encodeURIComponent(name)}`;
-
-/* --- читалка ------------------------------------------------------------- */
-
-async function renderReader() {
-  setTitle(TITLES.reader);
-  if (!state.source && !state.pages.length) {
-    view.replaceChildren(el('div', { class: 'hint', text: 'Откройте архив, картинку или нажмите «Читать» на папке с тайтлом.' }));
-    return;
-  }
-  if (state.archive && !state.pages.length) {
-    setStatus('Читаю каталог архива…');
-    try {
-      const entries = await api('/api/zip/list', { uri: state.archive.uri });
-      state.pages = entries.map((e) => ({ name: e.name, url: entryUrl(state.archive.uri, e.name) }));
-    } catch (e) {
-      showError('Каталог архива не прочитан: ' + e.message);
-      return;
-    }
-  }
-  if (!state.pages.length) {
-    showError('В архиве нет картинок');
-    return;
-  }
-  state.page = Math.min(state.page, state.pages.length - 1);
-  setStatus(state.source ? state.source.name : '');
-  // Полоса страниц у тайтла длинная (это все главы), поэтому подсказка с названием
-  // главы и страницы живёт в статусной строке, а не только цифрами на кнопках.
-  view.replaceChildren(el('div', { id: 'pages' }, state.pages.map((p, i) => el('button', {
-    class: i === state.page ? 'active' : '',
-    text: String(i + 1),
-    title: p.name,
