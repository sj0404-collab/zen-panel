-/**
- * Распознать страницу. Картинка уезжает в модель как base64 — единственное
- * место, где это допустимо: одна страница по кнопке, а не поток картинок.
- */
-async function recognizeCurrentPage(ocrBox) {
-  const current = state.pages[state.page];
-  if (!current) return;
-  ocrBox.textContent = 'Распознаю…';
-  try {
-    const blob = await (await fetch(current.url)).blob();
-    const base64 = await new Promise((resolve, reject) => {
-      const reader = new FileReader();
-      reader.onload = () => resolve(String(reader.result).split(',')[1]);
-      reader.onerror = reject;
-      reader.readAsDataURL(blob);
-    });
-    const answer = JSON.parse(Yomi.recognizeImage(base64, 'Распознай весь текст на этой странице comics. Ответь только текстом.'));
-    if (answer.error) ocrBox.textContent = 'Ошибка: ' + answer.error;
-    else ocrBox.textContent = answer.text || 'Текст не найден.';
-  } catch (e) {
-    ocrBox.textContent = 'Ошибка распознавания: ' + e.message;
-  }
-}
