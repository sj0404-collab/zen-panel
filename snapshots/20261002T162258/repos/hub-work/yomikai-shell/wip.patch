-
-async function send() {
-  const input = document.getElementById('prompt');
-  const text = input.value.trim();
-  if (!text) return;
-  input.value = '';
-  chatlog.push({ role: 'user', text });
-  redrawChat();
-  chatlog.push({ role: 'ai', text: 'Думаю…' });
-  redrawChat();
-  const payload = chatlog
-    .filter((m) => m.role === 'user' || (m.role === 'ai' && m.text !== 'Думаю…'))
-    .map((m) => ({ role: m.role === 'user' ? 'user' : 'assistant', content: m.text }));
-  const answer = JSON.parse(Yomi.chat(JSON.stringify(payload), ''));
-  chatlog.pop();
-  chatlog.push({ role: answer.error ? 'error' : 'ai', text: answer.error || answer.text });
-  redrawChat();
-}
