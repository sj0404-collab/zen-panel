-function showPage() {
-  const current = state.pages[state.page];
-  const box = document.getElementById('page');
-  const ocr = document.getElementById('ocr');
-  if (!box || !current) return;
-  box.replaceChildren(el('img', { src: current.url, alt: current.name }));
-  document.querySelectorAll('#pages button').forEach((b, i) => b.classList.toggle('active', i === state.page));
-  if (ocr) ocr.textContent = '';
-  setStatus((state.page + 1) + ' / ' + state.pages.length + ' · ' + current.name);
-}
