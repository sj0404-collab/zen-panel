-    el('textarea', { id: 'prompt', placeholder: 'Спроси что-нибудь' }),
-    el('div', { class: 'row', style: 'margin-top:8px' }, [
-      el('button', {
-        class: 'primary',
-        text: 'Спросить',
-        onclick: () => send(),
-      }),
-    ]),
-  );
-  redrawChat();
-}
-
-function redrawChat() {
-  const log = document.getElementById('chatlog');
-  if (!log) return;
-  log.replaceChildren(...chatlog.map((m) => el('div', { class: 'msg ' + m.role, text: m.text })));
-  log.lastElementChild?.scrollIntoView({ block: 'end' });
