+    /**
+     * Сбросить кэш, если изменились настройки, от которых зависит результат.
+     *
+     * Схема кэша одна и та же для всех движков и пресетов, поэтому старые
+     * страницы формально валидны — и `getPage` отдаёт их вечно. Пользователь
+     * меняет тип контента, режим локального распознавания, движок или ручные
+     * пороги, а читатель продолжает показывать и озвучивать результат, собранный
+     * по старым параметрам. [signature] — отпечаток этих настроек; изменился —
+     * база удаляется целиком (дёшево: страницы всегда пересканируются).
+     */
+    fun invalidateIfSettingsChanged(signature: String) {
+        val meta = context.getSharedPreferences("ocr_cache_meta", Context.MODE_PRIVATE)
