sKt.bin\",\n                \"kotlin/**\"\n            )\n        }\n    }\n\n    compileOptions {\n        sourceCompatibility = JavaVersion.VERSION_17\n        targetCompatibility = JavaVersion.VERSION_17\n    }\n\n    kotlinOptions {\n        jvmTarget = \"17\"\n    }\n\n    buildFeatures {\n        compose = true\n    }\n\n    testOptions {\n        unitTests.isReturnDefaultValues = true\n    }\n}\n\ndependencies {\n    implementation(libs.androidx.core.ktx)\n    implementation(libs.androidx.lifecycle.runtime.ktx)\n    implementation(libs.androidx.activity.compose)\n    implementation(platform(libs.androidx.compose.bom))\n    implementation(libs.androidx.compose.ui)\n    implementation(libs.androidx.compose.ui.graphics)\n    implementation(libs.androidx.compose.material3)\n    implementation(libs.androidx.webkit)\n    // v4.4.3: запасной канал Psiphon\n    implementation(\"ca.psiphon:psiphontunnel:2.0.42\")\n    testImplementation(libs.junit)\n    testImplementation(\"org.json:json:20240303\")\n}\n===WORKFLOW===\n.github/workflows/build.yml\n---\nname: Build OmniBrowser & VPN Tunnel Pro APK\n\non:\n  push:\n    branches: [ \"main\", \"master\", \"v4.*\" ]\n    tags: [ \"v*\" ]\n  workflow_dispatch:\n\npermissions:\n  contents: write\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout Source\n        uses: actions/checkout@v4\n\n      - name: Set up JDK 17\n        uses: actions/setup-java@v4\n        with:\n          java-version: '17'\n          distribution: 'temurin'\n\n      - name: Setup Gradle\n        uses: gradle/actions/setup-gradle@v4\n\n      - name: Run Unit Tests & Assemble Signed Release APK (R8 + Unified Keystore)\n        run: |\n          chmod +x gradlew\n          ./gradlew testDebugUnitTest assembleRelease --stacktrace\n\n      - name: Prepare Signed APK Artifact\n        run: |\n          mkdir -p dist\n          VER=$(grep -h -m1 -oE 'versionName *=? *\"[^\"]+\"' app/build.gradle* | head -1 | sed -E 's/.*\"([^\"]+)\".*/\\1/')\n          if [[ \"$GITHUB_REF\" == refs/tags/* ]]; then BASE=\"OmniBrowser-VPN-Tunnel-Pro-${GITHUB_REF_NAME}-arm64-release\"; else BASE=\"OmniBrowser-VPN-Tunnel-Pro-v${VER}-arm64-release\"; fi\n          cp app/build/outputs/apk/release/app-release.apk \"dist/${BASE}.apk\"\n          echo \"APK_BASE=${BASE}\" >> \"$GITHUB_ENV\"\n          ls -lh dist/\n          unzip -l \"dist/${BASE}.apk\" | sort -k1 -n -r | head -n 15\n\n      - name: Upload Release APK Artifact\n        uses: actions/upload-artifact@v4\n        with:\n          name: ${{ env.APK_BASE }}\n          path: dist/${{ env.APK_BASE }}.apk\n\n      - name: Publish GitHub Release (tags only)\n        if: startsWith(github.ref, 'refs/tags/v')\n        uses: softprops/action-gh-release@v2\n        with:\n          name: OmniBrowser VPN Tunnel Pro ${{ github.ref_name }}\n          body_path: RELEASE_NOTES.md\n          files: dist/${{ env.APK_BASE }}.apk\n          prerelease: ${{ contains(github.ref_name, '-') }}\n          make_latest: ${{ !contains(github.ref_name, '-') }}\n", "exit": 0, "truncated": false}, "title": "cat app/build.gradle.kts; echo \"===WORKFLOW===\"; find .github -type f; echo \"---\"; cat .github/workflows/*.yml 2>/dev/null", "time": {"start": 1793005243831, "end": 1793005243852}}, "id": "prt_17770cd2f001onmvgVCt3tALrp", "sessionID": "ses_e888f58d8ffe0rpb88ucjxAioI", "messageID": "msg_17770c567001RogfRW1x4Ek5Ah"}, {"type": "tool", "tool": "bash", "callID": "call_01_mqa9jw3lqeyzwolkicw8ih8c", "state": {"status": "completed", "input": {"command": "find gradle -type f -not -name '*.jar' -print; echo \"===RELEASE head===\"; head -80 RELEASE_NOTES.md"}, "output": "gradle/wrapper/gradle-wrapper.properties\ngradle/libs.versions.toml\n===RELEASE head===\n**OmniBrowser VPN Tunnel Pro 4.5.0**\n\n**Очередь загрузок с паузой и продолжением (п. 4)**\n- Все загрузки браузера (видео, аудио, склейка, HLS) качаются в части `files/dl/` и докачиваются с того же места после паузы, обрыва, ошибки или перезапуска приложения (HLS — с последнего записанного сегмента).\n- В уведомлении кнопка «Пауза»; у приостановленной загрузки — «Продолжить» / «Удалить». В разделе «История → Загрузки» — блок «Загрузки браузера» с прогрессом, скоростью и кнопками ⏸ Пауза / ▶ Продолжить / ↻ Повторить / ✕ Удалить.\n- Незавершённые загрузки автоматически продолжаются при следующем запуске приложения.\n\n**Плитка быстрых настроек «VPN приложений» (п. 12)**\n- Добавьте плитку в шторку (редактирование плиток → OmniBrowser). Одно нажатие включает/выключает туннель для сохранённого списка приложений, страна — последняя выбранная. Если разрешение на VPN ещё не выдано — откроется раздел «Приложения».\n\n**Сохранение страниц офлайн (п. 13)**\n- Меню ⋮ → «Сохранить страницу офлайн»: MHTML целиком (текст, картинки, стили) в `Android/data/…/files/pages`. Список и открытие — «История → Загрузки → Сохранённые страницы».\n\nТакже: в списке файлов теперь видна папка Download/OmniBrowser (субтитры, обложки).\n\n---\n\n**4.4.8**\n\n- **Закрепление сервера за приложением — не чаще одной смены за 15 с.** В 4.4.7 оставался второй путь прыганья: параллельные соединения приносили разных «победителей» (de83 → lv115 → de83 за секунду). Теперь после смены сервер держится 15 с, даже если ответил другой (в журнале: «держим сервер …»).\n- **Psiphon: сторож.** Если за 6 минут не подключился (в журнале 4.4.7: «TCP-таймаут 32 · QUIC без ответа 14 · meek/CDN 9 · рукопожатие 6» — провайдер фильтрует серверы Psiphon целиком), в режиме АВТО он останавливается на 20 минут, чтобы 20 потоков не грели телефон впустую; пилюля показывает паузу. В режиме «всегда» продолжает пытаться. Убран шум «failed to make dial parameters … missing public key».\n- Android «Приватный DNS: авто» щупал наш DNS по порту 853 (TLS) — запрос уходил на 1.1.1.1:53 и висел 10 с («приложение → 10.215.173.2:853 · длилось 10.1 с»). Теперь закрывается сразу, система мгновенно переходит на обычный DNS.\n\n---\n\n**4.4.7**\n\n- **Приложения больше не прыгают между серверами Browsec** в час пик: по журналу 4.4.6 YouTube переключался lv115 → de83 → lv115 по 4 раза в секунду (каждый сервер по очереди уходил в «паузу» после 503/таймаута), и каждое переключение переоткрывало соединения к видео, привязанным к IP. Теперь, если весь пул в паузе или сервер сменили меньше 15 с назад, приложение держится за текущий сервер.\n- **Psiphon: понятная диагностика вместо потока сырых ошибок.** Отказы классифицируются (TCP-таймаут / QUIC без ответа / DNS / сброс после рукопожатия / meek-CDN), раз в минуту пишется сводка с подсказкой («адреса серверов фильтруются провайдером» и т.п.), та же причина показывается в пилюле статуса. Повторяющиеся фоновые сбои (брокер in-proxy, DSL, удалённый список, tactics) — по одному разу за сеанс с пояснением. Длинные сообщения показывают начало и **конец** (где и есть причина).\n- В 4.4.6 DNS для Psiphon починился (ответы приходят), но до серверов по-прежнему не достучаться: TCP и QUIC к их адресам — таймауты, meek через CDN — тоже. Сводка 4.4.7 покажет точную картину.\n\n---\n\n**4.4.6**\n\n**Psiphon: найдена причина «подключается… попыток 25» (по диагностике 4.4.5)**\n- `NetworkMonitor: set current active network VPN with DNS` — при включённом VPN приложений Android выдаёт библиотеке Psiphon DNS нашего же TUN-интерфейса (10.215.173.2), который из процесса браузера недостижим. Поэтому падало всё, где нужно имя: meek-серверы, tactics, удалённый список (`RemoteServerListResourceDownloadedBytes: 0`), in-proxy. Теперь Psiphon резолвит имена через публичные DNS (1.1.1.1/8.8.8.8/9.9.9.9).\n- Параллельных попыток 20 вместо 10; первые 60 кандидатов — протоколы, которые труднее отличить от обычного трафика (TLS-OSSH, QUIC-OSSH, meek, Shadowsocks), затем все остальные.\n- Журнал Psiphon компактнее: «попытка №N: регион/протокол» раз в 20 с, без служебных метрик.\n\n---\n\n**4.4.5**\n\n**Psiphon не подключался (по журналу 4.4.4: «подключается… 112 с», ↓0 Б)**\n- Библиотека стартовала без единого сервера и ждала удалённый список с s3.amazonaws.com — на сети с подменой DNS это может не работать. Теперь в APK **встроен список из 429 серверов Psiphon** (27 стран, включая LT/PL/DE/NL/SE/FI), первое подключение от S3 не зависит; удалённый список подтягивается дополнительно.\n- Включена диагностика Psiphon в журнал (с ограничением частоты): какой сервер/протокол пробуется, ошибки, получение списка. В статусе кнопки — число попыток и последнее событие.\n\n---\n\n**4.4.4**\n\n- Журнал: у каждого соединения приложения теперь виден объём и средняя скорость приёма («длилось 64 с · ↓2,1 МБ (33 КБ/с)») — по жалобе «первый Shorts быстро, второй циклами»: станет видно, какие именно соединения ползут и через какой сервер.\n- Соединения через Psiphon подписываются «Psiphon», а не адресом локального прокси.\n\n---\n\n**4.4.3**\n\n**Запасной канал Psiphon (п. 5б)**\n- Встроена официальная библиотека Psiphon (ca.psiphon:psiphontunnel 2.0.42, сеть с сотнями серверов и собственной обфускацией). Она поднимает локальный прокси 127.0.0.1:8921, который подмешивается к серверам Browsec как ещё один «сервер» — с теми же замерами, привязкой приложений и журналом.\n- Режимы (кнопка во вкладке «Приложения»): **АВТО** (по умолчанию) — Psiphon запускается вместе с VPN приложений и при перегрузке Browsec; идёт последним кандидатом, а когда отвечает меньше половины серверов Browsec — первым. **ВСЕГДА** — все соединения приложений и автотуннеля браузера через Psiphon. **ВЫКЛ**.\n- Статус в той же кнопке: подключён/подключается, регион и IP выхода, трафик. В журнале — тег `[Psiphon]`.\n- APK теперь только arm64 (библиотека весит 31 МБ на архитектуру; в APK сжата до ~11 МБ).\n\n---\n\n**4.4.2**\n\n**Исправление закрепления сервера (по журналу 4.4.1)**\n- Закрепление «прыгало» (lv115 → lt40 → lv115 … в одну секунду): пять одновременных соединений YouTube выбирали пять разных победителей гонки. Теперь сервер для приложения выбирает **первое** соединение, остальные параллельные ждут его результата (до 8 с) и идут через тот же сервер.\n- Закреплённый сервер не теряет место, просто проиграв гонку: пока он отвечает (до 9 с), чужой успех держится в запасе; смена — только если закреплённый ответил ошибкой/таймаутом, причина пишется в журнал.\n\n---\n\n**4.4.1**\n\n**Заикание YouTube-приложения — по журналу пользователя**\n- Выяснилось: видео YouTube-приложение качает не через прозрачный туннель, а через системный прокси VPN (Cronet уважает прокси). Этот путь не попадал в журнал и каждое соединение независимо выбирало сервер Browsec «кто первый ответит» — соединения одного ролика уходили через разные IP, а адреса googlevideo привязаны к IP → 403/обрыв и «кружок» каждые несколько секунд.\n- **Привязка приложения к серверу**: все соединения приложения (API и видео, оба пути) идут через один сервер Browsec 20 мин; смена только если он не ответил за 4 с (в журнале: «закреплены за сервером …», «сервер сменён …»).\n", "metadata": {"output": "gradle/wrapper/gradle-wrapper.properties\ngradle/libs.versions.toml\n===RELEASE head===\n**OmniBrowser VPN Tunnel Pro 4.5.0**\n\n**Очередь загрузок с паузой и продолжением (п. 4)**\n- Все загрузки браузера (видео, аудио, склейка, HLS) качаются в части `files/dl/` и докачиваются с того же места после паузы, обрыва, ошибки или перезапуска приложения (HLS — с последнего записанного сегмента).\n- В уведомлении кнопка «Пауза»; у приостановленной загрузки — «Продолжить» / «Удалить». В разделе «История → Загрузки» — блок «Загрузки браузера» с прогрессом, скоростью и кнопками ⏸ Пауза / ▶ Продолжить / ↻ Повторить / ✕ Удалить.\n- Незавершённые загрузки автоматически продолжаются при следующем запуске приложения.\n\n**Плитка быстрых настроек «VPN приложений» (п. 12)**\n- Добавьте плитку в шторку (редактирование плиток → OmniBrowser). Одно нажатие включает/выключает туннель для сохранённого списка приложений, страна — последняя выбранная. Если разрешение на VPN ещё не выдано — откроется раздел «Приложения».\n\n**Сохранение страниц офлайн (п. 13)**\n- Меню ⋮ → «Сохранить страницу офлайн»: MHTML целиком (текст, картинки, стили) в `Android/data/…/files/pages`. Список и открытие — «История → Загрузки → Сохранённые страницы».\n\nТакже: в списке файлов теперь видна папка Download/OmniBrowser (субтитры, обложки).\n\n---\n\n**4.4.8**\n\n- **Закрепление сервера за приложением — не чаще одной смены за 15 с.** В 4.4.7 оставался второй путь прыганья: параллельные соединения приносили разных «победителей» (de83 → lv115 → de83 за секунду). Теперь после смены сервер держится 15 с, даже если ответил другой (в журнале: «держим сервер …»).\n- **Psiphon: сторож.** Если за 6 минут не подключился (в журнале 4.4.7: «TCP-таймаут 32 · QUIC без ответа 14 · meek/CDN 9 · рукопожатие 6» — провайдер фильтрует серверы Psiphon целиком), в режиме АВТО он останавливается на 20 минут, чтобы 20 потоков не грели телефон впустую; пилюля показывает паузу. В режиме «всегда» продолжает пытаться. Убран шум «failed to make dial parameters … missing public key».\n- Android «Приватный DNS: авто» щупал наш DNS по порту 853 (TLS) — запрос уходил на 1.1.1.1:53 и висел 10 с («приложение → 10.215.173.2:853 · длилось 10.1 с»). Теперь закрывается сразу, система мгновенно переходит на обычный DNS.\n\n---\n\n**4.4.7**\n\n- **Приложения больше не прыгают между серверами Browsec** в час пик: по журналу 4.4.6 YouTube переключался lv115 → de83 → lv115 по 4 раза в секунду (каждый сервер по очереди уходил в «паузу» после 503/таймаута), и каждое переключение переоткрывало соединения к видео, привязанным к IP. Теперь, если весь пул в паузе или сервер сменили меньше 15 с назад, приложение держится за текущий сервер.\n- **Psiphon: понятная диагностика вместо потока сырых ошибок.** Отказы классифицируются (TCP-таймаут / QUIC без ответа / DNS / сброс после рукопожатия / meek-CDN), раз в минуту пишется сводка с подсказкой («адреса серверов фильтруются провайдером» и т.п.), та же причина показывается в пилюле статуса. Повторяющиеся фоновые сбои (брокер in-proxy, DSL, удалённый список, tactics) — по одному разу за сеанс с пояснением. Длинные сообщения показывают начало и **конец** (где и есть причина).\n- В 4.4.6 DNS для Psiphon починился (ответы приходят), но до серверов по-прежнему не достучаться: TCP и QUIC к их адресам — таймауты, meek через CDN — тоже. Сводка 4.4.7 покажет точную картину.\n\n---\n\n**4.4.6**\n\n**Psiphon: найдена причина «подключается… попыток 25» (по диагностике 4.4.5)**\n- `NetworkMonitor: set current active network VPN with DNS` — при включённом VPN приложений Android выдаёт библиотеке Psiphon DNS нашего же TUN-интерфейса (10.215.173.2), который из процесса браузера недостижим. Поэтому падало всё, где нужно имя: meek-серверы, tactics, удалённый список (`RemoteServerListResourceDownloadedBytes: 0`), in-proxy. Теперь Psiphon резолвит имена через публичные DNS (1.1.1.1/8.8.8.8/9.9.9.9).\n- Параллельных попыток 20 вместо 10; первые 60 кандидатов — протоколы, которые труднее отличить от обычного трафика (TLS-OSSH, QUIC-OSSH, meek, Shadowsocks), затем все остальные.\n- Журнал Psiphon компактнее: «попытка №N: регион/протокол» раз в 20 с, без служебных метрик.\n\n---\n\n**4.4.5**\n\n**Psiphon не подключался (по журналу 4.4.4: «подключается… 112 с», ↓0 Б)**\n- Библиотека стартовала без единого сервера и ждала удалённый список с s3.amazonaws.com — на сети с подменой DNS это может не работать. Теперь в APK **встроен список из 429 серверов Psiphon** (27 стран, включая LT/PL/DE/NL/SE/FI), первое подключение от S3 не зависит; удалённый список подтягивается дополнительно.\n- Включена диагностика Psiphon в журнал (с ограничением частоты): какой сервер/протокол пробуется, ошибки, получение списка. В статусе кнопки — число попыток и последнее событие.\n\n---\n\n**4.4.4**\n\n- Журнал: у каждого соединения приложения теперь виден объём и средняя скорость приёма («длилось 64 с · ↓2,1 МБ (33 КБ/с)») — по жалобе «первый Shorts быстро, второй циклами»: станет видно, какие именно соединения ползут и через какой сервер.\n- Соединения через Psiphon подписываются «Psiphon», а не адресом локального прокси.\n\n---\n\n**4.4.3**\n\n**Запасной канал Psiphon (п. 5б)**\n- Встроена официальная библиотека Psiphon (ca.psiphon:psiphontunnel 2.0.42, сеть с сотнями серверов и собственной обфускацией). Она поднимает локальный прокси 127.0.0.1:8921, который подмешивается к серверам Browsec как ещё один «сервер» — с теми же замерами, привязкой приложений и журналом.\n- Режимы (кнопка во вкладке «Приложения»): **АВТО** (по умолчанию) — Psiphon запускается вместе с VPN приложений и при перегрузке Browsec; идёт последним кандидатом, а когда отвечает меньше половины серверов Browsec — первым. **ВСЕГДА** — все соединения приложений и автотуннеля браузера через Psiphon. **ВЫКЛ**.\n- Статус в той же кнопке: подключён/подключается, регион и IP выхода, трафик. В журнале — тег `[Psiphon]`.\n- APK теперь только arm64 (библиотека весит 31 МБ на архитектуру; в APK сжата до ~11 МБ).\n\n---\n\n**4.4.2**\n\n**Исправление закрепления сервера (по журналу 4.4.1)**\n- Закрепление «прыгало» (lv115 → lt40 → lv115 … в одну секунду): пять одновременных соединений YouTube выбирали пять разных победителей гонки. Теперь сервер для приложения выбирает **первое** соединение, остальные параллельные ждут его результата (до 8 с) и идут через тот же сервер.\n- Закреплённый сервер не теряет место, просто проиграв гонку: пока он отвечает (до 9 с), чужой успех держится в запасе; смена — только если закреплённый ответил ошибкой/таймаутом, причина пишется в журнал.\n\n---\n\n**4.4.1**\n\n**Заикание YouTube-приложения — по журналу пользователя**\n- Выяснилось: видео YouTube-приложение качает не через прозрачный туннель, а через системный прокси VPN (Cronet уважает прокси). Этот путь не попадал в журнал и каждое соединение независимо выбирало сервер Browsec «кто первый ответит» — соединения одного ролика уходили через разные IP, а адреса googlevideo привязаны к IP → 403/обрыв и «кружок» каждые несколько секунд.\n- **Привязка приложения к серверу**: все соединения приложения (API и видео, оба пути) идут через один сервер Browsec 20 мин; смена только если он не ответил за 4 с (в журнале: «закреплены за сервером …», «сервер сменён …»).\n", "exit": 0, "truncated": false}, "title": "find gradle -type f -not -name '*.jar' -print; echo \"===RELEASE head===\"; head -80 RELEASE_NOTES.md", "time": {"start": 1793005244079, "end": 1793005244093}}, "id": "prt_17770cdbc001zVAytlZxxNAD6B", "sessionID": "ses_e888f58d8ffe0rpb88ucjxAioI", "messageID": "msg_17770c567001RogfRW1x4Ek5Ah"}, {"reason": "tool-calls", "snapshot": "361d365a5ce4a0b98bcf0adb2cc3588b197a24f5", "type": "step-finish", "tokens": {"total": 34803, "input": 22851, "output": 137, "reasoning": 39, "cache": {"write": 0, "read": 11776}}, "cost": 0, "id": "prt_17770cecd001SRAFd1FJkPYlOt", "sessionID": "ses_e888f58d8ffe0rpb88ucjxAioI", "messageID": "msg_17770c567001RogfRW1x4Ek5Ah"}]}, {"info": {"parentID": "msg_17770a736001joZwML6fusp25m", "role": "assistant", "mode": "build", "agent": "build", "path": {"cwd": "/home/runner/hub-work/OmniBrowser-VPN-Tunnel-Pro/code", "root": "/home/runner/hub-work/OmniBrowser-VPN-Tunnel-Pro/code"}, "cost": 0, "tokens": {"input": 0, "output": 0, "reasoning": 0, "cache": {"read": 0, "write": 0}}, "modelID": "big-pickle", "providerID": "opencode", "time": {"created": 1793005244153}, "id": "msg_17770cef90012jSfFa5SqlhxDy", "sessionID": "ses_e888f58d8ffe0rpb88ucjxAioI"}, "parts": [{"snapshot": "361d365a5ce4a0b98bcf0adb2cc3588b197a24f5", "type": "step-start", "id": "prt_17770d7cb001mIyzrQGT3MyjSr", "sessionID": "ses_e888f58d8ffe0rpb88ucjxAioI", "messageID": "msg_17770cef90012jSfFa5SqlhxDy"}, {"type": "reasoning", "text": "", "time": {"start": 1793005246443}, "id": "prt_17770d7eb001JV4ZkKWxZ8fyzS", "sessionID": "ses_e888f58d8ffe0rpb88ucjxAioI", "messageID": "msg_17770cef90012jSfFa5SqlhxDy"}]}]}}]}