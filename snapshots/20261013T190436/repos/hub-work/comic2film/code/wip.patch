+    /** Усиление/ослабление без клиппинга: системный TTS не умеет volume per-utterance. */
+    fun applyGain(samples: FloatArray, gain: Double): FloatArray {
+        if (gain == 1.0) return samples
+        val out = FloatArray(samples.size)
+        for (i in samples.indices) out[i] = (samples[i] * gain).coerceIn(-1f, 1f)
+        return out
+    }
+
     fun floatToPcm16(src: FloatArray, from: Int = 0, count: Int = src.size - from): ShortArray {
