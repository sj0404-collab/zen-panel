+/**
+ * Откуда взят интерфейс. Файлы в `workspace/web` внутри любого корня
+ * библиотеки перекрывают сборку: `app.js`, `app.css`, `index.html` и что
+ * угодно ещё отдаётся с устройства, поэтому правка интерфейса не требует
+ * пересборки APK.
+ */
+function webUiField() {
+  const info = JSON.parse(Yomi.webUi() || '{}');
+  const files = info.overridden || [];
+  const dirs = info.dirs || [];
+  return el('div', { class: 'field' }, [
+    el('span', { text: 'Веб-интерфейс' }),
+    el('div', {
+      class: 'hint',
+      text: files.length
+        ? 'Правлен с устройства (' + files.join(', ') + ') из ' + dirs.join(', ')
+        : 'Из APK. Положите файлы в workspace/web в корне библиотеки — они перекроют сборку.',
+    }),
+    el('div', { class: 'row' }, [
+      el('button', {
+        text: 'Перезагрузить интерфейс',
+        onclick: () => { Yomi.reloadUi(); setStatus('Перечитываю интерфейс…'); },
+      }),
+    ]),
+  ]);
+}
+
