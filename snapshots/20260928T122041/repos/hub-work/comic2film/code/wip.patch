+                                            put("media_type", AiClient.mimeOf(url))
+                                            put("data", url.substringAfter("base64,", ""))
+                                        }
+                                    })
+                                }
+                            }
+                        })
+
+                        else -> add(buildJsonObject { put("role", m.role); put("content", m.content) })
+                    }
+                }
+            }
+        }
