-                    alreadyExists = state.stores.any { it.indexUrl == storeIndexUrl },
-                ),
-            )
-        }
-    }
-
-    fun showDialog(dialog: ExtensionStoreDialog) {
-        updateSuccessState { state ->
-            state.copy(dialog = dialog)
-        }
-    }
-
-    fun dismissDialog() {
-        updateSuccessState {
-            it.copy(dialog = null)
-        }
-    }
-}
