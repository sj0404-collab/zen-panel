+    p['hand.L'] = (0, 0, 0)
+    p['upperarm.L'] = (-0.20 - t * 0.06, 0, 0.05)
+    p['coat.L'] = (math.sin(ph) * 0.03, 0, 0)
+    p['coat.R'] = (-t * 0.12 + math.sin(ph) * 0.03, 0, 0)
+    p['hair.back'] = (0, math.sin(ph) * 0.04, 0)
+    return p
+
