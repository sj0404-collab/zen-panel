+def pose_turn(u):
+    """Оглядывание: поворот влево-вправо через плечо. Цикл."""
+    p = _body_base()
+    ph = TAU * u
+    k = math.sin(ph)
+    p['root'] = (0, k * 0.480, 0, (0, 0, 0))
