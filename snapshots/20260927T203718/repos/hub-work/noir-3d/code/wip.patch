+    p['upperarm.L'] = (-0.20, 0, 0.10)
+    p['upperarm.R'] = (-0.20, 0, -0.10)
+    p['forearm.L'] = (-0.55, 0, 0)
+    p['forearm.R'] = (-0.55, 0, 0)
+    p['thigh.L'] = (-0.10, 0, 0.04)
+    p['thigh.R'] = (-0.10, 0, -0.04)
+    p['shin.L'] = (0.22, 0, 0)
+    p['shin.R'] = (0.22, 0, 0)
+    p['coat.L'] = (k * 0.10, 0, 0)
+    p['coat.R'] = (k * 0.10, 0, 0)
+    p['hair.back'] = (k * 0.070, k * 0.080, 0)
+    return p
